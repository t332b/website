---
import Base from "./Base.astro";
import { getCollection } from 'astro:content';

export interface Props {
  title: string;
  date: Date;
  author: string;
  tags?: string[];
}

const { title, date, author, tags } = Astro.props;

// メンバー情報を取得
const members = await getCollection('member');
const member = members.find(m => m.data.id === author);

function getAvatarUrl(m: { avatar?: string; github?: string } | null): string {
  if (!m) return '/images/uploads/default-avatar.png';
  if (m.avatar) {
    if (m.avatar.startsWith('http://') || m.avatar.startsWith('https://')) return m.avatar;
    return m.avatar.startsWith('/') ? m.avatar : `/${m.avatar}`;
  }
  if (m.github) return `https://github.com/${m.github}.png?size=64`;
  return '/images/uploads/default-avatar.png';
}

const avatarUrl = getAvatarUrl(member?.data ?? null);
const dateStr = date.toLocaleDateString('sv-SE', { timeZone: 'Asia/Tokyo' });
const timeStr = date.toLocaleTimeString('ja-JP', { timeZone: 'Asia/Tokyo', hour: '2-digit', minute: '2-digit', hour12: false });
const dateTimeDisplay = `${dateStr} ${timeStr}`;
---

<Base title={title}>
  <article class="note-post">
    <!-- ヘッダー（note.com 風: タイトル → アイコン・名前・日時） -->
    <header class="post-header">
      <h1 class="post-title">{title}</h1>
      
      <div class="post-meta">
        <a href={`/notes/?author=${encodeURIComponent(author)}`} class="post-author-link" aria-label={`${member?.data.name || author}のノート一覧`}>
          <img src={avatarUrl} alt="" class="post-author-avatar" width="48" height="48" />
        </a>
        <div class="post-meta-right">
          <a href={`/notes/?author=${encodeURIComponent(author)}`} class="post-author">{member?.data.name || author}</a>
          <time class="post-date" datetime={date.toISOString()}>{dateTimeDisplay}</time>
        </div>
      </div>
      
      {tags && tags.length > 0 && (
        <div class="post-tags">
          {tags.map(tag => (
            <span class="tag">#{tag}</span>
          ))}
        </div>
      )}
    </header>

    <!-- 本文 -->
    <div class="post-content content">
      <slot />
    </div>

    <!-- 戻るリンク -->
    <div class="post-footer">
      <a href="/notes/" class="back-link">← ノート一覧に戻る</a>
    </div>
  </article>
</Base>

<style>
  /* note.com 風: 記事幅 620px 前後・読みやすい文字サイズ */
  .note-post {
    max-width: 620px;
    margin: 0 auto;
    padding: 2.5rem 1.25rem;
  }

  .post-header {
    margin-bottom: 2rem;
  }

  .post-title {
    font-size: 1.875rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    color: var(--fg);
    line-height: 1.35;
    letter-spacing: 0.02em;
  }

  .post-meta {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 1rem;
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .post-author-link {
    flex-shrink: 0;
    line-height: 0;
    border-radius: 50%;
    overflow: hidden;
    transition: opacity 0.2s ease;
  }

  .post-author-link:hover {
    opacity: 0.85;
  }

  .post-author-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
    display: block;
  }

  .post-meta-right {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .post-author {
    color: var(--accent);
    font-weight: 600;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .post-author:hover {
    color: var(--wa-forest);
  }

  .post-date {
    color: var(--muted);
    font-size: 0.875rem;
  }

  .post-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tag {
    background: var(--wa-cream);
    color: var(--accent);
    padding: 0.25rem 0.75rem;
    border-radius: 12px;
    font-size: 0.875rem;
    border: 1px solid var(--wa-butter);
  }

  .post-content {
    line-height: 1.85;
    font-size: 17px;
    color: var(--fg);
  }

  .post-content :global(p) {
    margin: 0 0 1em;
  }

  .post-content :global(h1),
  .post-content :global(h2),
  .post-content :global(h3) {
    margin: 1.75em 0 0.5em;
    font-weight: 700;
    line-height: 1.35;
  }

  .post-content :global(h1) { font-size: 1.5rem; }
  .post-content :global(h2) { font-size: 1.25rem; }
  .post-content :global(h3) { font-size: 1.125rem; }

  /* 本文中の画像: 記事幅いっぱいで中央、縁なし */
  .post-content :global(img) {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 1.5rem auto;
    border-radius: 12px;
    border: none;
  }

  .post-footer {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 2px solid var(--wa-butter);
  }

  .back-link {
    color: var(--accent);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9375rem;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: var(--wa-forest);
  }

  @media (max-width: 768px) {
    .note-post {
      padding: 1.5rem 1rem;
    }

    .post-title {
      font-size: 1.5rem;
    }

    .post-content {
      font-size: 16px;
    }
  }
</style>
