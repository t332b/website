---
import Base from "./Base.astro";
import { getCollection } from "astro:content";

export interface Props {
  title: string;
  date: Date;
  author: string;
  tags?: string[];
  image?: string;
  description?: string;
  /** ビルド時に取得した song.link の linksByPlatform（key: 音楽URL）。渡されていればクライアントの API 呼び出し不要 */
  musicLinks?: Record<string, { linksByPlatform?: Record<string, { url?: string }> }>;
  slug?: string;
  prevPost?: {
    slug: string;
    title: string;
    date: Date;
    author: string;
    image?: string;
    description: string;
  };
  nextPost?: {
    slug: string;
    title: string;
    date: Date;
    author: string;
    image?: string;
    description: string;
  };
}

const { title, date, author, tags, image, description, musicLinks = {}, slug = '', prevPost, nextPost } =
  Astro.props as Props;

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '';

// メンバー情報を取得
const members = await getCollection("member");
const member = members.find((m) => m.data.id === author);

function getAvatarUrl(m: { avatar?: string; github?: string } | null): string {
  if (!m) return "/images/uploads/default-avatar.png";
  if (m.avatar) {
    if (m.avatar.startsWith("http://") || m.avatar.startsWith("https://")) return m.avatar;
    return m.avatar.startsWith("/") ? m.avatar : `/${m.avatar}`;
  }
  if (m.github) return `https://github.com/${m.github}.png?size=64`;
  return "/images/uploads/default-avatar.png";
}

const avatarUrl = getAvatarUrl(member?.data ?? null);

function getHeroImageUrl(img: string | undefined): string | undefined {
  if (!img) return undefined;
  if (img.startsWith("http://") || img.startsWith("https://")) return img;
  return `https://res.cloudinary.com/djzxpyzu3/image/upload/f_auto,q_auto,w_1600,c_limit/${img}`;
}
const heroImageUrl = getHeroImageUrl(image);

function memberById(id: string) {
  return members.find((m) => m.data.id === id)?.data ?? null;
}
function navCardData(p: Props["prevPost"] | Props["nextPost"]) {
  if (!p) return null;
  const m = memberById(p.author);
  return {
    href: `/notes/${p.slug}/`,
    title: p.title,
    description: p.description,
    authorName: m?.name ?? p.author,
    authorAvatarUrl: getAvatarUrl(m),
  };
}
const prev = navCardData(prevPost);
const next = navCardData(nextPost);

const dateStr = date.toLocaleDateString("sv-SE", { timeZone: "Asia/Tokyo" });
const timeStr = date.toLocaleTimeString("ja-JP", {
  timeZone: "Asia/Tokyo",
  hour: "2-digit",
  minute: "2-digit",
  hour12: false,
});
const dateTimeDisplay = `${dateStr} ${timeStr}`;


---

<Base title={title} description={description} ogImage={heroImageUrl} twitterCard="summary">
  <article class="note-post">

    {heroImageUrl && (
      <div class="post-hero">
        <img src={heroImageUrl} alt="" class="post-hero-img" />
      </div>
    )}

    <header class="post-header">
      <h1 class="post-title">{title}</h1>

      <div class="post-meta">
        <a
          href={`/notes/?author=${encodeURIComponent(author)}`}
          class="post-author-link"
          aria-label={`${member?.data.name || author}のノート一覧`}
        >
          <img src={avatarUrl} alt="" class="post-author-avatar" width="48" height="48" />
        </a>
        <div class="post-meta-right">
          <a href={`/notes/?author=${encodeURIComponent(author)}`} class="post-author">{member?.data.name || author}</a>
          <time class="post-date" datetime={date.toISOString()}>{dateTimeDisplay}</time>
        </div>
      </div>

      {
        tags && tags.length > 0 && (
          <div class="post-tags">
            {tags.map((tag) => (
              <a href={`/notes/?tag=${encodeURIComponent(tag)}`} class="tag">#{tag}</a>
            ))}
          </div>
        )
      }
    </header>

    <!-- 本文 -->
    <div class="post-content content">
      <slot />
    </div>

    {(prev || next) && (
      <nav class="post-nav" aria-label="前後のノート">
        {prev ? (
          <a class="post-nav-card" href={prev.href} aria-label={`前へ: ${prev.title}`}>
            <div class="post-nav-main">
              <div class="post-nav-kicker">← 前へ</div>
              <div class="post-nav-title">{prev.title}</div>
              <div class="post-nav-desc">{prev.description}</div>
              <div class="post-nav-author">
                <img src={prev.authorAvatarUrl} alt="" width="20" height="20" class="post-nav-author-avatar" />
                <span class="post-nav-author-name">{prev.authorName}</span>
              </div>
            </div>
          </a>
        ) : (
          <div class="post-nav-spacer" aria-hidden="true"></div>
        )}

        {next ? (
          <a class="post-nav-card" href={next.href} aria-label={`次へ: ${next.title}`}>
            <div class="post-nav-main">
              <div class="post-nav-kicker">次へ →</div>
              <div class="post-nav-title">{next.title}</div>
              <div class="post-nav-desc">{next.description}</div>
              <div class="post-nav-author">
                <img src={next.authorAvatarUrl} alt="" width="20" height="20" class="post-nav-author-avatar" />
                <span class="post-nav-author-name">{next.authorName}</span>
              </div>
            </div>
          </a>
        ) : (
          <div class="post-nav-spacer" aria-hidden="true"></div>
        )}
      </nav>
    )}

    <!-- フッター -->
    <div class="post-footer">
      <a href="/notes/" class="back-link" aria-label="Back to notes list">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20" aria-hidden="true">
          <path d="M19 12H5M12 19l-7-7 7-7"></path>
        </svg>
        Back
      </a>

      <div class="share-wrap">
        <button class="share-btn" aria-label="シェア" aria-expanded="false" aria-controls="share-menu">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22" aria-hidden="true">
            <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/>
            <polyline points="16 6 12 2 8 6"/>
            <line x1="12" y1="2" x2="12" y2="15"/>
          </svg>
        </button>

        <div class="share-menu" id="share-menu" role="menu" aria-hidden="true">
          <button class="share-item" id="copy-link-btn" role="menuitem" data-url={`https://pr0p0se.com${Astro.url.pathname}`}>
            <span class="share-item-icon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
            </span>
            リンクをコピー
          </button>
          <div class="share-menu-divider"></div>
          <a class="share-item" href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(`https://pr0p0se.com${Astro.url.pathname}`)}`} target="_blank" rel="noopener noreferrer" role="menuitem">
            <span class="share-item-icon share-item-icon--x">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white" width="14" height="14"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.741l7.73-8.835L1.254 2.25H8.08l4.253 5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            </span>
            X
          </a>
          <a class="share-item" href={`https://social-plugins.line.me/lineit/share?url=${encodeURIComponent(`https://pr0p0se.com${Astro.url.pathname}`)}`} target="_blank" rel="noopener noreferrer" role="menuitem">
            <span class="share-item-icon share-item-icon--line">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white" width="16" height="16"><path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63h2.386c.349 0 .63.285.63.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63.349 0 .631.285.631.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.281.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/></svg>
            </span>
            LINE
          </a>
          <a class="share-item" href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(`https://pr0p0se.com${Astro.url.pathname}`)}`} target="_blank" rel="noopener noreferrer" role="menuitem">
            <span class="share-item-icon share-item-icon--fb">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white" width="16" height="16"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            </span>
            Facebook
          </a>
          <a class="share-item" href={`https://www.threads.net/intent/post?text=${encodeURIComponent(`${title} https://pr0p0se.com${Astro.url.pathname}`)}`} target="_blank" rel="noopener noreferrer" role="menuitem">
            <span class="share-item-icon share-item-icon--threads">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 192 192" fill="white" width="14" height="14"><path d="M141.537 88.988a66.667 66.667 0 0 0-2.518-1.143c-1.482-27.307-16.403-42.94-41.457-43.1h-.34c-14.986 0-27.449 6.396-35.12 18.036l13.779 9.452c5.73-8.695 14.724-10.548 21.348-10.548h.229c8.249.053 14.474 2.452 18.503 7.129 2.932 3.405 4.893 8.111 5.864 14.05-7.314-1.243-15.224-1.626-23.68-1.14-23.82 1.371-39.134 15.264-38.105 34.568.522 9.792 5.4 18.216 13.735 23.719 7.047 4.652 16.124 6.927 25.557 6.412 12.458-.683 22.231-5.436 29.049-14.127 5.178-6.6 8.453-15.153 9.899-25.93 5.937 3.583 10.337 8.298 12.767 13.966 4.132 9.635 4.373 25.468-8.546 38.376-11.319 11.308-24.925 16.185-45.488 16.338-22.809-.169-40.06-7.484-51.275-21.742C35.236 139.966 29.808 120.682 29.605 96c.203-24.682 5.63-43.966 16.133-57.317C56.954 24.425 74.205 17.11 97.014 16.941c22.975.17 40.526 7.52 52.171 21.847 5.71 7.026 10.015 15.86 12.853 26.162l16.147-4.308c-3.44-12.68-8.853-23.606-16.219-32.668C147.036 9.607 125.202.195 97.07 0h-.113C68.956.195 47.387 9.577 32.874 27.913 19.684 44.482 12.996 67.316 12.794 96c.202 28.684 6.89 51.518 20.08 68.087 14.513 18.336 36.082 27.718 64.113 27.913h.113c24.882-.168 42.308-6.71 56.7-21.084 18.934-18.921 18.352-42.554 12.137-57.045-4.557-10.622-13.193-19.283-24.4-24.883zM98.44 129.507c-10.44.587-21.286-4.098-21.82-14.135-.397-7.442 5.296-15.746 22.461-16.735 1.966-.113 3.895-.169 5.79-.169 6.235 0 12.068.606 17.371 1.765-1.978 24.702-13.574 28.733-23.802 29.274z"/></svg>
            </span>
            Threads
          </a>
        </div>
        <span class="copy-toast" aria-live="polite"></span>
      </div>
    </div>
    <!-- いいね -->
    <div class="reactions">
      <button class="like-toggle" id="like-btn" data-slug={slug} aria-pressed="false" aria-label="いいね">
        <svg class="heart-outline" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20" aria-hidden="true">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
        </svg>
        <svg class="heart-filled" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20" aria-hidden="true">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
        </svg>
        <span class="like-count" id="like-count">…</span>
      </button>
    </div>

    <!-- コメント -->
    <section class="comments-section" id="comments">
      <h2 class="comments-heading">コメント</h2>
      <ul class="comment-list" id="comment-list">
        <li class="comment-empty">読み込み中…</li>
      </ul>
      <form class="comment-form" id="comment-form">
        <textarea name="body" placeholder="コメントを書く…" rows="3" maxlength="500" required></textarea>
        <div class="comment-form-footer">
          <input type="text" name="author_name" placeholder="名前（省略可）" maxlength="50" autocomplete="off">
          <button type="submit">送信</button>
        </div>
        <p class="form-msg" id="form-msg"></p>
      </form>
    </section>
  </article>
</Base>
<script is:inline set:html={`window.__NOTE_MUSIC_LINKS__ = ${JSON.stringify(musicLinks).replace(/</g, "\\u003c")};`} />
<script is:inline set:html={`
window.__SB_URL__ = ${JSON.stringify(supabaseUrl)};
window.__SB_KEY__ = ${JSON.stringify(supabaseAnonKey)};
`} />

<script>
  // シェアメニュー
  let shareAbort: AbortController | null = null;

  function setupShareMenu() {
    shareAbort?.abort();
    shareAbort = new AbortController();
    const { signal } = shareAbort;

    const btn = document.querySelector<HTMLButtonElement>(".share-btn");
    const menu = document.querySelector<HTMLElement>(".share-menu");
    const copyBtn = document.querySelector<HTMLButtonElement>("#copy-link-btn");
    const toast = document.querySelector<HTMLElement>(".copy-toast");
    if (!btn || !menu) return;

    const open = () => {
      menu.classList.add("open");
      btn.setAttribute("aria-expanded", "true");
      menu.setAttribute("aria-hidden", "false");
    };
    const close = () => {
      menu.classList.remove("open");
      btn.setAttribute("aria-expanded", "false");
      menu.setAttribute("aria-hidden", "true");
    };

    btn.addEventListener("click", (e: MouseEvent) => {
      e.stopPropagation();
      menu.classList.contains("open") ? close() : open();
    }, { signal });

    document.addEventListener("click", (e: MouseEvent) => {
      if (!menu.contains(e.target as Node) && e.target !== btn) close();
    }, { signal });

    document.addEventListener("keydown", (e: KeyboardEvent) => {
      if (e.key === "Escape") close();
    }, { signal });

    copyBtn?.addEventListener("click", async () => {
      const url = copyBtn.dataset.url ?? location.href;
      await navigator.clipboard.writeText(url).catch(() => {});
      close();
      if (toast) {
        toast.textContent = "コピーしました";
        toast.classList.add("show");
        setTimeout(() => toast.classList.remove("show"), 2000);
      }
    }, { signal });
  }

  document.addEventListener("astro:page-load", setupShareMenu);
  setupShareMenu();

  // タブ用データはビルド時にのみ取得（ブラウザから api.song.link は CORS で取得不可のためクライアント fetch は行わない）
  declare global {
    interface Window {
      __NOTE_MUSIC_LINKS__?: Record<string, { linksByPlatform?: Record<string, { url?: string }> }>;
    }
  }

  function pageUrlToEmbedUrl(pageUrl: string | null, service: string) {
    if (!pageUrl || typeof pageUrl !== "string") return null;
    const u = pageUrl.trim();
    try {
      if (service === "spotify" && /spotify\.com/i.test(u)) {
        const m = u.match(/spotify\.com\/(?:intl-[^/]+\/)?(track|album|playlist)\/([a-zA-Z0-9]+)(?:\?|&|$)/);
        if (m) return `https://open.spotify.com/embed/${m[1]}/${m[2]}?utm_source=generator`;
      }
      if ((service === "apple" || service === "appleMusic") && /music\.apple\.com|geo\.music\.apple\.com/i.test(u)) {
        return u.replace(/^https?:\/\/(?:geo\.)?music\.apple\.com/i, "https://embed.music.apple.com");
      }
    } catch (e) {}
    return null;
  }

  function getServiceLabel(service: string) {
    return service === "appleMusic" || service === "apple" ? "Apple Music" : "Spotify";
  }

  function setupTabsSwitch(container: Element) {
    const frames = container.querySelectorAll<HTMLElement>(".note-embed-music-frame");
    const tabs = container.querySelectorAll<HTMLElement>(".note-embed-music-tab");
    function activate(service: string) {
      frames.forEach((f) => {
        const on = f.dataset.service === service;
        f.classList.toggle("active", on);
        f.setAttribute("aria-hidden", on ? "false" : "true");
      });
      tabs.forEach((t) => {
        const on = t.dataset.service === service;
        t.classList.toggle("active", on);
        t.setAttribute("aria-selected", on ? "true" : "false");
      });
    }
    tabs.forEach((tab) => {
      tab.addEventListener("click", (e: Event) => {
        e.preventDefault();
        const s = (e.currentTarget as HTMLElement | null)?.dataset?.service;
        if (s) activate(s);
      });
    });
  }

  function run() {
    const containers = document.querySelectorAll(".note-embed-music-tabs[data-music-url]");
    containers.forEach((container) => {
      const url = container.getAttribute("data-music-url");
      if (!url) return;

      const existingServices = new Set(
        Array.from(container.querySelectorAll<HTMLElement>(".note-embed-music-frame"))
          .map((f) => f.dataset?.service)
          .filter(Boolean)
      );

      const preloaded =
        typeof window !== "undefined" ? window.__NOTE_MUSIC_LINKS__?.[url] : undefined;
      const linksByPlatform = preloaded?.linksByPlatform ?? {};

      const framesWrap = container.querySelector(".note-embed-music-frames");
      const tablist = container.querySelector(".note-embed-music-tablist");
      if (!framesWrap || !tablist) {
        setupTabsSwitch(container);
        return;
      }

      const order = [
        { key: "spotify", service: "spotify" },
        { key: "appleMusic", service: "apple" },
      ];
      for (const { key, service } of order) {
        const plat = (linksByPlatform as Record<string, { url?: string } | undefined>)[key];
        const pageUrl = plat?.url ?? null;
        if (!pageUrl || existingServices.has(service)) continue;
        const embedUrl = pageUrlToEmbedUrl(pageUrl, key === "appleMusic" ? "apple" : key);
        if (!embedUrl) continue;

        const frame = document.createElement("div");
        frame.className = "note-embed-music-frame";
        frame.dataset.service = service;
        frame.setAttribute("aria-hidden", "true");
        const esc = (s: string) =>
          s.replace(/&/g, "&amp;").replace(/"/g, "&quot;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
        frame.innerHTML = `<iframe src="${esc(embedUrl)}" title="${esc(getServiceLabel(service))}" width="100%" height="152" frameborder="0" allowfullscreen allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"></iframe>`;
        framesWrap.appendChild(frame);

        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "note-embed-music-tab";
        btn.role = "tab";
        btn.setAttribute("aria-selected", "false");
        btn.dataset.service = service;
        btn.textContent = getServiceLabel(service);
        tablist.appendChild(btn);

        existingServices.add(service);
      }

      setupTabsSwitch(container);
    });
  }

  document.addEventListener("astro:page-load", run);
  run();
</script>

<script>
  // いいね・コメント
  declare global {
    interface Window {
      __SB_URL__: string;
      __SB_KEY__: string;
    }
  }

  let reactionsAbort: AbortController | null = null;

  function setupReactions() {
    reactionsAbort?.abort();
    reactionsAbort = new AbortController();
    const { signal } = reactionsAbort;
    const SB_URL = window.__SB_URL__;
    const SB_KEY = window.__SB_KEY__;

    // slugはDOMのdata属性から読む（window変数はView Transitionsで更新タイミングがズレるため）
    const likeBtn = document.getElementById('like-btn') as HTMLButtonElement | null;
    const slug = likeBtn?.dataset.slug ?? '';

    if (!SB_URL || !SB_KEY || !slug) return;

    const sbHeaders: Record<string, string> = {
      apikey: SB_KEY,
      Authorization: `Bearer ${SB_KEY}`,
      'Content-Type': 'application/json',
    };

    // ── いいね ───────────────────────────────────────────────
    // ブラウザごとの識別子をlocalStorageに保持（DELETE時に対象行を特定するために必要）
    function getUserKey(): string {
      let key = localStorage.getItem('noteUserKey');
      if (!key) {
        key = crypto.randomUUID();
        localStorage.setItem('noteUserKey', key);
      }
      return key;
    }

    const likedKey = `liked_${slug}`;

    async function loadLikes() {
      try {
        const res = await fetch(
          `${SB_URL}/rest/v1/note_likes?slug=eq.${encodeURIComponent(slug)}&select=like_count`,
          { headers: sbHeaders, signal }
        );
        const rows = await res.json().catch(() => []) as Array<{ like_count: number }>;
        const count = rows?.[0]?.like_count ?? 0;

        // いいね済みかどうかはlocalStorageのみで判定（Supabaseは参照しない）
        const isLiked = localStorage.getItem(likedKey) === 'true';
        applyLikeState(isLiked, count);
      } catch (e) {
        if (e instanceof DOMException && e.name === 'AbortError') return;
        throw e;
      }
    }

    function applyLikeState(isLiked: boolean, count: number) {
      const btn = document.getElementById('like-btn') as HTMLButtonElement | null;
      const countEl = document.getElementById('like-count');
      if (!btn || !countEl) return;
      btn.setAttribute('aria-pressed', String(isLiked));
      countEl.textContent = String(count);
    }

    likeBtn?.addEventListener('click', async () => {
      const btn = likeBtn;
      const countEl = document.getElementById('like-count')!;
      const isLiked = btn.getAttribute('aria-pressed') === 'true';
      const currentCount = parseInt(countEl.textContent ?? '0') || 0;
      const userKey = getUserKey();

      btn.disabled = true;

      if (!isLiked) {
        // いいね
        applyLikeState(true, currentCount + 1);
        localStorage.setItem(likedKey, 'true');
        await fetch(`${SB_URL}/rest/v1/rpc/note_like`, {
          method: 'POST',
          headers: sbHeaders,
          body: JSON.stringify({ slug, delta: 1 }),
          signal,
        });
      } else {
        // いいね取消し
        applyLikeState(false, Math.max(0, currentCount - 1));
        localStorage.removeItem(likedKey);
        await fetch(`${SB_URL}/rest/v1/rpc/note_like`, {
          method: 'POST',
          headers: sbHeaders,
          body: JSON.stringify({ slug, delta: -1 }),
          signal,
        });
      }
      await loadLikes();
      btn.disabled = false;
    }, { signal });

    // ── コメント ─────────────────────────────────────────────
    function esc(s: string) {
      return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    function fmtDate(iso: string) {
      const d = new Date(iso);
      return `${d.getFullYear()}/${String(d.getMonth()+1).padStart(2,'0')}/${String(d.getDate()).padStart(2,'0')} ${String(d.getHours()).padStart(2,'0')}:${String(d.getMinutes()).padStart(2,'0')}`;
    }

    async function loadComments() {
      const res = await fetch(
        `${SB_URL}/rest/v1/note_comments?slug=eq.${encodeURIComponent(slug)}&order=created_at.asc&select=id,body,author_name,anon_number,created_at,parent_id`,
        { headers: sbHeaders, signal }
      );
      const all = await res.json() as Array<{id:string;body:string;author_name:string|null;anon_number:number;created_at:string;parent_id:string|null}>;
      const list = document.getElementById('comment-list')!;
      list.innerHTML = '';

      if (!Array.isArray(all) || all.length === 0) {
        list.innerHTML = '<li class="comment-empty">まだコメントはありません</li>';
        return;
      }

      const tops = all.filter(c => !c.parent_id);
      const repliesMap: Record<string, typeof all> = {};
      all.filter(c => c.parent_id).forEach(r => {
        (repliesMap[r.parent_id!] ??= []).push(r);
      });
      tops.forEach(c => list.appendChild(renderComment(c, repliesMap[c.id] ?? [])));
    }

    function buildAuthor(anon: number, name: string | null) {
      return name ? `${esc(String(anon))}. <strong>${esc(name)}</strong>` : esc(String(anon));
    }

    function renderComment(c: {id:string;body:string;author_name:string|null;anon_number:number;created_at:string}, replies: Array<{id:string;body:string;author_name:string|null;anon_number:number;created_at:string}>) {
      const li = document.createElement('li');
      li.className = 'comment-item';
      li.innerHTML = `
        <div class="comment-meta">
          <span class="comment-author">${buildAuthor(c.anon_number, c.author_name)}</span>
          <span class="comment-date">${esc(fmtDate(c.created_at))}</span>
        </div>
        <div class="comment-body">${esc(c.body)}</div>
        <div class="comment-replies"></div>
        <button class="reply-btn" type="button">返信</button>
      `;
      const repliesEl = li.querySelector('.comment-replies')!;
      replies.forEach(r => {
        const div = document.createElement('div');
        div.className = 'reply-item';
        div.innerHTML = `
          <div class="comment-meta">
            <span class="comment-author">${buildAuthor(r.anon_number, r.author_name)}</span>
            <span class="comment-date">${esc(fmtDate(r.created_at))}</span>
          </div>
          <div class="comment-body">${esc(r.body)}</div>
        `;
        repliesEl.appendChild(div);
      });
      li.querySelector('.reply-btn')!.addEventListener('click', () => {
        if (li.querySelector('.reply-form')) return;
        const form = buildReplyForm(c.id);
        li.querySelector('.reply-btn')!.insertAdjacentElement('afterend', form);
        (form.querySelector('textarea') as HTMLTextAreaElement).focus();
      });
      return li;
    }

    function buildReplyForm(parentId: string) {
      const div = document.createElement('div');
      div.className = 'reply-form';
      div.innerHTML = `
        <textarea placeholder="返信を書く…" rows="3" maxlength="500"></textarea>
        <div class="reply-form-footer">
          <input type="text" class="reply-name" placeholder="名前（省略可）" maxlength="50" autocomplete="off">
          <button class="btn-cancel" type="button">キャンセル</button>
          <button class="btn-submit" type="button">送信</button>
        </div>
      `;
      div.querySelector('.btn-cancel')!.addEventListener('click', () => div.remove());
      (div.querySelector('.btn-submit') as HTMLButtonElement).addEventListener('click', async () => {
        const text = (div.querySelector('textarea') as HTMLTextAreaElement).value.trim();
        if (!text) return;
        const name = (div.querySelector('.reply-name') as HTMLInputElement).value.trim();
        const btn = div.querySelector('.btn-submit') as HTMLButtonElement;
        btn.disabled = true;
        const ok = await postComment(text, name, parentId);
        if (ok) { loadComments(); div.remove(); }
        else btn.disabled = false;
      });
      return div;
    }

    // localStorage 2段階レート制限（UX用・突破可だがサーバー側でも制限）
    function checkLocalRateLimit(): string | null {
      const now = Date.now();
      const stored = localStorage.getItem('commentTs');
      const timestamps: number[] = stored ? JSON.parse(stored) : [];
      const recent = timestamps.filter(t => t > now - 600_000); // 直近10分
      const lastMin = recent.filter(t => t > now - 60_000);
      if (lastMin.length >= 3) return '1分間に3回まで送信できます。少し待ってください。';
      if (recent.length >= 5) return '10分間に5回まで送信できます。少し待ってください。';
      return null;
    }

    function recordLocalComment() {
      const now = Date.now();
      const stored = localStorage.getItem('commentTs');
      const timestamps: number[] = stored ? JSON.parse(stored) : [];
      const recent = timestamps.filter(t => t > now - 600_000);
      recent.push(now);
      localStorage.setItem('commentTs', JSON.stringify(recent));
    }

    async function postComment(body: string, authorName: string, parentId: string | null = null): Promise<boolean> {
      const limitMsg = checkLocalRateLimit();
      if (limitMsg) { alert(limitMsg); return false; }

      const res = await fetch(`${SB_URL}/functions/v1/post-comment`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ slug, body, author_name: authorName, parent_id: parentId }),
      });

      if (res.status === 429) {
        const data = await res.json().catch(() => ({})) as { message?: string };
        alert(data.message ?? '送信が多すぎます。しばらく待ってから再試行してください。');
        return false;
      }
      if (res.ok) { recordLocalComment(); return true; }
      return false;
    }

    const commentForm = document.getElementById('comment-form') as HTMLFormElement | null;
    commentForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target as HTMLFormElement;
      const msg = document.getElementById('form-msg')!;
      const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;
      const body = (form.elements.namedItem('body') as HTMLTextAreaElement).value.trim();
      const authorName = ((form.elements.namedItem('author_name') as HTMLInputElement)?.value ?? '').trim();
      btn.disabled = true;
      msg.textContent = '送信中…';
      const ok = await postComment(body, authorName);
      if (ok) {
        (form.elements.namedItem('body') as HTMLTextAreaElement).value = '';
        (form.elements.namedItem('author_name') as HTMLInputElement).value = '';
        msg.textContent = '送信しました';
        await loadComments();
        setTimeout(() => { msg.textContent = ''; }, 3000);
      } else {
        msg.textContent = '送信に失敗しました';
      }
      btn.disabled = false;
    }, { signal });

    loadLikes();
    loadComments();
  }

  document.addEventListener('astro:page-load', setupReactions);
  setupReactions();
</script>

