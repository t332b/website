---
import Base from "./Base.astro";
import { getCollection } from 'astro:content';

export interface Props {
  title: string;
  date: Date;
  author: string;
  tags?: string[];
  cover?: string;
}

const { title, date, author, tags, cover } = Astro.props;

// メンバー情報を取得
const members = await getCollection('member');
const member = members.find(m => m.data.id === author);
---

<Base title={title}>
  <article class="note-post">
    <!-- ヘッダー -->
    <header class="post-header">
      <h1 class="post-title">{title}</h1>
      
      <div class="post-meta">
        <div class="post-date">
          {date.toLocaleDateString('ja-JP')}
        </div>
        <div class="post-separator">・</div>
        <div class="post-author">
          {member?.data.name || author}
        </div>
      </div>
      
      {tags && tags.length > 0 && (
        <div class="post-tags">
          {tags.map(tag => (
            <span class="tag">#{tag}</span>
          ))}
        </div>
      )}
    </header>

    <!-- カバー画像 -->
    {cover && (
      <div class="post-cover">
        <img src={cover} alt="" />
      </div>
    )}

    <!-- 本文 -->
    <div class="post-content content">
      <slot />
    </div>

    <!-- 戻るリンク -->
    <div class="post-footer">
      <a href="/notes/" class="back-link">← ノート一覧に戻る</a>
    </div>
  </article>
</Base>

<style>
  .note-post {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  .post-header {
    margin-bottom: 2rem;
  }

  .post-title {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 1rem;
    color: var(--fg);
    line-height: 1.2;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
    font-size: 1rem;
  }

  .post-date {
    color: var(--muted);
  }

  .post-separator {
    color: var(--muted);
  }

  .post-author {
    color: var(--accent);
    font-weight: 600;
  }

  .post-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tag {
    background: var(--wa-cream);
    color: var(--accent);
    padding: 0.25rem 0.75rem;
    border-radius: 12px;
    font-size: 0.9rem;
    border: 1px solid var(--wa-butter);
  }

  .post-cover {
    margin-bottom: 2rem;
  }

  .post-cover img {
    width: 100%;
    height: auto;
    border-radius: 12px;
    border: 2px solid var(--wa-cream);
  }

  .post-content {
    line-height: 1.8;
    font-size: 1.1rem;
  }

  .post-footer {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 2px solid var(--wa-butter);
  }

  .back-link {
    color: var(--accent);
    text-decoration: none;
    font-weight: 600;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: var(--wa-forest);
  }

  @media (max-width: 768px) {
    .post-title {
      font-size: 2rem;
    }

    .post-content {
      font-size: 1rem;
    }
  }
</style>
