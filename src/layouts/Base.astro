---
import "../styles/theme.css";
import { ViewTransitions } from "astro:transitions";
import AudioPlayer from "../components/AudioPlayer.astro";
import Navigation from "../components/Navigation.astro";
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>PR0P0SE</title>

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/images/favicon.ico" />

    <!-- View Transitions でページ遷移時も再生状態を維持 -->
    <ViewTransitions />
  </head>
  <body>
    <div class="container">
      <header class="header">
        <!-- タイトル行 -->
        <div class="header-title">
          <a class="brand" href="/">
            <img src="/images/logo/PR0P0SE - Lighthouse EP LOGO green.png" alt="PR0P0SE" class="brand-logo" />
          </a>
          <div class="header-illust">
            <img src="/images/illust/daijin.png" alt="" class="header-illust-img daijin" />
            <img src="/images/illust/thames.png" alt="" class="header-illust-img thames" />
          </div>
        </div>
        
        <!-- ソーシャルリンクとオーディオプレーヤー行 -->
        <div class="header-middle">
          <div class="header-social">
            <a href="https://bandcamp.com/" target="_blank" rel="noopener noreferrer" class="social-link">
              <img src="/images/logo/bandcamp-button-bc-circle-green-64.png" alt="Bandcamp" />
            </a>
              <a href="https://www.youtube.com/" target="_blank" rel="noopener noreferrer" class="social-link youtube-link">
                <img src="/images/logo/icons8-red-youtube.svg" alt="YouTube" />
              </a>
            <a href="https://soundcloud.com/" target="_blank" rel="noopener noreferrer" class="social-link">
              <img src="/images/logo/soundcloud-2.svg" alt="SoundCloud" />
            </a>
          </div>
          <!-- オーディオプレイヤー -->
          <div class="global-player-wrap" transition:persist="audio-player">
            <AudioPlayer />
          </div>
        </div>
        
        <!-- ナビゲーション -->
        <Navigation currentPath={Astro.url.pathname} />
      </header>
    </div>

    <main class="main">
      <slot />
    </main>

    <footer class="footer">
      © {new Date().getFullYear()} PR0P0SE
    </footer>
  </body>
</html>

<style is:global>
  /* ヘッダー全体の設定 */
  .header {
    width: 100%;
    margin-bottom: 0;
    padding: 1rem 0;
  }

  /* タイトル行 */
  .header-title {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    margin-bottom: 1.5rem;
  }

  .brand-logo {
    height: 36px;
    width: auto;
    display: block;
    object-fit: contain;
  }

  .header-illust {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    margin-left: auto;
  }

  .header-illust-img {
    height: 48px;
    width: auto;
    display: block;
    object-fit: contain;
  }

  /* ソーシャルリンクとオーディオプレーヤー行 */
  .header-middle {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 2rem;
    width: 100%;
    margin-bottom: 1.5rem;
  }

  .header-social {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(24px, 1.5vw, 50px);
    align-items: center;
    justify-items: center;
  }

  /* 3個の時は三角形配置（上1個、下2個） */
  .header-social:has(:nth-child(3):last-child) {
    grid-template-columns: 1fr 1fr;
    width: fit-content;
  }

  .header-social:has(:nth-child(3):last-child) :nth-child(1) {
    grid-column: 1 / -1;
    justify-self: center;
  }

  /* 5個の時は上から2・1・2配置 */
  .header-social:has(:nth-child(5):last-child) {
    grid-template-columns: repeat(2, 1fr);
  }

  .header-social:has(:nth-child(5):last-child) :nth-child(3) {
    grid-column: 1 / -1;
    justify-self: center;
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #f5f5f5;
    text-decoration: none;
  }


  .social-link img {
    width: 25px;
    height: 25px;
    object-fit: contain;
  }

  .youtube-link img {
    width: 28px;
    height: 28px;
  }
  
  .global-player-wrap{ 
    display: flex; 
    justify-content: center; 
    align-items: center;
  }

  /* main要素の間隔調整 */
  .main {
    margin-top: 2rem;
  }

  @media (max-width: 320px) {
    .header {
      margin-bottom: 1.5rem;
      padding: 0.5rem 0;
    }

    .header-title {
      flex-direction: column;
      gap: 0.5rem;
      text-align: center;
      margin-bottom: 1rem;
    }

    .header-middle {
      flex-direction: column;
      gap: 1rem;
      margin-bottom: 1rem;
    }

    .header-social {
      display: flex;
      flex-direction: row;
      gap: 8px;
    }

    .header-social:has(:nth-child(3):last-child) :nth-child(1),
    .header-social:has(:nth-child(5):last-child) :nth-child(3) {
      grid-column: auto;
      justify-self: auto;
    }

    .main {
      margin-top: 1rem;
    }

    .brand-logo {
      height: 28px;
    }

    .header-illust {
      margin-left: 0;
      align-self: flex-end;
    }

    .header-illust-img {
      height: 36px;
    }

  }
</style>
