---
import "../styles/theme.css";
import "../styles/release-detail.css";
import { ViewTransitions } from "astro:transitions";
import { getCollection } from "astro:content";
import AudioPlayer from "../components/AudioPlayer.astro";
import Navigation from "../components/Navigation.astro";
import Piano from "../components/Piano.astro";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const SITE_URL = "https://pr0p0se.com";
const DEFAULT_OG_IMAGE = `${SITE_URL}/images/ogp-notes-default.png`;

const {
  title = "PR0P0SE",
  description = "PR0P0SE Official Website",
  ogImage = DEFAULT_OG_IMAGE,
} = Astro.props;

const pageTitle = title === "PR0P0SE" ? "PR0P0SE" : `${title} | PR0P0SE`;
const ogImageUrl = ogImage.startsWith("http") ? ogImage : `${SITE_URL}${ogImage}`;

const members = await getCollection("member");
const memberById = (id: string) => members.find((m) => m.data.id === id)?.data ?? null;
const daijinMember = memberById("onomatopedaijin");
const thamesMember = memberById("thamesbeat");

function avatarUrl(m: { avatar?: string; github?: string } | null): string {
  if (!m) return "/images/illust/fixed_daijin.svg";
  if (m.avatar) {
    if (m.avatar.startsWith("http://") || m.avatar.startsWith("https://")) return m.avatar;
    return m.avatar.startsWith("/") ? m.avatar : `/${m.avatar}`;
  }
  if (m.github) return `https://github.com/${m.github}.png?size=128`;
  return "/images/uploads/default-avatar.png";
}
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PR0P0SE" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- イラストキャプション用手書き風フォント -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@400;500&display=swap" rel="stylesheet" />

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/images/favicon.ico" />

    <!-- View Transitions でページ遷移時も再生状態を維持 -->
    <ViewTransitions />

