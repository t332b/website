---
import "../styles/theme.css";
const { title = "PR0P0SE" } = Astro.props;
import AudioPlayer from "../components/AudioPlayer.astro";
import Navigation from "../components/Navigation.astro";
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Fonts（見出し=Spectral / 本文=Figtree） -->
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;600;700&family=Spectral:wght@700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <svg width="0" height="0" style="position:absolute">
      <filter id="grain">
        <feTurbulence type="fractalNoise" baseFrequency="0.8" numOctaves="2" stitchTiles="stitch"/>
        <feColorMatrix type="saturate" values="0"/>
      </filter>
    </svg>
    <div class="container">
      <header class="header">
        <div class="header-content">
          <a class="brand" href="/">
            <span>PR0P0SE</span>
          </a>
          <div class="header-social">
            <a href="https://bandcamp.com/" target="_blank" rel="noopener noreferrer" class="social-link">
              <img src="/images/logo/Bandcamp-button-bc-circle-black.svg.png" alt="Bandcamp" />
            </a>
            <a href="https://www.youtube.com/" target="_blank" rel="noopener noreferrer" class="social-link">
              <img src="/images/logo/icons8-youtube.svg" alt="YouTube" />
            </a>
            <a href="https://soundcloud.com/" target="_blank" rel="noopener noreferrer" class="social-link">
              <img src="/images/logo/soundcloud-icon.svg" alt="SoundCloud" />
            </a>
          </div>
        </div>
      </header>

      <!-- オーディオプレイヤー -->
      <div class="global-player-wrap">
        <AudioPlayer audioSrc="/music/intro.mp3" />
      </div>

      <!-- 共通ナビゲーション -->
      <Navigation />
    </div>

    <main class="main">
      <slot />
    </main>

    <footer class="footer">
      © {new Date().getFullYear()} PR0P0SE
    </footer>
  </body>
</html>

<style is:global>
  /* グレイン模様の背景 - ページ全体に適用 */
  html::after {
    content: "";
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 9999;
    background: rgba(255, 255, 255, 0.03);
    filter: url(#grain);
    opacity: 0.6;
    mix-blend-mode: multiply;
  }

  .header-content {
    position: relative;
  }

  .header-social {
    position: absolute;
    bottom: 4px;
    right: 0;
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: var(--wa-cream, #f6f3ea);
    transition: all 0.2s ease;
    text-decoration: none;
  }

  .social-link:hover {
    background: var(--wa-teal, #2bb6a9);
    transform: translateY(-2px);
  }

  .social-link img {
    width: 18px;
    height: 18px;
    object-fit: contain;
  }
  
  .global-player-wrap{ 
    display: flex; 
    justify-content: flex-end; 
    padding: 0.25rem 0;
    margin-bottom: 0.25rem;
  }

  @media (max-width: 768px) {
    .header-social {
      position: relative;
      bottom: auto;
      right: auto;
      order: 2;
    }
  }
</style>
