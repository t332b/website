    <!-- グローバルリリースモーダル（works 一覧・プレーヤー曲名から開く） -->
    <div class="release-overlay" id="global-release-modal" aria-hidden="true" style="display: none;">
      <div class="release-backdrop" data-close-global-release aria-label="閉じる"></div>
      <div class="release-content">
        <button type="button" class="release-close" data-close-global-release aria-label="閉じる">&times;</button>
        <div id="global-release-detail-slot"></div>
        <button
          type="button"
          class="release-nav release-nav--prev"
          id="global-release-prev"
          aria-label="前のリリース"
          style="display: none;"
        >
          ‹
        </button>
        <button
          type="button"
          class="release-nav release-nav--next"
          id="global-release-next"
          aria-label="次のリリース"
          style="display: none;"
        >
          ›
        </button>
      </div>
    </div>

    <script>
      // プロフィールモーダル: View Transitions 後も動くよう body でイベント委譲
      function handleProfileModalOpen(e: Event) {
        const btn = (e.target as Element).closest(".header-illust-btn[data-profile-modal]");
        if (!btn) return;
        const modalId = btn.getAttribute("data-profile-modal");
        if (!modalId) return;
        const modal = document.getElementById(modalId) as HTMLElement | null;
        if (!modal) return;
        modal.setAttribute("aria-hidden", "false");
        (modal.querySelector(".profile-modal-close") as HTMLElement)?.focus();
      }
      function handleProfileModalClose(e: Event) {
        const closeEl = (e.target as Element).closest("[data-close-modal]");
        if (!closeEl) return;
        const modal = closeEl.closest(".profile-modal");
        if (modal) (modal as HTMLElement).setAttribute("aria-hidden", "true");
      }
      function handleProfileModalKeydown(e: KeyboardEvent) {
        if (e.key !== "Escape") return;
        document.querySelectorAll(".profile-modal[aria-hidden='false']").forEach((modal) => {
          (modal as HTMLElement).setAttribute("aria-hidden", "true");
        });
      }
      function setupProfileModals() {
        document.body.removeEventListener("click", handleProfileModalOpen);
        document.body.addEventListener("click", handleProfileModalOpen);
        document.body.removeEventListener("click", handleProfileModalClose);
        document.body.addEventListener("click", handleProfileModalClose);
        document.removeEventListener("keydown", handleProfileModalKeydown);
        document.addEventListener("keydown", handleProfileModalKeydown);
      }
      setupProfileModals();
      document.addEventListener("astro:page-load", setupProfileModals);

      // グローバルリリースモーダル（works 一覧・プレーヤー曲名から開く）
      let globalReleaseSlugs: string[] = [];
      let currentGlobalSlug = "";

      async function loadReleaseFragment(slug: string) {
        const slot = document.getElementById("global-release-detail-slot");
        if (!slot) return;
        slot.innerHTML = '<p style="padding:2rem;text-align:center;color:#666;">読み込み中…</p>';
        try {
          const res = await fetch(`/works/fragments/${slug}`);
          if (!res.ok) throw new Error(res.statusText);
          const html = await res.text();
          const doc = new DOMParser().parseFromString(html, "text/html");
          const frag = doc.getElementById("fragment-content");
          slot.innerHTML = frag ? frag.innerHTML : "";
        } catch {
          slot.innerHTML = '<p style="padding:2rem;text-align:center;color:#c00;">読み込みに失敗しました。</p>';
        }
      }

      function closeGlobalReleaseModal() {
        const modal = document.getElementById("global-release-modal");
        if (modal) {
          modal.style.display = "none";
          modal.setAttribute("aria-hidden", "true");
          document.body.style.overflow = "";
        }
      }

      function updateGlobalReleaseNav() {
        const prevBtn = document.getElementById("global-release-prev");
        const nextBtn = document.getElementById("global-release-next");
        const idx = globalReleaseSlugs.indexOf(currentGlobalSlug);
        if (prevBtn) prevBtn.style.display = globalReleaseSlugs.length <= 1 || idx <= 0 ? "none" : "flex";
        if (nextBtn)
          nextBtn.style.display =
            globalReleaseSlugs.length <= 1 || idx < 0 || idx >= globalReleaseSlugs.length - 1 ? "none" : "flex";
      }

      function registerOpenReleaseModal() {
        (
          window as unknown as { openReleaseModal: (slug: string, options?: { prevNextSlugs?: string[] }) => void }
        ).openReleaseModal = function (slug: string, options?: { prevNextSlugs?: string[] }) {
          const modal = document.getElementById("global-release-modal");
          const prevBtn = document.getElementById("global-release-prev");
          const nextBtn = document.getElementById("global-release-next");
          if (!modal) return;

          globalReleaseSlugs = options?.prevNextSlugs ?? [];
          currentGlobalSlug = slug;

          modal.style.display = "flex";
          modal.setAttribute("aria-hidden", "false");
          document.body.style.overflow = "hidden";
          loadReleaseFragment(slug);
          updateGlobalReleaseNav();

          if (prevBtn) {
            prevBtn.onclick = () => {
              const idx = globalReleaseSlugs.indexOf(currentGlobalSlug);
              if (idx <= 0) return;
              currentGlobalSlug = globalReleaseSlugs[idx - 1];
              loadReleaseFragment(currentGlobalSlug);
              updateGlobalReleaseNav();
            };
          }
          if (nextBtn) {
            nextBtn.onclick = () => {
              const idx = globalReleaseSlugs.indexOf(currentGlobalSlug);
              if (idx < 0 || idx >= globalReleaseSlugs.length - 1) return;
              currentGlobalSlug = globalReleaseSlugs[idx + 1];
              loadReleaseFragment(currentGlobalSlug);
              updateGlobalReleaseNav();
            };
          }
        };
      }
      registerOpenReleaseModal();
      document.addEventListener("astro:page-load", registerOpenReleaseModal);

      // works のリリースカードクリックは body で委譲。View Transitions 後も動くよう astro:page-load で再登録
      function getVisibleSlugsForModal() {
        return Array.from(document.querySelectorAll(".release-card--clickable:not(.hidden)"))
          .map((c) => (c as HTMLElement).dataset.slug)
          .filter(Boolean) as string[];
      }
      function handleReleaseCardClick(e: MouseEvent) {
        const card = (e.target as Element).closest(".release-card--clickable");
        if (!card) return;
        const slug = (card as HTMLElement).dataset.slug;
        if (
          !slug ||
          typeof (window as unknown as { openReleaseModal?: (s: string, o?: { prevNextSlugs?: string[] }) => void })
            .openReleaseModal !== "function"
        )
          return;
        if (e.button === 0 && !e.ctrlKey && !e.metaKey && !e.shiftKey) {
          e.preventDefault();
          (
            window as unknown as { openReleaseModal: (s: string, o?: { prevNextSlugs?: string[] }) => void }
          ).openReleaseModal(slug, { prevNextSlugs: getVisibleSlugsForModal() });
        }
      }
      function setupReleaseCardDelegation() {
        document.body.removeEventListener("click", handleReleaseCardClick);
        document.body.addEventListener("click", handleReleaseCardClick);
      }
      setupReleaseCardDelegation();
      document.addEventListener("astro:page-load", setupReleaseCardDelegation);

      // 閉じるボタン・バックドロップ: モーダル上でイベント委譲（View Transitions・動的読み込み後も確実に動作）
      function setupModalCloseDelegation() {
        const modal = document.getElementById("global-release-modal");
        if (!modal || modal.hasAttribute("data-close-delegation-set")) return;
        modal.setAttribute("data-close-delegation-set", "");
        modal.addEventListener("click", (e: Event) => {
          if ((e.target as Element).closest("[data-close-global-release]")) {
            closeGlobalReleaseModal();
          }
        });
      }
      setupModalCloseDelegation();
      document.addEventListener("astro:page-load", setupModalCloseDelegation);

      // モーダル本体の左右スワイプで前後の作品へ移動
      function setupModalSwipeDelegation() {
        const modal = document.getElementById("global-release-modal");
        if (!modal || modal.hasAttribute("data-swipe-delegation-set")) return;
        modal.setAttribute("data-swipe-delegation-set", "");

        let touchStartX = 0;
        let touchStartY = 0;
        let touchEndX = 0;
        let touchEndY = 0;
        const swipeThreshold = 50;

        modal.addEventListener(
          "touchstart",
          (e: TouchEvent) => {
            if (e.changedTouches.length === 0) return;
            touchStartX = e.changedTouches[0].clientX;
            touchStartY = e.changedTouches[0].clientY;
          },
          { passive: true },
        );

        modal.addEventListener(
          "touchend",
          (e: TouchEvent) => {
            if (modal.getAttribute("aria-hidden") === "true" || e.changedTouches.length === 0) return;

            touchEndX = e.changedTouches[0].clientX;
            touchEndY = e.changedTouches[0].clientY;

            const deltaX = touchEndX - touchStartX;
            const deltaY = touchEndY - touchStartY;

            // 縦スクロールを誤認しないよう、横移動が優位なときだけ判定
            if (Math.abs(deltaX) < swipeThreshold || Math.abs(deltaX) <= Math.abs(deltaY) * 1.2) return;

            const idx = globalReleaseSlugs.indexOf(currentGlobalSlug);
            if (deltaX < 0 && idx >= 0 && idx < globalReleaseSlugs.length - 1) {
              document.getElementById("global-release-next")?.click();
            } else if (deltaX > 0 && idx > 0) {
              document.getElementById("global-release-prev")?.click();
            }
          },
          { passive: true },
        );
      }
      setupModalSwipeDelegation();
      document.addEventListener("astro:page-load", setupModalSwipeDelegation);

      document.addEventListener("keydown", (e: KeyboardEvent) => {
        const modal = document.getElementById("global-release-modal");
        if (!modal || modal.getAttribute("aria-hidden") === "true") return;
        if (e.key === "Escape") {
          closeGlobalReleaseModal();
          return;
        }
        if (e.key === "ArrowLeft") {
          const idx = globalReleaseSlugs.indexOf(currentGlobalSlug);
          if (idx > 0) {
            e.preventDefault();
            document.getElementById("global-release-prev")?.click();
          }
        } else if (e.key === "ArrowRight") {
          const idx = globalReleaseSlugs.indexOf(currentGlobalSlug);
          if (idx >= 0 && idx < globalReleaseSlugs.length - 1) {
            e.preventDefault();
            document.getElementById("global-release-next")?.click();
          }
        }
      });
    </script>
  </body>
</html>

<style is:global>
  /* ヘッダー全体の設定 */
  .header {
    width: 100%;
    margin-bottom: 0;
    padding: 1rem 0;
  }

  /* タイトル行 */
