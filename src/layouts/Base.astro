  .profile-modal-close:hover {
    opacity: 1;
  }
  .profile-modal-body {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    text-align: left;
  }
  .profile-modal-avatar {
    width: 72px;
    height: 72px;
    min-width: 72px;
    object-fit: cover;
    display: block;
  }
  .profile-modal-text {
    flex: 1;
    min-width: 0;
  }
  .profile-modal-name {
    font-size: 0.95rem;
    margin: 0 0 0.35rem;
    font-weight: 600;
