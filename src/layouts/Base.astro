      filter 0.2s,
      opacity 0.2s;
  }

  /* イラスト作者表記（キャライラスト下） */
  .header-illust-credit {
    font-family: "Caveat", cursive;
    font-size: 7px;
    color: var(--wa-ink);
    opacity: 0.8;
    text-decoration: none;
    display: block;
    text-align: right;
    margin-top: 0.1rem;
  }
  .header-illust-credit:hover {
    text-decoration: underline;
    opacity: 1;
  }

  /* プロフィールモーダル */
  .profile-modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    visibility: hidden;
    opacity: 0;
    transition:
      visibility 0.2s,
      opacity 0.2s;
  }
  .profile-modal[aria-hidden="false"] {
    visibility: visible;
    opacity: 1;
  }
  .profile-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    cursor: pointer;
  }
  .profile-modal-content {
    position: relative;
    background: var(--bg, var(--wa-paper));
    color: var(--fg, var(--wa-ink));
    border-radius: 8px;
    padding: 0.75rem 1rem;
    max-width: 260px;
    width: 100%;
    box-shadow: var(--shadow);
  }
  .profile-modal-close {
    position: absolute;
    top: 0.25rem;
    right: 0.5rem;
    padding: 0;
    margin: 0;
    border: none;
    background: none;
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
    color: var(--fg);
