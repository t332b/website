---
import "../styles/theme.css";
import { ViewTransitions } from "astro:transitions";
import AudioPlayer from "../components/AudioPlayer.astro";
import Navigation from "../components/Navigation.astro";
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>PR0P0SE</title>

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Fonts（見出し=Spectral / 本文=Figtree） -->
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;600;700&family=Spectral:wght@700;800&display=swap"
      rel="stylesheet"
    />
    
    <!-- View Transitions でページ遷移時も再生状態を維持 -->
    <ViewTransitions />
  </head>
  <body>
    <div class="container">
      <header class="header">
        <!-- タイトル行 -->
        <div class="header-title">
          <a class="brand" href="/">
            <span>PR0P0SE</span>
          </a>
          <div class="header-image">
            <!-- 将来的に絵を配置 -->
          </div>
        </div>
        
        <!-- ソーシャルリンクとオーディオプレーヤー行 -->
        <div class="header-middle">
          <div class="header-social">
            <a href="https://bandcamp.com/" target="_blank" rel="noopener noreferrer" class="social-link">
              <img src="/images/logo/bandcamp-button-bc-circle-green-64.png" alt="Bandcamp" />
            </a>
              <a href="https://www.youtube.com/" target="_blank" rel="noopener noreferrer" class="social-link youtube-link">
                <img src="/images/logo/icons8-red-youtube.svg" alt="YouTube" />
              </a>
            <a href="https://soundcloud.com/" target="_blank" rel="noopener noreferrer" class="social-link">
              <img src="/images/logo/soundcloud-2.svg" alt="SoundCloud" />
            </a>
          </div>
          <!-- オーディオプレイヤー -->
          <div class="global-player-wrap" transition:persist="audio-player">
            <AudioPlayer audioSrc="/music/intro.mp3" trackSlug="sample-track" />
          </div>
        </div>
        
        <!-- ナビゲーション -->
        <Navigation currentPath={Astro.url.pathname} />
      </header>
    </div>

    <main class="main">
      <slot />
    </main>

    <footer class="footer">
      © {new Date().getFullYear()} PR0P0SE
    </footer>
  </body>
</html>

<style is:global>
  /* ヘッダー全体の設定 */
  .header {
    width: 100%;
    margin-bottom: 2rem;
    padding: 1rem 0;
  }

  /* タイトル行 */
  .header-title {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    margin-bottom: 1.5rem;
  }

  .header-image {
    width: 60px;
    height: 60px;
    background: #f0f0f0;
    border-radius: 8px;
    /* 将来的に絵を配置するためのプレースホルダー */
  }

  /* ソーシャルリンクとオーディオプレーヤー行 */
  .header-middle {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 2rem;
    width: 100%;
    margin-bottom: 1.5rem;
  }

  .header-social {
    display: flex;
    flex-direction: column;
    gap: 6px;
    align-items: center;
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #f5f5f5;
    text-decoration: none;
  }


  .social-link img {
    width: 25px;
    height: 25px;
    object-fit: contain;
  }

  .youtube-link img {
    width: 28px;
    height: 28px;
  }
  
  .global-player-wrap{ 
    display: flex; 
    justify-content: center; 
    align-items: center;
  }

  /* main要素の間隔調整 */
  .main {
    margin-top: 2rem;
  }

  @media (max-width: 320px) {
    .header {
      margin-bottom: 1.5rem;
      padding: 0.5rem 0;
    }

    .header-title {
      flex-direction: column;
      gap: 0.5rem;
      text-align: center;
      margin-bottom: 1rem;
    }

    .header-middle {
      flex-direction: column;
      gap: 1rem;
      margin-bottom: 1rem;
    }

    .header-social {
      flex-direction: row;
      gap: 8px;
    }

    .main {
      margin-top: 1rem;
    }
  }
</style>
