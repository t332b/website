  <style>
    .home-container {
      max-width: 1100px;
      margin: 0 auto;
      padding: 2rem 1rem 4rem;
    }

    .home-release-section {
      text-align: center;
    }

    .home-release-title {
      font-size: clamp(1.8rem, 4vw, 3rem);
      font-weight: 900;
      margin: 0 0 0.5rem 0;
      color: var(--wa-ink);
    }

    .home-release-date {
      color: var(--muted);
      margin-bottom: 2.5rem;
    }

    .home-release-wrap {
      max-width: 500px;
      display: flex;
      justify-content: center;
    }

    .home-release-cover img {
      width: 100%;
      border-radius: 18px;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.12);
    }

    .home-release-embed iframe {
      border-radius: 18px;
    }

    .home-release-btn {
      display: inline-block;
      padding: 0.8rem 2rem;
      border: 2px solid var(--wa-ink);
      text-decoration: none;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      transition: all 0.3s ease;
      color: var(--wa-ink);
    }

    .home-release-btn:hover {
      background: var(--wa-ink);
      color: white;
    }

    @media (max-width: 768px) {
      .home-release-wrap {
        grid-template-columns: 1fr;
        gap: 2rem;
      }
    }
  </style>
</Base>
