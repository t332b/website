---
import Base from "../../../layouts/Base.astro";
import { getCollection } from "astro:content";

/* 最新 Primary Release を1件取得 */
const latestWork =
  (await getCollection("works"))
    .filter((w) => w.data.is_primary_release !== false)
    .sort((a, b) => b.data.release_date.getTime() - a.data.release_date.getTime())[0] ?? null;

/* embed URL生成 */
function getEmbedUrl(service: string, url: string): string | null {
  if (service === "spotify") {
    const m = url.match(/spotify\.com\/(?:intl-[^/]+\/)?(track|album|playlist)\/([a-zA-Z0-9]+)/);
    if (m) return `https://open.spotify.com/embed/${m[1]}/${m[2]}?utm_source=generator`;
  }

  if (service === "youtube") {
    const m = url.match(/(?:v=|youtu\.be\/|embed\/)([\w-]{11})/);
    if (m) return `https://www.youtube.com/embed/${m[1]}`;
  }

  if (service === "apple") {
    const m = url.match(/music\.apple\.com\/[^/]+\/[^/]+\/(album|song)\/([^/?]+)/);
    if (m) return `https://embed.music.apple.com/${m[2]}`;
  }

  return null;
}
