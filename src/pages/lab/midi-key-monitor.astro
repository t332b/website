---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MIDI Key Monitor</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/x-icon" href={`${base}/images/favicon.ico`} />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,300..700,0..1,-50..200" />
    <style is:global>
      :root {
        --bg: #ffffff;
        --ink: #111827;
        --muted: #6b7280;
        --card: #fbfbfc;
        --border: rgba(15, 23, 42, 0.12);
        --shadow: 0 18px 50px rgba(2, 6, 23, 0.08);

        /* State colors (3 independent signals) */
        --scale-fill: #e0f2fe; /* cyan-100 */
        --scale-ink: #075985;  /* cyan-800 */
        --chord-ring: #a78bfa; /* violet-400 */
        --pressed-glow: #fb7185; /* rose-400 */
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; background: var(--bg); color: var(--ink); font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
      body {
        padding: 18px 14px 56px;
        background:
          radial-gradient(1200px 700px at 10% -10%, rgba(167, 139, 250, 0.18), transparent 55%),
          radial-gradient(900px 600px at 100% 0%, rgba(14, 165, 233, 0.14), transparent 56%),
          radial-gradient(900px 600px at 50% 120%, rgba(251, 113, 133, 0.12), transparent 55%),
          var(--bg);
      }

      .topbar {
        max-width: min(1320px, calc(100vw - 28px));
        margin: 0 auto 12px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
      }
      .topbar h1 { font-size: 16px; margin: 0; font-weight: 700; letter-spacing: 0.02em; }
      .topbar-actions { display: flex; align-items: center; gap: 10px; }
      .icon-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
      }
      .material-symbols-rounded {
        font-variation-settings: "FILL" 0, "wght" 600, "GRAD" 0, "opsz" 20;
        font-size: 18px;
        line-height: 1;
      }
      @media (max-width: 640px) {
        .topbar {
          flex-direction: column;
          align-items: flex-start;
        }
        .topbar-actions {
          width: 100%;
          flex-wrap: wrap;
        }
      }

      .topbar-summary-toggle {
        padding: 10px 12px;
        background: rgba(255,255,255,.82);
        border: 1px solid var(--border);
        border-radius: 14px;
        box-shadow: var(--shadow);
      }
      .topbar-chord-guess {
        font-size: 11px;
        color: var(--muted);
        line-height: 1.2;
        display: none;
        max-width: min(1320px, calc(100vw - 28px));
      }
      .topbar-chord-guess strong {
        color: var(--ink);
        font-weight: 700;
      }
      .btn {
        border: 1px solid var(--border);
        background: rgba(255,255,255,.82);
        color: var(--ink);
        border-radius: 12px;
        padding: 8px 10px;
        font-size: 13px;
        cursor: pointer;
        backdrop-filter: blur(10px);
      }
      .btn:hover { background: rgba(255,255,255,.96); }
      .toggle {
        display: inline-flex; align-items: center; gap: 8px;
        border: 1px solid var(--border);
        background: rgba(255,255,255,.82);
        border-radius: 12px;
        padding: 8px 10px;
        font-size: 13px;
        cursor: pointer;
        user-select: none;
        backdrop-filter: blur(10px);
      }
      .toggle input { margin: 0; }

      .grid {
        /* 以前は 1100px で頭打ち → 窓を広げても鍵盤が大きくならなかった */
        max-width: min(1320px, calc(100vw - 28px));
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 12px;
      }
      /* 合計鍵数が多いときは1列にして、各カードを横幅いっぱいに（鍵が極端に細くならない） */
      .grid.grid--one-col {
        grid-template-columns: 1fr;
      }
      .card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 12px;
        box-shadow: var(--shadow);
        position: relative;
      }
      .card-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 10px;
      }
      .remove-btn {
        position: absolute;
        top: 10px;
        right: 10px;
        width: 34px;
        height: 34px;
        border-radius: 999px;
        border: 1px solid rgba(239, 68, 68, 0.55);
        background: rgba(239, 68, 68, 0.14);
        color: rgba(185, 28, 28, 0.95);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        backdrop-filter: blur(10px);
      }
      .remove-btn:hover {
        background: rgba(239, 68, 68, 0.22);
        border-color: rgba(239, 68, 68, 0.8);
      }
      .controls {
        display: flex;
        flex-wrap: wrap;
        gap: 6px 10px;
        min-width: 0;
        width: 100%;
      }
      .control-row {
        display: flex;
        align-items: center;
        padding: 4px 8px;
        max-width: 100%;
      }
      .control-label {
        font-size: 12px;
        color: black;
        margin-right: 5px;
        white-space: nowrap;
        flex: 0 0 auto;
      }
      .control-field {
        display: flex;
        justify-content: flex-end;
        color: black;
        align-items: center;
        flex: 1 1 auto;
        min-width: 0;
      }
      .control-field > * { max-width: 100%; }
      .segmented {
        display: inline-flex;
        border: 1px solid var(--border);
        background: rgba(255,255,255,.82);
        border-radius: 999px;
        padding: 2px;
        gap: 2px;
      }
      .seg-btn {
        border: 0;
        background: transparent;
        color: var(--muted);
        border-radius: 999px;
        padding: 6px 6px;
        font-size: 12px;
        cursor: pointer;
        line-height: 1;
      }
      .seg-btn:hover { background: rgba(15, 23, 42, 0.05); color: var(--ink); }
      .seg-btn.is-active {
        background: rgba(14, 165, 233, 0.16);
        color: #075985;
      }
      label { font-size: 12px; color: var(--muted); }
      select {
        border: 1px solid var(--border);
        background: rgba(255,255,255,.88);
        border-radius: 12px;
        padding: 6px 8px;
        font-size: 13px;
        color: var(--ink);
      }
      .degrees-row {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px 12px;
        margin: 10px 0 12px;
      }
      .degrees {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin: 0;
      }
      .chord-readout {
        font-size: 10px;
        color: var(--muted);
        display: none;
        letter-spacing: 0.01em;
        margin-left: 6px;
      }
      .chord-readout strong {
        color: var(--ink);
        font-weight: 700;
      }
      .deg-btn {
        border: 1px solid rgba(148, 163, 184, 0.4);
        background: rgba(248, 250, 252, 0.9);
        border-radius: 10px;
        padding: 7px 12px;
        font-size: 13px;
        cursor: pointer;
        line-height: 1.1;
        letter-spacing: 0.04em;
        color: rgba(71, 85, 105, 0.9);
        box-shadow: 0 1px 2px rgba(15, 23, 42, 0.06);
        transition:
          background 140ms ease-out,
          box-shadow 140ms ease-out,
          transform 120ms ease-out,
          color 120ms ease-out,
          border-color 140ms ease-out;
      }
      .deg-btn:hover {
        transform: translateY(-1px);
        background: rgba(241, 245, 249, 0.98);
        box-shadow: 0 3px 8px rgba(15, 23, 42, 0.12);
        color: var(--ink);
      }
      .deg-btn.is-active {
        border-color: rgba(129, 140, 248, 0.9);
        background: rgba(224, 231, 255, 0.98);
        color: #3730a3;
        box-shadow: 0 4px 14px rgba(129, 140, 248, 0.35);
      }

      .piano-wrap { overflow-x: auto; padding-bottom: 6px; }
      .piano {
        position: relative;
        margin: 0 auto;
        background: rgba(255, 255, 255, 0.82);
        border: 1px solid rgba(15, 23, 42, 0.18);
        border-radius: 14px;
        box-shadow: inset 0 0 0 1px rgba(255,255,255,.5), 0 14px 40px rgba(2, 6, 23, 0.10);
        backdrop-filter: blur(10px);
      }
      .key {
        position: absolute;
        top: 0;
        border: none;
        padding: 0;
        margin: 0;
        cursor: pointer;
        user-select: none;
        -webkit-tap-highlight-color: transparent;
      }
      .key-dot {
        position: absolute;
        left: 50%;
        bottom: 10px;
        transform: translateX(-50%);
        width: 16px;
        height: 16px;
        border-radius: 999px;
        background: #f59e0b; /* yellow */
        box-shadow: 0 6px 16px rgba(245, 158, 11, 0.18);
        opacity: 0;
        display: grid;
        place-items: center;
        font-size: 10px;
        line-height: 1;
        font-weight: 700;
        color: rgba(255, 255, 255, 0.98);
        user-select: none;
      }
      .piano.hide-scale-dots .key-dot { opacity: 0 !important; }
      .black-key .key-dot {
        bottom: 8px;
        width: 14px;
        height: 14px;
        box-shadow: 0 6px 16px rgba(245, 158, 11, 0.14);
        font-size: 9px;
      }
      .key.in-scale .key-dot { opacity: 1; }
      .key.is-tonic .key-dot {
        background: #ef4444; /* red */
        box-shadow: 0 8px 18px rgba(239, 68, 68, 0.20);
        color: rgba(255, 255, 255, 0.98);
      }
      .white-key {
        background: #fff;
        border: 2px solid rgba(15, 23, 42, 0.5);
        border-radius: 0 0 6px 6px;
        z-index: 1;
        box-shadow: inset 0 -10px 18px rgba(15, 23, 42, 0.06);
      }
      .black-key {
        background: linear-gradient(180deg, #0b1220 0%, #101b31 100%);
        border-radius: 0 0 5px 5px;
        z-index: 2;
        box-shadow: inset 0 -10px 18px rgba(255, 255, 255, 0.06), 0 8px 18px rgba(2, 6, 23, 0.22);
      }

      /* ---- 3-state visuals (scale/chord/pressed are independent) ---- */
      /* Scale: dot only (no key fill) */
      .key.in-scale.white-key { background: #fff; }
      .key.in-scale.black-key { background: linear-gradient(180deg, #0b1220 0%, #101b31 100%); }

      /* Chord: ring + subtle diagonal stripe overlay (still readable with scale fill) */
      .key.in-chord { box-shadow: inset 0 0 0 2px rgba(167, 139, 250, 0.95); }
      /* Chord root: different ring color */
      .key.in-chord.is-chord-root { box-shadow: inset 0 0 0 2px rgba(217, 70, 239, 0.92); }
      .key.in-chord::after {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: inherit;
        pointer-events: none;
        background:
          repeating-linear-gradient(
            135deg,
            rgba(167, 139, 250, 0.0) 0px,
            rgba(167, 139, 250, 0.0) 6px,
            rgba(167, 139, 250, 0.18) 6px,
            rgba(167, 139, 250, 0.18) 10px
          );
        mix-blend-mode: multiply;
      }
      .key.in-chord.is-chord-root::after {
        background:
          repeating-linear-gradient(
            135deg,
            rgba(217, 70, 239, 0.0) 0px,
            rgba(217, 70, 239, 0.0) 6px,
            rgba(217, 70, 239, 0.20) 6px,
            rgba(217, 70, 239, 0.20) 10px
          );
      }
      /* On black keys, make chord state brighter but keep pressed (red) on top. */
      .key.black-key.in-chord {
        background: linear-gradient(180deg, #1f2937 0%, #020617 100%);
        box-shadow:
          inset 0 0 0 2px rgba(167, 139, 250, 0.95),
          0 0 0 1px rgba(15, 23, 42, 0.9),
          0 10px 22px rgba(15, 23, 42, 0.55);
      }
      .key.black-key.in-chord.is-chord-root {
        box-shadow:
          inset 0 0 0 2px rgba(217, 70, 239, 0.92),
          0 0 0 1px rgba(15, 23, 42, 0.9),
          0 10px 22px rgba(15, 23, 42, 0.55);
      }
      .key.black-key.in-chord::after {
        background:
          repeating-linear-gradient(
            135deg,
            rgba(255, 255, 255, 0.0) 0px,
            rgba(255, 255, 255, 0.0) 6px,
            rgba(255, 255, 255, 0.32) 6px,
            rgba(255, 255, 255, 0.32) 10px
          );
        mix-blend-mode: screen;
        opacity: 0.95;
      }
      .key.black-key.in-chord.is-chord-root::after {
        background:
          repeating-linear-gradient(
            135deg,
            rgba(255, 255, 255, 0.0) 0px,
            rgba(255, 255, 255, 0.0) 6px,
            rgba(245, 208, 254, 0.58) 6px,
            rgba(245, 208, 254, 0.58) 10px
          );
        mix-blend-mode: screen;
        opacity: 0.95;
      }

      /* Pressed: glow + offset (works on top of scale+chord) */
      .key.is-pressed {
        transform: translateY(1px);
        box-shadow:
          /* red border ring (pressed should read instantly) */
          inset 0 0 0 2px rgba(251, 113, 133, 0.95),
          /* keep chord ring subtly under the red when both apply */
          0 0 0 1px rgba(167, 139, 250, 0.35),
          /* balanced glow (not top-heavy) */
          0 10px 26px rgba(251, 113, 133, 0.22),
          0 0 32px rgba(251, 113, 133, 0.26);
      }
      .key.is-pressed::before {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: inherit;
        pointer-events: none;
        background: radial-gradient(circle at 50% 50%, rgba(251, 113, 133, 0.52), rgba(251, 113, 133, 0.0) 180%);
      }
      /* When pressed, suppress chord stripes so赤が優先される */
      .key.is-pressed.in-chord::after {
        opacity: 0.1;
      }

      .summary {
        max-width: min(1320px, calc(100vw - 28px));
        margin: 10px auto 0;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 6px;
      }
      .summary-row {
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .summary-title {
        font-size: 10px;
        color: var(--muted);
        overflow-wrap: anywhere;
      }
      .summary-piano {
        position: relative;
        height: 84px;
        flex: 0 0 auto;
        background: rgba(255,255,255,.85);
        border: 1px solid rgba(15, 23, 42, 0.18);
        overflow: hidden;
        min-width: 240px;
        box-shadow: inset 0 0 0 1px rgba(255,255,255,.5);
      }
      .skey { position: absolute; top: 0; border: 1px solid rgba(15, 23, 42, 0.5); }
      .swhite { background: #fff; height: 84px; z-index: 1; }
      .sblack { background: #111827; height: 51px; z-index: 2; border-top: none; }

      /* Summary: show only currently pressed notes (no scale/chord fill) */
      .skey.is-pressed {
        box-shadow:
          inset 0 0 0 2px rgba(251, 113, 133, 0.95),
          0 0 0 2px rgba(251, 113, 133, 0.22);
      }

      .topbar-midi-group {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
      }
      .topbar-midi-group .segmented {
        flex-shrink: 0;
      }
      .midi-settings-open {
        padding: 8px 10px;
        min-width: 40px;
        justify-content: center;
      }
      .midi-settings-open .material-symbols-rounded {
        font-size: 22px;
      }

      .midi-settings-backdrop {
        position: fixed;
        inset: 0;
        z-index: 80;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 16px;
        background: rgba(15, 23, 42, 0.45);
        backdrop-filter: blur(4px);
      }
      .midi-settings-backdrop.is-open {
        display: flex;
      }
      .midi-settings-dialog {
        width: min(420px, 100%);
        max-height: min(72vh, 520px);
        overflow: auto;
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 16px;
        box-shadow: var(--shadow);
        padding: 16px 18px 14px;
      }
      .midi-settings-dialog h2 {
        margin: 0 0 4px;
        font-size: 15px;
        font-weight: 700;
      }
      .midi-settings-dialog .midi-settings-lead {
        margin: 0 0 14px;
        font-size: 12px;
        color: var(--muted);
        line-height: 1.45;
      }
      .midi-settings-mode {
        margin-bottom: 12px;
      }
      .midi-settings-mode .control-label {
        font-size: 11px;
        color: var(--muted);
        margin-bottom: 6px;
      }
      .midi-input-list {
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 8px 10px;
        background: rgba(255, 255, 255, 0.65);
        margin-bottom: 10px;
        max-height: 220px;
        overflow-y: auto;
      }
      .midi-input-row {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        padding: 6px 0;
        border-bottom: 1px solid rgba(15, 23, 42, 0.06);
        font-size: 12px;
        line-height: 1.35;
      }
      .midi-input-row:last-child {
        border-bottom: none;
        padding-bottom: 0;
      }
      .midi-input-row input {
        margin-top: 2px;
        flex-shrink: 0;
      }
      .midi-input-row .midi-in-name {
        font-weight: 600;
        color: var(--ink);
        word-break: break-word;
      }
      .midi-input-row .midi-in-id {
        font-size: 10px;
        color: var(--muted);
        font-family: ui-monospace, monospace;
        margin-top: 2px;
      }
      .midi-settings-hint {
        font-size: 11px;
        color: var(--muted);
        margin: 0 0 12px;
        line-height: 1.4;
      }
      .midi-settings-hint.is-warn {
        color: #b45309;
      }
      .midi-settings-actions {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        margin-top: 4px;
      }
    </style>
  </head>
  <body>
    <div class="topbar">
      <h1>MIDI Key Monitor</h1>
      <div class="topbar-actions">
        <button class="btn icon-btn" id="addKeyboardBtn" type="button">
          <span class="material-symbols-rounded" aria-hidden="true">add</span>
          Add keyboard
        </button>
        <div class="control-row topbar-summary-toggle" style="flex: 0 0 auto; min-width: 0;">
          <div class="control-label">Sound</div>
          <div class="segmented" id="soundToggle">
            <button type="button" class="seg-btn is-active" data-mode="off">Off</button>
            <button type="button" class="seg-btn" data-mode="on">On</button>
          </div>
        </div>
        <div class="control-row topbar-summary-toggle topbar-midi-group" style="flex: 0 0 auto; min-width: 0;">
          <div class="control-label">Summary key</div>
          <div class="segmented" id="summaryToggle">
            <button type="button" class="seg-btn is-active" data-mode="off">Off</button>
            <button type="button" class="seg-btn" data-mode="on">On</button>
          </div>
        </div>
        <button type="button" class="btn icon-btn midi-settings-open" id="midiInputSettingsBtn" aria-label="MIDI入力の設定" title="MIDI入力の設定">
          <span class="material-symbols-rounded" aria-hidden="true">settings</span>
        </button>
      </div>
    </div>

    <div class="midi-settings-backdrop" id="midiSettingsBackdrop" aria-hidden="true">
      <div class="midi-settings-dialog" role="dialog" aria-modal="true" aria-labelledby="midiSettingsTitle" tabindex="-1">
        <h2 id="midiSettingsTitle">MIDI 入力</h2>
        <div class="midi-settings-mode">
          <div class="control-label">受信モード</div>
          <div class="segmented" id="midiFilterModeToggle">
            <button type="button" class="seg-btn is-active" data-mode="all">すべて</button>
            <button type="button" class="seg-btn" data-mode="selected">選択のみ</button>
          </div>
        </div>
        <p class="midi-settings-hint" id="midiSettingsHint"></p>
        <div class="midi-input-list" id="midiInputList"></div>
        <div class="midi-settings-actions">
          <button type="button" class="btn" id="midiSettingsCloseBtn">閉じる</button>
        </div>
      </div>
    </div>

    <div class="grid" id="keyboardGrid"></div>

    <div class="summary" id="globalSummary" style="display:none;">
      <div class="topbar-chord-guess" id="summaryChordGuess"></div>
      <div class="summary-row">
        <div class="summary-title">Pressed Keys Summary</div>
        <div class="summary-piano" id="globalSummaryPiano"></div>
      </div>
    </div>

    <script>
      // @ts-nocheck
      const NOTE_NAMES_FLAT = ["C","Db","D","Eb","E","F","Gb","G","Ab","A","Bb","B"];
      const NAME_TO_PC = Object.fromEntries(NOTE_NAMES_FLAT.map((n,i)=>[n,i]));
      const SCALE_TYPES = {
        major: { label: "Major", intervals: [0,2,4,5,7,9,11] },
        naturalMinor: { label: "Natural Minor", intervals: [0,2,3,5,7,8,10] },
        harmonicMinor: { label: "Harmonic Minor", intervals: [0,2,3,5,7,8,11] },
        melodicMinor: { label: "Melodic Minor", intervals: [0,2,3,5,7,9,11] }, // ascending
      };
      const NOTE_NAMES_SHARP = ["C","Cs","D","Ds","E","F","Fs","G","Gs","A","As","B"];
      function midiToNote(midi) {
        const octave = Math.floor(midi / 12) - 1;
        const pitch = NOTE_NAMES_SHARP[midi % 12];
        return pitch + String(octave);
      }
      function midiToPc(midi) { return ((midi % 12) + 12) % 12; }
      function clamp(v,min,max){ return Math.max(min, Math.min(max, v)); }

      function buildScalePcs(rootPc, scaleType) {
        const intervals = SCALE_TYPES[scaleType].intervals;
        const set = new Set(intervals.map((i)=> (rootPc + i) % 12));
        return { intervals, set };
      }
      function chordFromDegree(rootPc, scaleType, degreeIdx, add7) {
        const scale = SCALE_TYPES[scaleType].intervals.map((i)=> (rootPc + i) % 12);
        const r = scale[degreeIdx % 7];
        const t = scale[(degreeIdx + 2) % 7];
        const f = scale[(degreeIdx + 4) % 7];
        const s = add7 ? scale[(degreeIdx + 6) % 7] : null;
        const rel = (x) => (x - r + 12) % 12;
        const third = rel(t);
        const fifth = rel(f);
        const seventh = s == null ? null : rel(s);

        // Prefer named chord families when the pitch-set matches.
        // (e.g. 0,3,6 is "dim" regardless of how you *interpret* alterations)
        let triadQuality = "other";
        if (third === 3 && fifth === 6) triadQuality = "dim";       // 1,♭3,♭5
        else if (third === 4 && fifth === 7) triadQuality = "maj";  // 1,3,5
        else if (third === 3 && fifth === 7) triadQuality = "min";  // 1,♭3,5
        else if (third === 4 && fifth === 8) triadQuality = "aug";  // 1,3,♯5
        else if (third === 4 && fifth === 6) triadQuality = "flat5"; // 1,3,♭5

        let ext = "";
        if (!add7) {
          if (triadQuality === "min") ext = "m";
          else if (triadQuality === "dim") ext = "dim";
          else if (triadQuality === "aug") ext = "aug";
          else if (triadQuality === "flat5") ext = "♭5";
          else ext = "";
        } else {
          if (triadQuality === "maj") {
            if (seventh === 10) ext = "7";
            else if (seventh === 11) ext = "Δ7";
            else ext = "7";
          } else if (triadQuality === "min") {
            if (seventh === 10) ext = "m7";
            else if (seventh === 11) ext = "mΔ7";
            else ext = "m7";
          } else if (triadQuality === "dim") {
            // diminished triad + 7th:
            // 0,3,6,9  -> dim7 (full diminished)
            // 0,3,6,10 -> m7♭5 (half-diminished, avoid φ)
            if (seventh === 9) ext = "dim7";
            else if (seventh === 10) ext = "m7♭5";
            else if (seventh === 11) ext = "mΔ7♭5";
            else ext = "m7♭5";
          } else if (triadQuality === "aug") {
            // augmented triad + 7th: prefer named family (like dim/dim7)
            if (seventh === 11) ext = "augΔ7";
            else ext = "aug7";
          } else if (triadQuality === "flat5") {
            if (seventh === 11) ext = "Δ7♭5";
            else ext = "7♭5";
          } else {
            ext = "7";
          }
        }

        const pcs = new Set([r, t, f]);
        if (s != null) pcs.add(s);
        return { pcs, rootPc: r, triadQuality, seventh, ext };
      }

      function prettyFlatNoteName(name) {
        return String(name).replace(/b/g, "♭");
      }

      function japaneseChordReading(ext) {
        const map = {
          "": "メジャー",
          "m": "マイナー",
          "dim": "ディミニッシュ",
          "aug": "オーギュメント",
          "♭5": "フラットファイブ",
          "sus2": "サス・ツー（sus2）",
          "sus4": "サス・フォー（sus4）",
          "add9": "アド・ナイン（add9）",
          "7sus4": "セブンス・サス・フォー（7sus4）",
          "7": "セブンス",
          "Δ7": "メジャー・セブンス",
          "m7": "マイナー・セブンス",
          "mΔ7": "マイナー・メジャー・セブンス",
          "dim7": "ディミニッシュ・セブンス（フルディミニッシュ）",
          "m7♭5": "マイナー・セブンス・フラットファイブ（ハーフディミニッシュ）",
          "mΔ7♭5": "マイナー・メジャー・セブンス・フラットファイブ",
          "aug7": "オーギュメント・セブンス（7♯5）",
          "augΔ7": "オーギュメント・メジャー・セブンス（Δ7♯5）",
          "7♭5": "セブンス・フラットファイブ",
          "Δ7♭5": "メジャー・セブンス・フラットファイブ",
        };
        return map[ext] || "";
      }

      function updateChordReadout(state, chord) {
        const el = state._readoutEl;
        if (!el) return;
        if (!chord) {
          el.style.display = "none";
          el.innerHTML = "";
          return;
        }
        const rootNameRaw = NOTE_NAMES_FLAT[chord.rootPc] || NOTE_NAMES_SHARP[chord.rootPc] || "C";
        const rootName = prettyFlatNoteName(rootNameRaw);
        const symbol = rootName + chord.ext;
        const reading = japaneseChordReading(chord.ext);
        el.style.display = "block";
        el.innerHTML = reading ? `<strong>${symbol}</strong>　${rootName}${reading}` : `<strong>${symbol}</strong>`;
      }

      function pcToPrettyName(pc) {
        const raw = NOTE_NAMES_FLAT[pc] || NOTE_NAMES_SHARP[pc] || "C";
        return prettyFlatNoteName(raw);
      }

      function detectChordFromPressed(activeMidiSet) {
        const midis = Array.from(activeMidiSet).filter((m)=>Number.isFinite(m)).sort((a,b)=>a-b);
        if (midis.length === 0) return null;
        const pcs = new Set(midis.map(midiToPc));

        // If we don't have enough tones to name a chord, still show the pitch classes.
        if (pcs.size < 3) {
          const names = Array.from(pcs).sort((a,b)=>a-b).map(pcToPrettyName);
          return {
            rootPc: null,
            bassPc: null,
            ext: "",
            score: 0,
            symbol: names.join("–"),
            readingText: `構成音：${names.join(" ")}`,
          };
        }

        const CHORD_PATTERNS = {
          "0,4,7": { ext: "" },
          "0,3,7": { ext: "m" },
          "0,3,6": { ext: "dim" },
          "0,4,8": { ext: "aug" },

          "0,4,7,11": { ext: "Δ7" },
          "0,4,7,10": { ext: "7" },
          "0,3,7,10": { ext: "m7" },
          "0,3,7,11": { ext: "mΔ7" },
          "0,3,6,10": { ext: "m7♭5" },
          "0,3,6,9": { ext: "dim7" },
          "0,4,8,11": { ext: "augΔ7" },
          "0,4,8,10": { ext: "aug7" },

          "0,2,7": { ext: "sus2" },
          "0,5,7": { ext: "sus4" },
          "0,2,4,7": { ext: "add9" },
          "0,2,5,7": { ext: "7sus4" },
        };

        const pcsArr = Array.from(pcs);
        const mkKey = (rootPc) => {
          const rel = pcsArr.map((pc)=> (pc - rootPc + 12) % 12);
          rel.sort((a,b)=>a-b);
          // unique
          const uniq = [];
          for (const v of rel) if (uniq[uniq.length-1] !== v) uniq.push(v);
          // ensure root present
          if (uniq[0] !== 0) return null;
          return uniq.join(",");
        };

        const matches = [];
        for (let rootPc=0; rootPc<12; rootPc++) {
          const key = mkKey(rootPc);
          if (!key) continue;
          const pat = CHORD_PATTERNS[key];
          if (!pat) continue;
          matches.push({ rootPc, ext: pat.ext, size: key.split(",").length });
        }
        if (matches.length === 0) {
          const names = pcsArr.sort((a,b)=>a-b).map(pcToPrettyName);
          return { rootPc: null, bassPc: null, ext: "", score: 0, symbol: names.join("–"), readingText: `構成音：${names.join(" ")}` };
        }
        matches.sort((a,b)=> b.size - a.size);
        const best = matches[0];
        const rootName = pcToPrettyName(best.rootPc);
        const symbol = rootName + best.ext;
        const reading = japaneseChordReading(best.ext);
        const readingText = reading ? `${rootName}${reading}` : "";
        return { ...best, bassPc: null, score: best.size, symbol, readingText };
      }

      // Audio engine (based on existing piano sounds)
      const audio = { enabled: false, ctx: null, master: null, buffers: new Map(), loading: new Map(), active: new Map(), loopPoints: null, loopLoaded: false };
      function getAudioContext() {
        if (audio.ctx) return audio.ctx;
        const Ctor = window.AudioContext || window.webkitAudioContext;
        if (!Ctor) return null;
        audio.ctx = new Ctor({ latencyHint: "interactive" });
        audio.master = audio.ctx.createGain();
        audio.master.gain.value = 0.9;
        audio.master.connect(audio.ctx.destination);
        return audio.ctx;
      }
      async function ensureLoopPoints() {
        if (audio.loopLoaded) return;
        try {
          const res = await fetch("/sounds/piano/loop-points.json", { cache: "no-store" });
          audio.loopPoints = res.ok ? await res.json() : {};
        } catch { audio.loopPoints = {}; }
        audio.loopLoaded = true;
      }
      function resolveLoop(note, duration) {
        const defaults = (audio.loopPoints && audio.loopPoints._default) || {};
        const cfg = (audio.loopPoints && audio.loopPoints[note]) || {};
        const loopStart = clamp(cfg.loopStart ?? defaults.loopStart ?? 0.08, 0, Math.max(0, duration - 0.03));
        const reqEnd = cfg.loopEnd ?? defaults.loopEnd ?? (duration - (cfg.loopEndOffset ?? defaults.loopEndOffset ?? 0.02));
        const loopEnd = clamp(reqEnd, loopStart + 0.01, duration);
        const release = clamp(cfg.release ?? defaults.release ?? 0.05, 0.005, 0.3);
        const gain = clamp(cfg.gain ?? defaults.gain ?? 1, 0, 1);
        const rawCf = cfg.loopCrossfade ?? defaults.loopCrossfade ?? 0;
        const loopCrossfade = typeof rawCf === "number" && rawCf > 0 ? rawCf : 0;
        const useLoop =
          typeof cfg.useLoop === "boolean"
            ? cfg.useLoop
            : typeof defaults.useLoop === "boolean"
              ? defaults.useLoop
              : false;
        return { loopStart, loopEnd, release, gain, loopCrossfade, useLoop };
      }
      /** Manual sustain loop with crossfade at boundaries (loop=true has no crossfade). */
      function scheduleCrossfadeSustain(context, buffer, noteGain, tNow, Ls, Le, F, sourcesOut) {
        const L = Le - Ls;
        const maxF = Math.max(0, L / 2 - 0.008);
        const fade = Math.min(F, maxF);
        if (fade <= 0 || L - 2 * fade < 0.012) return false;
        const R = L - 2 * fade;
        const period = L - fade;
        const ITER = 220;
        const scheduleXf = (tx) => {
          const gTail = context.createGain();
          const gHead = context.createGain();
          gTail.gain.setValueAtTime(1, tx);
          gTail.gain.linearRampToValueAtTime(0, tx + fade);
          gHead.gain.setValueAtTime(0, tx);
          gHead.gain.linearRampToValueAtTime(1, tx + fade);
          const tail = context.createBufferSource();
          const head = context.createBufferSource();
          tail.buffer = buffer;
          head.buffer = buffer;
          tail.connect(gTail);
          head.connect(gHead);
          gTail.connect(noteGain);
          gHead.connect(noteGain);
          tail.start(tx, Le - fade);
          tail.stop(tx + fade);
          head.start(tx, Ls);
          head.stop(tx + fade);
          sourcesOut.push(tail, head);
        };
        const attackEnd = Ls > 0.001 ? tNow + Ls : tNow;
        if (Ls > 0.001) {
          const atk = context.createBufferSource();
          atk.buffer = buffer;
          atk.connect(noteGain);
          atk.start(tNow, 0);
          atk.stop(attackEnd);
          sourcesOut.push(atk);
        }
        let t = attackEnd;
        const m0 = context.createBufferSource();
        m0.buffer = buffer;
        m0.connect(noteGain);
        m0.start(t, Ls);
        m0.stop(t + L - fade);
        sourcesOut.push(m0);
        scheduleXf(t + L - fade);
        t += L;
        for (let k = 1; k < ITER; k++) {
          const mid = context.createBufferSource();
          mid.buffer = buffer;
          mid.connect(noteGain);
          mid.start(t, Ls + fade);
          mid.stop(t + R);
          sourcesOut.push(mid);
          scheduleXf(t + R);
          t += period;
        }
        return true;
      }
      async function loadBuffer(note) {
        const cached = audio.buffers.get(note);
        if (cached) return cached;
        const inflight = audio.loading.get(note);
        if (inflight) return inflight;
        const p = (async () => {
          const ctx = getAudioContext();
          if (!ctx) throw new Error("AudioContext unavailable");
          const res = await fetch("/sounds/piano/audio/" + note + ".mp3");
          if (!res.ok) throw new Error("missing audio " + note);
          const ab = await res.arrayBuffer();
          const buf = await ctx.decodeAudioData(ab.slice(0));
          audio.buffers.set(note, buf);
          return buf;
        })();
        audio.loading.set(note, p);
        try { return await p; } finally { audio.loading.delete(note); }
      }
      function stopVoice(note) {
        const v = audio.active.get(note);
        if (!v) return;
        const ctx = getAudioContext();
        if (!ctx) return;
        const now = ctx.currentTime;
        const cur = v.gain.gain.value;
        v.gain.gain.cancelScheduledValues(now);
        v.gain.gain.setValueAtTime(cur, now);
        v.gain.gain.linearRampToValueAtTime(0, now + v.release);
        const list = v.sources ?? (v.src ? [v.src] : []);
        for (const s of list) {
          try { s.stop(now + v.release + 0.02); } catch {}
        }
        audio.active.delete(note);
      }
      async function noteOn(note) {
        if (!audio.enabled) return;
        await ensureLoopPoints();
        const ctx = getAudioContext();
        if (!ctx) return;
        if (ctx.state === "suspended") await ctx.resume();
        const buf = await loadBuffer(note);
        stopVoice(note);
        const loop = resolveLoop(note, buf.duration);
        const gain = ctx.createGain();
        const now = ctx.currentTime;
        gain.gain.setValueAtTime(0, now);
        gain.gain.linearRampToValueAtTime(loop.gain, now + 0.004);
        gain.connect(audio.master || ctx.destination);
        const sources = [];
        if (!loop.useLoop) {
          const src = ctx.createBufferSource();
          src.buffer = buf;
          src.connect(gain);
          src.start(now, 0);
          src.onended = () => {
            if (audio.active.get(note)?.sources?.[0] === src) audio.active.delete(note);
          };
          sources.push(src);
        } else {
          const usedCf = scheduleCrossfadeSustain(
            ctx,
            buf,
            gain,
            now,
            loop.loopStart,
            loop.loopEnd,
            loop.loopCrossfade,
            sources,
          );
          if (!usedCf) {
            const src = ctx.createBufferSource();
            src.buffer = buf;
            src.loop = true;
            src.loopStart = loop.loopStart;
            src.loopEnd = loop.loopEnd;
            src.connect(gain);
            src.start(now, 0);
            src.onended = () => {
              if (audio.active.get(note)?.sources?.[0] === src) audio.active.delete(note);
            };
            sources.push(src);
          }
        }
        audio.active.set(note, { sources, gain, release: loop.release });
      }
      function noteOff(note) { if (!audio.enabled) return; stopVoice(note); }

      const activeMidi = new Set();
      let keyboardSeq = 0;
      const keyboards = [];

      function isPcPressed(pc) { for (const midi of activeMidi) if (midiToPc(midi) === pc) return true; return false; }

      function getDefaultKeyCount() {
        // Mobile-ish widths: keep UI compact by default.
        try {
          const w = window.innerWidth || 0;
          if (w > 0 && w <= 520) return 12;
        } catch {}
        return 24;
      }

      function createKeyboardState() {
        return {
          id: "kb_" + (++keyboardSeq),
          rootName: "C",
          scaleType: "major",
          selectedDegree: null,
          add7: true,
          showScaleDots: false,
          keyCount: getDefaultKeyCount(),
          startMidi: 48,
        };
      }
      function clampStartMidi(startMidi, keyCount) {
        const min = 12;
        const max = 108 - keyCount + 1;
        return clamp(startMidi, min, max);
      }
      function buildRootSelect(selected) {
        const sel = document.createElement("select");
        for (const n of NOTE_NAMES_FLAT) { const o = document.createElement("option"); o.value=n; o.textContent=n; if (n===selected) o.selected=true; sel.appendChild(o); }
        return sel;
      }
      function buildScaleTypeSelect(selected) {
        const sel = document.createElement("select");
        for (const [k,v] of Object.entries(SCALE_TYPES)) { const o=document.createElement("option"); o.value=k; o.textContent=v.label; if (k===selected) o.selected=true; sel.appendChild(o); }
        return sel;
      }
      function buildKeyCountSelect(selected) {
        const sel = document.createElement("select");
        const opts = [12, 24, 36, 49, 61, 76, 88];
        for (const n of opts) { const o=document.createElement("option"); o.value=String(n); o.textContent=String(n); if (n===selected) o.selected=true; sel.appendChild(o); }
        return sel;
      }

      function renderDegreeButtons(state, host) {
        host.innerHTML = "";
        const rootPc = NAME_TO_PC[state.rootName];
        const MAJOR_INTERVALS = SCALE_TYPES.major.intervals;
        const scaleIntervals = SCALE_TYPES[state.scaleType]?.intervals || MAJOR_INTERVALS;
        for (let d=0; d<7; d++) {
          const chord = chordFromDegree(rootPc, state.scaleType, d, state.add7);
          const roman = ["I","II","III","IV","V","VI","VII"][d];
          // Prefix accidentals by comparing degree pitch to major scale's degree pitch.
          // Works for future additions like harmonic/melodic minor.
          let diff = (scaleIntervals[d] ?? MAJOR_INTERVALS[d]) - MAJOR_INTERVALS[d];
          if (diff > 6) diff -= 12;
          if (diff < -6) diff += 12;
          const accidental = diff < 0 ? "♭".repeat(Math.abs(diff)) : diff > 0 ? "#".repeat(diff) : "";
          let label = accidental + roman + chord.ext;
          const btn = document.createElement("button");
          btn.type="button";
          btn.className = "deg-btn" + (state.selectedDegree===d ? " is-active" : "");
          btn.textContent = label;
          btn.addEventListener("click", () => { state.selectedDegree = (state.selectedDegree===d) ? null : d; updateKeyboardVisuals(state); });
          host.appendChild(btn);
        }
      }

      function renderSummary(summaryEl) {
        summaryEl.innerHTML = "";
        const w = 34;
        const whiteKeys = ["C","D","E","F","G","A","B"];
        const blackAt = { "Db": 1, "Eb": 2, "Gb": 4, "Ab": 5, "Bb": 6 };
        summaryEl.style.width = String(w*7) + "px";

        for (let i=0;i<whiteKeys.length;i++) {
          const name = whiteKeys[i];
          const pc = NAME_TO_PC[name];
          const el = document.createElement("div");
          el.className = "skey swhite";
          el.dataset.pc = String(pc);
          el.style.left = String(i*w) + "px";
          el.style.width = String(w) + "px";
          if (isPcPressed(pc)) el.classList.add("is-pressed");
          summaryEl.appendChild(el);
        }
        for (const [name, idx] of Object.entries(blackAt)) {
          const pc = NAME_TO_PC[name];
          const el = document.createElement("div");
          el.className = "skey sblack";
          el.dataset.pc = String(pc);
          el.style.width = String(w*0.6) + "px";
          el.style.left = String(idx*w - (w*0.6)/2) + "px";
          if (isPcPressed(pc)) el.classList.add("is-pressed");
          summaryEl.appendChild(el);
        }
      }

      const GRID_ONE_COL_TOTAL_KEYS = 48;

      function getTotalKeyboardKeys() {
        return keyboards.reduce((sum, k) => sum + (k.keyCount | 0), 0);
      }

      /** 合計鍵数が多いときはグリッドを1列にし、各鍵盤に横幅を譲る。全カードの鍵盤を再計測する */
      function syncKeyboardGridLayout() {
        const grid = document.getElementById("keyboardGrid");
        if (!grid) return;
        grid.classList.toggle("grid--one-col", getTotalKeyboardKeys() >= GRID_ONE_COL_TOTAL_KEYS);
        for (const kb of keyboards) {
          if (kb._pianoEl) renderKeyboardKeys(kb._pianoEl, kb);
        }
      }

      function renderKeyboardKeys(pianoEl, state) {
        pianoEl.innerHTML = "";
        state.startMidi = clampStartMidi(state.startMidi, state.keyCount);
        const notes = Array.from({ length: state.keyCount }, (_,i)=> state.startMidi + i);
        const whiteCount = notes.filter(m => !NOTE_NAMES_SHARP[m%12].includes("s")).length;
        const parentW = Math.max(280, (pianoEl.parentElement?.getBoundingClientRect().width || 420) - 24);
        const MIN_WHITE = 22;
        const MAX_WHITE = 44;
        const idealW = whiteCount * MIN_WHITE;
        const targetWidth = Math.min(1280, Math.max(360, parentW, idealW));
        const whiteW = clamp(targetWidth / whiteCount, MIN_WHITE, MAX_WHITE);
        const blackW = whiteW * 0.6;
        const blackHalf = blackW / 2;
        const gapAdjust = whiteW / 20;
        const whiteH = clamp(whiteW * 4.7, 78, 150);
        const blackH = whiteH * 0.58;
        // Use integer layout with cumulative positions to avoid 1px seams from rounding.
        const totalWhitePx = Math.round(whiteCount * whiteW);
        const baseWhitePx = Math.floor(totalWhitePx / whiteCount);
        const remainder = totalWhitePx - baseWhitePx * whiteCount; // distribute +1px to first N keys
        const whiteWidths = Array.from({ length: whiteCount }, (_, idx) => baseWhitePx + (idx < remainder ? 1 : 0));

        pianoEl.style.width = String(totalWhitePx) + "px";
        pianoEl.style.height = String(Math.round(whiteH)) + "px";

        let whiteIndex = 0;
        let whiteLeftPx = 0;
        for (const midi of notes) {
          const noteName = NOTE_NAMES_SHARP[midi%12];
          const isBlack = noteName.includes("s");
          const btn = document.createElement("button");
          btn.type="button";
          btn.className = "key " + (isBlack ? "black-key" : "white-key");
          btn.dataset.midi = String(midi);
          btn.dataset.pc = String(midiToPc(midi));
          const dot = document.createElement("span");
          dot.className = "key-dot";
          btn.appendChild(dot);
          btn.style.height = String(Math.round(isBlack ? blackH : whiteH)) + "px";
          btn.style.width = String(Math.round(isBlack ? blackW : whiteW)) + "px";
          if (isBlack) {
            // Place black key relative to the left edge of the next white slot.
            let left = whiteLeftPx - blackHalf;
            if (noteName==="Cs" || noteName==="Fs") left -= gapAdjust;
            if (noteName==="Ds" || noteName==="As") left += gapAdjust;
            btn.style.left = String(Math.round(left)) + "px";
          } else {
            const wpx = whiteWidths[whiteIndex] ?? baseWhitePx;
            btn.style.width = String(wpx) + "px";
            btn.style.left = String(whiteLeftPx) + "px";
            whiteLeftPx += wpx;
            whiteIndex++;
          }

          btn.addEventListener("pointerdown", (e) => {
            if (e.pointerType==="mouse" && e.button!==0) return;
            e.preventDefault();
            btn.setPointerCapture(e.pointerId);
            const m = Number(btn.dataset.midi);
            activeMidi.add(m);
            updateAllKeyboardsPressed();
            if (audio.enabled) void noteOn(midiToNote(m));
          });
          const release = (e) => {
            e.preventDefault();
            const m = Number(btn.dataset.midi);
            activeMidi.delete(m);
            updateAllKeyboardsPressed();
            if (audio.enabled) noteOff(midiToNote(m));
            try { btn.releasePointerCapture(e.pointerId); } catch {}
          };
          btn.addEventListener("pointerup", release);
          btn.addEventListener("pointercancel", release);
          btn.addEventListener("lostpointercapture", release);
          pianoEl.appendChild(btn);
        }
      }

      function updateKeyboardVisuals(state) {
        const rootPc = NAME_TO_PC[state.rootName];
        const scale = buildScalePcs(rootPc, state.scaleType);
        const chord = state.selectedDegree===null ? null : chordFromDegree(rootPc, state.scaleType, state.selectedDegree, state.add7);
        const chordPcs = chord ? chord.pcs : new Set();

        renderDegreeButtons(state, state._degEl);
        updateChordReadout(state, chord);
        state._pianoEl.querySelectorAll(".key").forEach((el) => {
          const pc = Number(el.dataset.pc);
          const isInScale = scale.set.has(pc);
          el.classList.toggle("in-scale", isInScale);
          el.classList.toggle("in-chord", chordPcs.has(pc));
          el.classList.toggle("is-tonic", pc === rootPc);
          el.classList.toggle("is-chord-root", !!chord && pc === chord.rootPc);

          const dot = el.querySelector(".key-dot");
          if (dot) {
            if (!state.showScaleDots) {
              dot.textContent = "";
              return;
            }
            if (!isInScale) {
              dot.textContent = "";
            } else {
              const rel = (pc - rootPc + 12) % 12;
              const degree = scale.intervals.indexOf(rel);
              dot.textContent = degree >= 0 ? String(degree + 1) : "";
            }
          }
        });
        updateAllKeyboardsPressed();
      }

      function updateAllKeyboardsPressed() {
        for (const kb of keyboards) {
          kb._pianoEl?.querySelectorAll(".key").forEach((el) => {
            const m = Number(el.dataset.midi);
            el.classList.toggle("is-pressed", activeMidi.has(m));
          });
        }
        if (window.__midiSummary?.enabled && window.__midiSummary.el) {
          renderSummary(window.__midiSummary.el);
          const guessEl = document.getElementById("summaryChordGuess");
          if (guessEl) {
            const chord = detectChordFromPressed(activeMidi);
            if (!chord) {
              guessEl.style.display = "none";
              guessEl.innerHTML = "";
            } else {
              guessEl.style.display = "block";
              guessEl.innerHTML = chord.readingText
                ? `<strong>${chord.symbol}</strong>　${chord.readingText}`
                : `<strong>${chord.symbol}</strong>`;
            }
          }
        } else {
          const guessEl = document.getElementById("summaryChordGuess");
          if (guessEl) { guessEl.style.display = "none"; guessEl.innerHTML = ""; }
        }
      }

      function mountKeyboard(state) {
        const grid = document.getElementById("keyboardGrid");
        const card = document.createElement("div");
        card.className = "card";

        const head = document.createElement("div");
        head.className = "card-head";

        const controls = document.createElement("div");
        controls.className = "controls";

        const rootSel = buildRootSelect(state.rootName);
        const scaleSel = buildScaleTypeSelect(state.scaleType);
        const countSel = buildKeyCountSelect(state.keyCount);

        const mkRow = (labelText, fieldEl) => {
          const row = document.createElement("div");
          row.className = "control-row";
          const lbl = document.createElement("div");
          lbl.className = "control-label";
          lbl.textContent = labelText;
          const field = document.createElement("div");
          field.className = "control-field";
          field.appendChild(fieldEl);
          row.appendChild(lbl);
          row.appendChild(field);
          controls.appendChild(row);
        };

        const startWrap = document.createElement("div");
        startWrap.className = "segmented";
        const startOctDown = document.createElement("button");
        startOctDown.type = "button";
        startOctDown.className = "seg-btn";
        startOctDown.textContent = "≪";
        const startStepDown = document.createElement("button");
        startStepDown.type = "button";
        startStepDown.className = "seg-btn";
        startStepDown.textContent = "‹";
        const startLabel = document.createElement("span");
        startLabel.style.display = "inline-flex";
        startLabel.style.alignItems = "center";
        startLabel.style.padding = "0 8px";
        startLabel.style.justifyContent = "center";
        startLabel.style.fontFamily =
          'system-ui, -apple-system, BlinkMacSystemFont, "SF Mono", ui-monospace, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace';
        startLabel.style.fontSize = "11px";
        startLabel.style.color = "var(--ink)";
        const startStepUp = document.createElement("button");
        startStepUp.type = "button";
        startStepUp.className = "seg-btn";
        startStepUp.textContent = "›";
        const startOctUp = document.createElement("button");
        startOctUp.type = "button";
        startOctUp.className = "seg-btn";
        startOctUp.textContent = "≫";
        const updateStartLabel = () => {
          const note = midiToNote(state.startMidi).replace("s", "#");
          startLabel.textContent = `${note}`;
        };
        updateStartLabel();
        startWrap.appendChild(startOctDown);
        startWrap.appendChild(startStepDown);
        startWrap.appendChild(startLabel);
        startWrap.appendChild(startStepUp);
        startWrap.appendChild(startOctUp);

        const dotsSeg = document.createElement("div");
        dotsSeg.className = "segmented";
        const dotsOffBtn = document.createElement("button");
        dotsOffBtn.type = "button";
        dotsOffBtn.className = "seg-btn";
        dotsOffBtn.textContent = "Off";
        const dotsOnBtn = document.createElement("button");
        dotsOnBtn.type = "button";
        dotsOnBtn.className = "seg-btn";
        dotsOnBtn.textContent = "On";
        dotsSeg.appendChild(dotsOffBtn);
        dotsSeg.appendChild(dotsOnBtn);
        const syncDots = () => {
          const on = Boolean(state.showScaleDots);
          dotsOnBtn.classList.toggle("is-active", on);
          dotsOffBtn.classList.toggle("is-active", !on);
          piano.classList.toggle("hide-scale-dots", !on);
          if (!on) {
            piano.querySelectorAll(".key-dot").forEach((d)=>{ d.textContent = ""; });
          }
        };
        dotsOffBtn.addEventListener("click", () => { state.showScaleDots = false; syncDots(); });
        dotsOnBtn.addEventListener("click", () => { state.showScaleDots = true; syncDots(); updateKeyboardVisuals(state); });

        // order
        mkRow("Keys", countSel);
        mkRow("Start", startWrap);
        mkRow("Tonic", rootSel);
        mkRow("Scale", scaleSel);
        mkRow("Scale dots", dotsSeg);

        const add7Seg = document.createElement("div");
        add7Seg.className = "segmented";
        const add7OffBtn = document.createElement("button");
        add7OffBtn.type = "button";
        add7OffBtn.className = "seg-btn";
        add7OffBtn.textContent = "off";
        add7OffBtn.setAttribute("aria-pressed", String(!state.add7));
        const add7OnBtn = document.createElement("button");
        add7OnBtn.type = "button";
        add7OnBtn.className = "seg-btn";
        add7OnBtn.textContent = "on";
        add7OnBtn.setAttribute("aria-pressed", String(!!state.add7));
        add7Seg.appendChild(add7OffBtn);
        add7Seg.appendChild(add7OnBtn);
        const syncAdd7Buttons = () => {
          const on = Boolean(state.add7);
          add7OnBtn.classList.toggle("is-active", on);
          add7OffBtn.classList.toggle("is-active", !on);
          add7OnBtn.setAttribute("aria-pressed", String(on));
          add7OffBtn.setAttribute("aria-pressed", String(!on));
        };
        syncAdd7Buttons();
        add7OffBtn.addEventListener("click", () => {
          if (!state.add7) return;
          state.add7 = false;
          syncAdd7Buttons();
          updateKeyboardVisuals(state);
        });
        add7OnBtn.addEventListener("click", () => {
          if (state.add7) return;
          state.add7 = true;
          syncAdd7Buttons();
          updateKeyboardVisuals(state);
        });
        mkRow("Add 7th", add7Seg);

        const removeBtn = document.createElement("button");
        removeBtn.type = "button";
        removeBtn.className = "remove-btn";
        removeBtn.setAttribute("aria-label", "Remove keyboard");
        removeBtn.title = "Remove";
        removeBtn.innerHTML = '<span class="material-symbols-rounded" aria-hidden="true">close</span>';

        head.appendChild(controls);
        head.appendChild(removeBtn);

        const degrees = document.createElement("div");
        degrees.className = "degrees";
        const readout = document.createElement("div");
        readout.className = "chord-readout";
        const degreesRow = document.createElement("div");
        degreesRow.className = "degrees-row";
        degreesRow.appendChild(degrees);
        degreesRow.appendChild(readout);

        const pianoWrap = document.createElement("div");
        pianoWrap.className = "piano-wrap";
        const piano = document.createElement("div");
        piano.className = "piano";
        pianoWrap.appendChild(piano);

        card.appendChild(head);
        card.appendChild(degreesRow);
        card.appendChild(pianoWrap);
        grid.appendChild(card);

        state._degEl = degrees;
        state._pianoEl = piano;
        state._readoutEl = readout;

        syncKeyboardGridLayout();
        for (const kb of keyboards) updateKeyboardVisuals(kb);
        // default OFF
        piano.classList.toggle("hide-scale-dots", !state.showScaleDots);
        // sync buttons after first render
        syncDots();

        const adjustStart = (delta) => {
          state.startMidi = clampStartMidi(state.startMidi + delta, state.keyCount);
          updateStartLabel();
          renderKeyboardKeys(piano, state);
          updateKeyboardVisuals(state);
        };

        rootSel.addEventListener("change", () => {
          state.rootName = rootSel.value;
          state.showScaleDots = true;
          syncDots();
          updateKeyboardVisuals(state);
        });
        scaleSel.addEventListener("change", () => {
          state.scaleType = scaleSel.value;
          state.selectedDegree = null;
          state.showScaleDots = true;
          syncDots();
          updateKeyboardVisuals(state);
        });
        countSel.addEventListener("change", () => {
          state.keyCount = Number(countSel.value);
          state.startMidi = clampStartMidi(state.startMidi, state.keyCount);
          syncKeyboardGridLayout();
          for (const kb of keyboards) updateKeyboardVisuals(kb);
        });
        startStepDown.addEventListener("click", () => adjustStart(-1));
        startStepUp.addEventListener("click", () => adjustStart(1));
        startOctDown.addEventListener("click", () => adjustStart(-12));
        startOctUp.addEventListener("click", () => adjustStart(12));

        removeBtn.addEventListener("click", () => {
          const idx = keyboards.findIndex((k)=>k.id===state.id);
          if (idx >= 0) keyboards.splice(idx, 1);
          card.remove();
          syncKeyboardGridLayout();
          for (const kb of keyboards) updateKeyboardVisuals(kb);
        });
      }

      const MIDI_INPUT_FILTER_KEY = "midiKeyMonitor.midiInputFilter";
      let midiAccessRef = null;
      const midiInputFilter = (function loadMidiInputFilter() {
        try {
          const raw = localStorage.getItem(MIDI_INPUT_FILTER_KEY);
          if (!raw) return { filterMode: "all", selectedIds: [] };
          const j = JSON.parse(raw);
          return {
            filterMode: j.filterMode === "selected" ? "selected" : "all",
            selectedIds: Array.isArray(j.selectedIds) ? j.selectedIds.filter((x) => typeof x === "string") : [],
          };
        } catch {
          return { filterMode: "all", selectedIds: [] };
        }
      })();

      function persistMidiInputFilter() {
        try {
          localStorage.setItem(
            MIDI_INPUT_FILTER_KEY,
            JSON.stringify({ filterMode: midiInputFilter.filterMode, selectedIds: midiInputFilter.selectedIds }),
          );
        } catch {}
      }

      function applyMidiInputBindings() {
        if (!midiAccessRef) return;
        const selectedSet = new Set(midiInputFilter.selectedIds);
        midiAccessRef.inputs.forEach((input) => {
          input.onmidimessage = null;
          if (midiInputFilter.filterMode === "all") {
            input.onmidimessage = onMIDIMessage;
          } else if (selectedSet.has(input.id)) {
            input.onmidimessage = onMIDIMessage;
          }
        });
      }

      function syncMidiFilterModeUI() {
        const toggle = document.getElementById("midiFilterModeToggle");
        if (!toggle) return;
        const allBtn = toggle.querySelector('button[data-mode="all"]');
        const selBtn = toggle.querySelector('button[data-mode="selected"]');
        const isAll = midiInputFilter.filterMode === "all";
        allBtn?.classList.toggle("is-active", isAll);
        selBtn?.classList.toggle("is-active", !isAll);
      }

      function renderMidiInputList() {
        const listEl = document.getElementById("midiInputList");
        const hintEl = document.getElementById("midiSettingsHint");
        if (!listEl) return;
        const selected = new Set(midiInputFilter.selectedIds);
        listEl.innerHTML = "";
        if (!midiAccessRef || midiAccessRef.inputs.size === 0) {
          const row = document.createElement("div");
          row.className = "midi-input-row";
          row.style.border = "none";
          row.textContent =
            "MIDI 入力が見つかりません。ケーブル・仮想ポートを確認し、ブラウザで MIDI デバイスへのアクセスを許可してください。";
          listEl.appendChild(row);
          if (hintEl) {
            hintEl.textContent = "";
            hintEl.classList.remove("is-warn");
          }
          return;
        }
        let checkedCount = 0;
        midiAccessRef.inputs.forEach((input) => {
          const row = document.createElement("label");
          row.className = "midi-input-row";
          row.style.opacity = midiInputFilter.filterMode === "all" ? "0.75" : "";
          const cb = document.createElement("input");
          cb.type = "checkbox";
          cb.checked = selected.has(input.id);
          cb.disabled = midiInputFilter.filterMode === "all";
          if (cb.checked) checkedCount++;
          cb.dataset.inputId = input.id;
          const wrap = document.createElement("div");
          const nameEl = document.createElement("div");
          nameEl.className = "midi-in-name";
          nameEl.textContent = input.name || "(名称なし)";
          const idEl = document.createElement("div");
          idEl.className = "midi-in-id";
          idEl.textContent = input.id;
          wrap.appendChild(nameEl);
          wrap.appendChild(idEl);
          row.appendChild(cb);
          row.appendChild(wrap);
          listEl.appendChild(row);
        });
        if (hintEl) {
          hintEl.classList.remove("is-warn");
          if (midiInputFilter.filterMode === "all") {
            hintEl.textContent =
              "「すべて」では、上記の入力ポートすべてからノートを受け取ります（Ableton 用の1本だけにしたいときは「選択のみ」へ）。";
          } else if (checkedCount === 0) {
            hintEl.textContent =
              "入力が1つも選ばれていません。このページでは MIDI を受信しません。使いたいポートにチェックを付けてください。";
            hintEl.classList.add("is-warn");
          } else {
            hintEl.textContent = "チェックを付けた入力だけがこのページに反映されます。設定はこのブラウザに保存されます。";
          }
        }
      }

      function openMidiSettings() {
        const bd = document.getElementById("midiSettingsBackdrop");
        if (!bd) return;
        syncMidiFilterModeUI();
        renderMidiInputList();
        bd.classList.add("is-open");
        bd.setAttribute("aria-hidden", "false");
        document.getElementById("midiSettingsCloseBtn")?.focus();
      }

      function closeMidiSettings() {
        const bd = document.getElementById("midiSettingsBackdrop");
        if (!bd) return;
        bd.classList.remove("is-open");
        bd.setAttribute("aria-hidden", "true");
        document.getElementById("midiInputSettingsBtn")?.focus();
      }

      function wireMidiInputSettingsUI() {
        document.getElementById("midiInputSettingsBtn")?.addEventListener("click", () => openMidiSettings());
        document.getElementById("midiSettingsCloseBtn")?.addEventListener("click", () => closeMidiSettings());
        const backdrop = document.getElementById("midiSettingsBackdrop");
        const dialog = backdrop?.querySelector(".midi-settings-dialog");
        dialog?.addEventListener("click", (e) => e.stopPropagation());
        backdrop?.addEventListener("click", (e) => {
          if (e.target === backdrop) closeMidiSettings();
        });
        const modeToggle = document.getElementById("midiFilterModeToggle");
        modeToggle?.querySelector('button[data-mode="all"]')?.addEventListener("click", () => {
          midiInputFilter.filterMode = "all";
          persistMidiInputFilter();
          syncMidiFilterModeUI();
          renderMidiInputList();
          applyMidiInputBindings();
        });
        modeToggle?.querySelector('button[data-mode="selected"]')?.addEventListener("click", () => {
          midiInputFilter.filterMode = "selected";
          persistMidiInputFilter();
          syncMidiFilterModeUI();
          renderMidiInputList();
          applyMidiInputBindings();
        });
        document.getElementById("midiInputList")?.addEventListener("change", (e) => {
          const t = e.target;
          if (!(t instanceof HTMLInputElement) || t.type !== "checkbox" || t.disabled) return;
          const id = t.dataset.inputId;
          if (!id) return;
          const set = new Set(midiInputFilter.selectedIds);
          if (t.checked) set.add(id);
          else set.delete(id);
          midiInputFilter.selectedIds = Array.from(set);
          persistMidiInputFilter();
          applyMidiInputBindings();
          renderMidiInputList();
        });
        document.addEventListener("keydown", (e) => {
          if (e.key !== "Escape") return;
          const bd = document.getElementById("midiSettingsBackdrop");
          if (bd?.classList.contains("is-open")) closeMidiSettings();
        });
      }

      async function initMIDI() {
        if (!navigator.requestMIDIAccess) return;
        try {
          const access = await navigator.requestMIDIAccess();
          midiAccessRef = access;
          const onChange = () => {
            applyMidiInputBindings();
            const bd = document.getElementById("midiSettingsBackdrop");
            if (bd?.classList.contains("is-open")) renderMidiInputList();
          };
          applyMidiInputBindings();
          access.onstatechange = onChange;
        } catch (e) {
          console.log("Failed to access MIDI devices.", e);
        }
      }
      function onMIDIMessage(message) {
        const data = message.data || [];
        const status = data[0] ?? 0;
        const note = data[1] ?? 0;
        const velocity = data[2] ?? 0;
        const isNoteOn = (status & 0xf0) === 0x90;
        const isNoteOff = (status & 0xf0) === 0x80 || (isNoteOn && velocity === 0);
        if (isNoteOn) { activeMidi.add(note); updateAllKeyboardsPressed(); if (audio.enabled) void noteOn(midiToNote(note)); }
        else if (isNoteOff) { activeMidi.delete(note); updateAllKeyboardsPressed(); if (audio.enabled) noteOff(midiToNote(note)); }
      }

      document.getElementById("addKeyboardBtn").addEventListener("click", () => {
        const st = createKeyboardState();
        keyboards.push(st);
        mountKeyboard(st);
      });
      // Global summary wiring
      window.__midiSummary = {
        enabled: false,
        root: document.getElementById("globalSummary"),
        el: document.getElementById("globalSummaryPiano"),
      };
      const summaryToggle = document.getElementById("summaryToggle");
      if (summaryToggle && window.__midiSummary.root && window.__midiSummary.el) {
        const offBtn = summaryToggle.querySelector('button[data-mode="off"]');
        const onBtn = summaryToggle.querySelector('button[data-mode="on"]');
        const sync = () => {
          const on = window.__midiSummary.enabled;
          if (onBtn && offBtn) {
            onBtn.classList.toggle("is-active", on);
            offBtn.classList.toggle("is-active", !on);
          }
          window.__midiSummary.root.style.display = on ? "" : "none";
          if (on) renderSummary(window.__midiSummary.el);
        };
        offBtn?.addEventListener("click", () => {
          window.__midiSummary.enabled = false;
          sync();
        });
        onBtn?.addEventListener("click", () => {
          window.__midiSummary.enabled = true;
          sync();
        });
        sync();
      }
      const soundToggle = document.getElementById("soundToggle");
      if (soundToggle) {
        const offBtn = soundToggle.querySelector('button[data-mode="off"]');
        const onBtn = soundToggle.querySelector('button[data-mode="on"]');
        const syncSound = () => {
          const on = Boolean(audio.enabled);
          onBtn?.classList.toggle("is-active", on);
          offBtn?.classList.toggle("is-active", !on);
          if (!on) for (const note of Array.from(audio.active.keys())) stopVoice(note);
        };
        offBtn?.addEventListener("click", () => { audio.enabled = false; syncSound(); });
        onBtn?.addEventListener("click", () => { audio.enabled = true; syncSound(); });
        syncSound();
      }

      wireMidiInputSettingsUI();

      const initial = createKeyboardState();
      keyboards.push(initial);
      mountKeyboard(initial);
      initMIDI();
      window.addEventListener("resize", () => {
        for (const kb of keyboards) { renderKeyboardKeys(kb._pianoEl, kb); updateKeyboardVisuals(kb); }
      });
    </script>
  </body>
</html>

