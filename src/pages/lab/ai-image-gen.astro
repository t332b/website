---
const baseUrl = import.meta.env.BASE_URL;
---
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>AI Image Generator — Lab</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/x-icon" href={`${baseUrl}images/favicon.ico`} />
    <style>
      :root { color-scheme: dark; }
      *, *::before, *::after { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; min-height: 100vh; }
      body {
        font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        background: #020617;
        color: #e5e7eb;
        padding: 32px 20px 60px;
        display: flex;
        justify-content: center;
      }
      .wrap { width: 100%; max-width: 640px; }
      a.back {
        color: #9ca3af;
        text-decoration: none;
        font-size: 0.85rem;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        margin-bottom: 24px;
      }
      a.back:hover { color: #e5e7eb; }
      h1 { font-size: 1.4rem; font-weight: 600; margin: 0 0 6px; }
      .desc { color: #9ca3af; font-size: 0.875rem; margin: 0 0 28px; line-height: 1.65; }

      .field { margin-bottom: 16px; }
      .label { display: block; font-size: 0.82rem; color: #9ca3af; margin-bottom: 5px; }

      .input, .textarea {
        width: 100%;
        background: #0f172a;
        border: 1px solid #1e293b;
        color: #e5e7eb;
        border-radius: 8px;
        padding: 10px 14px;
        font-size: 0.9rem;
        font-family: inherit;
        outline: none;
        transition: border-color 0.15s;
      }
      .input:focus, .textarea:focus { border-color: #3b82f6; }
      .textarea { resize: vertical; }

      .btn-gen {
        width: 100%;
        padding: 12px;
        background: #3b82f6;
        color: #fff;
        border: none;
        border-radius: 8px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        font-family: inherit;
        transition: background 0.15s;
      }
      .btn-gen:hover:not(:disabled) { background: #2563eb; }
      .btn-gen:disabled { background: #1e3a5f; color: #64748b; cursor: not-allowed; }

      .status {
        margin-top: 20px;
        padding: 12px 16px;
        background: #0f172a;
        border-radius: 8px;
        border: 1px solid #1e293b;
        font-size: 0.9rem;
        color: #9ca3af;
      }
      .status.error { border-color: #ef4444; color: #fca5a5; }

      .result { margin-top: 24px; }

      .preview-img {
        width: 100%;
        border-radius: 10px;
        display: block;
        border: 1px solid #1e293b;
        aspect-ratio: 16/9;
        object-fit: cover;
      }

      .id-section { margin-top: 18px; }

      .id-box {
        display: flex;
        gap: 8px;
        align-items: stretch;
        margin-top: 6px;
      }

      .id-display {
        flex: 1;
        background: #0f172a;
        border: 1px solid #1e293b;
        border-radius: 8px;
        padding: 10px 14px;
        font-family: 'SF Mono', 'Fira Code', 'Consolas', monospace;
        font-size: 0.82rem;
        color: #86efac;
        overflow-x: auto;
        white-space: nowrap;
        min-width: 0;
      }

      .btn-copy {
        padding: 10px 16px;
        background: #1e293b;
        color: #e5e7eb;
        border: 1px solid #334155;
        border-radius: 8px;
        font-size: 0.85rem;
        cursor: pointer;
        font-family: inherit;
        white-space: nowrap;
        transition: background 0.15s;
        flex-shrink: 0;
      }
      .btn-copy:hover { background: #334155; }
      .btn-copy.copied { background: #166534; color: #86efac; border-color: #166534; }

      .hint {
        margin-top: 10px;
        font-size: 0.8rem;
        color: #64748b;
        line-height: 1.55;
      }

      .btn-regen {
        margin-top: 14px;
        width: 100%;
        padding: 10px;
        background: transparent;
        color: #9ca3af;
        border: 1px solid #1e293b;
        border-radius: 8px;
        font-size: 0.9rem;
        cursor: pointer;
        font-family: inherit;
        transition: border-color 0.15s, color 0.15s;
      }
      .btn-regen:hover:not(:disabled) { border-color: #3b82f6; color: #e5e7eb; }
      .btn-regen:disabled { opacity: 0.4; cursor: not-allowed; }

      @media (max-width: 640px) {
        body { padding: 24px 14px 40px; }
        h1 { font-size: 1.2rem; }
      }
    </style>
  </head>
  <body>
    <div class="wrap">
      <a class="back" href={`${baseUrl}lab/`}>← Lab</a>
      <h1>AI Image Generator</h1>
      <p class="desc">
        タイトルと本文からノート用ヘッダー画像をAI生成し、Cloudinaryに保存します。<br>
        生成後はCMSの「ヘッダー画像」フィールドでCloudinaryを開き、保存された画像を選択してください。
      </p>

      <div class="field">
        <label class="label" for="title-input">タイトル *</label>
        <input type="text" id="title-input" class="input" placeholder="記事のタイトルを入力..." />
      </div>

      <div class="field">
        <label class="label" for="body-input">本文（任意・最初の200字を参照）</label>
        <textarea id="body-input" class="textarea" rows="4" placeholder="本文を貼り付け（空でもタイトルだけで生成できます）..."></textarea>
      </div>

      <button type="button" id="gen-btn" class="btn-gen">✨ AIで生成</button>

      <div id="status-el" class="status" style="display:none;"></div>

      <div id="result-el" style="display:none;" class="result">
        <img id="preview-img" class="preview-img" alt="生成されたヘッダー画像" />
        <div class="id-section">
          <span class="label">Cloudinaryに保存されたファイル名</span>
          <div class="id-box">
            <code id="id-display" class="id-display"></code>
            <button type="button" id="copy-btn" class="btn-copy">コピー</button>
          </div>
          <p class="hint">CMSの「ヘッダー画像」→ Cloudinary を開く → このファイルを探して選択してください。</p>
        </div>
        <button type="button" id="regen-btn" class="btn-regen">🔄 再生成</button>
      </div>
    </div>

    <script>
      const CLOUD_NAME = 'djzxpyzu3';
      const UPLOAD_PRESET = 'pr0p0se';
      // フォルダ指定なし（Cloudinary root にアップロード）
      // output_filename_only: true との一貫性のため

      function stripMarkdown(text) {
        return (text || '')
          .replace(/!\[[^\]]*\]\([^)]*\)/g, '')
          .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
          .replace(/#{1,6}\s*/g, '')
          .replace(/[*_~`>]/g, '')
          .replace(/\n+/g, ' ')
          .replace(/\s+/g, ' ')
          .trim();
      }

      function buildPrompt(title, body) {
        const cleanBody = stripMarkdown(body).slice(0, 200);
        const text = [title, cleanBody].filter(Boolean).join('. ');
        return 'cinematic wide header image, ' + text + ', artistic, high quality, 16:9';
      }

      async function fetchImageAsBlob(url) {
        const res = await fetch(url);
        if (!res.ok) throw new Error('画像取得失敗: ' + res.status);
        return res.blob();
      }

      async function uploadToCloudinary(blob) {
        const fd = new FormData();
        fd.append('file', blob);
        fd.append('upload_preset', UPLOAD_PRESET);
        // フォルダ指定なし → root にアップロード
        const res = await fetch(`https://api.cloudinary.com/v1_1/${CLOUD_NAME}/image/upload`, {
          method: 'POST',
          body: fd,
        });
        const data = await res.json();
        if (!res.ok) throw new Error((data.error && data.error.message) || 'アップロード失敗');
        // public_id はルートの場合ファイル名のみ（例: "abc123xyz"）
        return { publicId: data.public_id, secureUrl: data.secure_url };
      }

      const titleInput = document.getElementById('title-input');
      const bodyInput = document.getElementById('body-input');
      const genBtn = document.getElementById('gen-btn');
      const regenBtn = document.getElementById('regen-btn');
      const statusEl = document.getElementById('status-el');
      const resultEl = document.getElementById('result-el');
      const previewImg = document.getElementById('preview-img');
      const idDisplay = document.getElementById('id-display');
      const copyBtn = document.getElementById('copy-btn');

      // URL パラメータからタイトル・本文を自動入力
      (function() {
        const params = new URLSearchParams(location.search);
        const t = params.get('title');
        const b = params.get('body');
        if (t) titleInput.value = t;
        if (b) bodyInput.value = b;
      })();

      function setStatus(msg, isError = false) {
        statusEl.style.display = 'block';
        statusEl.textContent = msg;
        statusEl.className = 'status' + (isError ? ' error' : '');
      }

      function hideStatus() {
        statusEl.style.display = 'none';
      }

      function setBusy(busy) {
        genBtn.disabled = busy;
        regenBtn.disabled = busy;
      }

      async function generate() {
        const title = titleInput.value.trim();
        if (!title) {
          setStatus('タイトルを入力してください。', true);
          return;
        }

        const body = bodyInput.value.trim();
        const prompt = buildPrompt(title, body);

        setBusy(true);
        resultEl.style.display = 'none';

        try {
          setStatus('⏳ AI生成中… 30〜60秒かかることがあります');

          const pollinationsUrl =
            'https://image.pollinations.ai/prompt/' +
            encodeURIComponent(prompt) +
            '?width=1280&height=720&nologo=true&seed=' + Date.now();

          const blob = await fetchImageAsBlob(pollinationsUrl);

          setStatus('⏳ Cloudinaryに保存中…');
          const { publicId, secureUrl } = await uploadToCloudinary(blob);

          hideStatus();

          previewImg.src = secureUrl;
          // public_id がフォルダなしの場合もあるので、ファイル名部分だけ表示
          const filename = publicId.includes('/') ? publicId.split('/').pop() : publicId;
          idDisplay.textContent = filename;
          copyBtn.textContent = 'コピー';
          copyBtn.className = 'btn-copy';
          resultEl.style.display = 'block';
          resultEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

        } catch (err) {
          setStatus('エラー: ' + err.message, true);
        } finally {
          setBusy(false);
        }
      }

      genBtn.addEventListener('click', generate);
      regenBtn.addEventListener('click', generate);

      titleInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') generate();
      });

      copyBtn.addEventListener('click', () => {
        const text = idDisplay.textContent;
        navigator.clipboard.writeText(text).then(() => {
          copyBtn.textContent = 'コピーした！';
          copyBtn.className = 'btn-copy copied';
          setTimeout(() => {
            copyBtn.textContent = 'コピー';
            copyBtn.className = 'btn-copy';
          }, 2000);
        });
      });
    </script>
  </body>
</html>
