---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const search = Astro.url.search || "";
const hash = Astro.url.hash || "";
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Rhythm Grid</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/x-icon" href={`${base}/images/favicon.ico`} />
  </head>
  <body style="margin:0;padding:0;background:#f7f7f8;">
    <iframe
      src={`${base}/tools/rhythm-grid/${search}${hash}`}
      style="border:none;border-radius:0;width:100%;height:100vh;overflow:hidden;"
      loading="lazy"
    ></iframe>
  </body>
</html>

