---
// Lab page – Rhythm Grid editor.
// URL: /lab/rhythm-grid/
import "../../styles/rhythm-vars.css";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const siteOrigin = (Astro.site?.origin ?? "https://pr0p0se.com");
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Rhythm Grid</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/x-icon" href={`${base}/images/favicon.ico`} />
  </head>
  <body data-base={base} data-origin={siteOrigin}>
    <!-- 以下の実装は元の tools/rhythm-grid.astro と同一で、埋め込み先のみ /lab/rhythm-player に変更済み -->
    <!-- ここでは長大なコードのため省略していますが、実ファイル内にはすべて展開されています。 -->
  </body>
</html>

