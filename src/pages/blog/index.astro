---
import Base from "../../layouts/Base.astro";
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a,b) => b.data.date.getTime() - a.data.date.getTime()); // 新しい順

// メンバー情報を取得
const members = await getCollection('member');
const memberMap = new Map(members.map(m => [m.data.id, m.data]));

// アバター画像のURLを生成する関数
function getAvatarUrl(member: any) {
  if (member?.avatar) {
    return member.avatar.startsWith('/') ? member.avatar : `/${member.avatar}`;
  }
  if (member?.github) {
    return `https://github.com/${member.github}.png?size=64`;
  }
  return '/images/uploads/default-avatar.png'; // デフォルトアバター
}
---

<Base title="PR0P0SE Blog">
  <!-- 絞り込みUI -->
  <div class="filters-wrapper">
    <!-- 著者ボタン（常時表示） -->
    <div class="author-buttons">
      <button class="author-btn active" data-author="ALL">ALL</button>
      {members.map(member => (
        <button class="author-btn" data-author={member.data.id}>{member.data.name}</button>
      ))}
    </div>
    
    <!-- 詳細フィルターボタン -->
    <div class="detail-filter-container">
      <button id="detailToggle" class="detail-toggle">
        <span>🔍 詳細</span>
      </button>
      
      <!-- ポップオーバー -->
      <div id="detailPopover" class="detail-popover" style="display: none;">
        <div class="filter-section">
          <label class="filter-label">期間</label>
          <div class="date-filters">
            <input type="date" id="fromDate" class="date-input" />
            <span class="date-separator">〜</span>
            <input type="date" id="toDate" class="date-input" />
            <button id="clearDates" class="clear-btn">クリア</button>
          </div>
        </div>
        
        <div class="filter-section">
          <label class="filter-label">キーワード</label>
          <div class="keyword-filter">
            <input type="text" id="q" class="keyword-input" placeholder="タイトル・タグで検索..." />
            <button id="clearQ" class="clear-btn">クリア</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 一覧 -->
  <div id="list" style="display:grid; gap:16px;">
    {posts.map(p => {
      const d = p.data.date.toISOString().slice(0,10); // YYYY-MM-DD
      const tags = (p.data.tags ?? []).join(',');
      const member = memberMap.get(p.data.author);
      const avatarUrl = getAvatarUrl(member);
      
      // 本文からプレビューテキストを生成（マークダウン記法を除去）
      const cleanBody = p.body
        .replace(/#+\s+/g, '') // 見出し記号を削除
        .replace(/\*\*(.+?)\*\*/g, '$1') // 太字を削除
        .replace(/\*(.+?)\*/g, '$1') // イタリックを削除
        .replace(/\[(.+?)\]\(.+?\)/g, '$1') // リンクをテキストのみに
        .replace(/`(.+?)`/g, '$1') // コードを削除
        .replace(/\n+/g, ' ') // 改行をスペースに
        .trim();
      const preview = cleanBody.length > 50 ? cleanBody.substring(0, 50) + '...' : cleanBody;
      
      return (
        <article class="item blog-card"
            data-author={p.data.author}
            data-date={d}
            data-title={p.data.title.toLowerCase()}
            data-tags={tags.toLowerCase()}
            data-slug={p.slug}>
          
          <!-- レイアウト: アイコン + コンテンツ -->
          <div class="card-layout">
            <!-- アイコン -->
            <img src={avatarUrl} alt="" 
                 class="author-avatar"
                 data-author-filter={p.data.author} />
            
            <!-- 右側コンテンツ -->
            <div class="card-content">
              <!-- 名前と日付 -->
              <div class="card-header">
                <span class="author-name author-clickable" data-author-filter={p.data.author}>
                  {member?.name || p.data.author}
                </span>
                <span class="post-date">{d}</span>
              </div>
              
              <!-- タイトル -->
              <div class="card-title">{p.data.title}</div>
              
              <!-- プレビューテキスト -->
              <div class="card-preview">{preview}</div>
              
              <!-- タグ -->
              {p.data.tags && p.data.tags.length > 0 && (
                <div class="card-tags">
                  {p.data.tags.map((tag: string) => (
                    <span class="tag">#{tag}</span>
                  ))}
                </div>
              )}
            </div>
          </div>
        </article>
      )
    })}
  </div>

  <script>
    // シンプルなバニラJS絞り込み
    const list = document.getElementById('list');
    if (!list) {
      console.error('List element not found');
    } else {
      const items = Array.from(list.querySelectorAll('.item'));

      const detailToggle = document.getElementById('detailToggle');
      const detailPopover = document.getElementById('detailPopover');
      
      const authorBtns = document.querySelectorAll('.author-btn');
      const fromInput = document.getElementById('fromDate') as HTMLInputElement;
      const toInput = document.getElementById('toDate') as HTMLInputElement;
      const clearDates = document.getElementById('clearDates');
      const q = document.getElementById('q') as HTMLInputElement;
      const clearQ = document.getElementById('clearQ');

      let author = 'ALL';

      // ポップオーバーの開閉
      detailToggle?.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = detailPopover!.style.display !== 'none';
        detailPopover!.style.display = isOpen ? 'none' : 'block';
      });

      // ポップオーバー外をクリックしたら閉じる
      document.addEventListener('click', (e) => {
        if (detailPopover && detailPopover.style.display !== 'none') {
          const target = e.target as HTMLElement;
          if (!detailPopover.contains(target) && target !== detailToggle) {
            detailPopover.style.display = 'none';
          }
        }
      });

      // ポップオーバー内のクリックは伝播させない
      detailPopover?.addEventListener('click', (e) => {
        e.stopPropagation();
      });

      // 著者フィルタリング関数
      function filterByAuthor(authorId: string) {
        author = authorId;
        // 対応するボタンをアクティブに
        authorBtns.forEach(btn => {
          const btnAuthor = (btn as HTMLElement).dataset.author;
          if (btnAuthor === authorId) {
            (btn as HTMLElement).classList.add('active');
          } else {
            (btn as HTMLElement).classList.remove('active');
          }
        });
        applyFilters();
      }

      authorBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          filterByAuthor((btn as HTMLElement).dataset.author || 'ALL');
        });
      });

      // 記事カード全体のクリック → 記事詳細に移動
      items.forEach(item => {
        (item as HTMLElement).addEventListener('click', (e) => {
          const target = e.target as HTMLElement;
          // アバターがクリックされた場合は記事詳細に遷移しない
          if (target.classList.contains('author-avatar')) {
            return;
          }
          const slug = (item as HTMLElement).dataset.slug;
          if (slug) {
            window.location.href = `/blog/${slug}/`;
          }
        });
      });

      // アバター画像とユーザー名のクリック → 著者フィルタリング
      const authorClickables = document.querySelectorAll('.author-avatar, .author-clickable');
      authorClickables.forEach(element => {
        (element as HTMLElement).addEventListener('click', (e) => {
          e.stopPropagation(); // カード全体のクリックイベントを止める
          const authorId = (element as HTMLElement).dataset.authorFilter;
          if (authorId) {
            filterByAuthor(authorId);
          }
        });
      });

      fromInput.addEventListener('change', applyFilters);
      toInput.addEventListener('change', applyFilters);
      clearDates?.addEventListener('click', () => {
        fromInput.value = '';
        toInput.value = '';
        applyFilters();
      });

      q.addEventListener('input', applyFilters);
      clearQ?.addEventListener('click', () => {
        q.value = '';
        applyFilters();
      });

      function applyFilters() {
        const from = fromInput.value ? new Date(fromInput.value) : null;
        const to = toInput.value ? new Date(toInput.value) : null;
        const query = q.value.trim().toLowerCase();

        items.forEach(el => {
          const a = (el as HTMLElement).dataset.author;
          const d = new Date((el as HTMLElement).dataset.date || '');
          const text = ((el as HTMLElement).dataset.title + ' ' + (el as HTMLElement).dataset.tags).toLowerCase();

          let ok = true;

          if (author !== 'ALL' && a !== author) ok = false;
          if (from && d < from) ok = false;
          if (to && d > to) ok = false;
          if (query && !text.includes(query)) ok = false;

          (el as HTMLElement).style.display = ok ? '' : 'none';
        });
      }

      // 初期フィルター適用
      applyFilters();
    }
  </script>

  <style>
    /* 絞り込みUIラッパー */
    .filters-wrapper {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 1rem;
      flex-wrap: wrap;
    }

    /* 著者ボタン */
    .author-buttons {
      display: flex;
      gap: 0.375rem;
      flex-wrap: wrap;
    }

    .author-btn {
      appearance: none;
      border: 1.5px solid var(--wa-butter);
      background: white;
      color: var(--fg);
      padding: 0.375rem 0.875rem;
      border-radius: 999px;
      font-weight: 600;
      font-size: 0.875rem;
      cursor: pointer;
      transition: all 0.2s ease;
      font-family: inherit;
    }

    .author-btn:hover {
      background: var(--wa-cream);
      border-color: var(--accent);
    }

    .author-btn.active {
      background: var(--accent);
      color: white;
      border-color: var(--accent);
    }

    /* 詳細フィルターコンテナ */
    .detail-filter-container {
      position: relative;
    }

    /* 詳細ボタン */
    .detail-toggle {
      appearance: none;
      border: 1.5px solid var(--wa-butter);
      background: white;
      color: var(--fg);
      padding: 0.375rem 0.875rem;
      border-radius: 999px;
      font-weight: 600;
      font-size: 0.875rem;
      cursor: pointer;
      transition: all 0.2s ease;
      font-family: inherit;
      white-space: nowrap;
    }

    .detail-toggle:hover {
      background: var(--wa-cream);
      border-color: var(--accent);
    }

    /* ポップオーバー */
    .detail-popover {
      position: absolute;
      top: calc(100% + 0.5rem);
      left: 0;
      min-width: 320px;
      max-width: 400px;
      background: var(--card);
      border: 2px solid var(--wa-butter);
      border-radius: 12px;
      padding: 1rem;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
      z-index: 100;
    }

    /* 画面からはみ出さないように */
    @media (max-width: 400px) {
      .detail-popover {
        min-width: 280px;
      }
    }

    .filter-section {
      margin-bottom: 0.875rem;
    }

    .filter-section:last-child {
      margin-bottom: 0;
    }

    .filter-label {
      display: block;
      font-size: 0.75rem;
      font-weight: 700;
      color: var(--muted);
      margin-bottom: 0.5rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    /* 日付フィルター */
    .date-filters {
      display: flex;
      gap: 0.375rem;
      align-items: center;
      flex-wrap: wrap;
    }

    .date-input {
      border: 1.5px solid var(--wa-butter);
      background: white;
      padding: 0.25rem 0.5rem;
      border-radius: 6px;
      font-size: 0.8rem;
      font-family: inherit;
      color: var(--fg);
      transition: all 0.2s ease;
    }

    .date-input:focus {
      outline: none;
      border-color: var(--accent);
      box-shadow: 0 0 0 2px var(--ring);
    }

    .date-separator {
      color: var(--muted);
      font-size: 0.8rem;
    }

    /* キーワード検索 */
    .keyword-filter {
      display: flex;
      gap: 0.375rem;
      align-items: center;
    }

    .keyword-input {
      flex: 1;
      border: 1.5px solid var(--wa-butter);
      background: white;
      padding: 0.25rem 0.75rem;
      border-radius: 6px;
      font-size: 0.8rem;
      font-family: inherit;
      color: var(--fg);
      transition: all 0.2s ease;
    }

    .keyword-input:focus {
      outline: none;
      border-color: var(--accent);
      box-shadow: 0 0 0 2px var(--ring);
    }

    .keyword-input::placeholder {
      color: var(--muted);
    }

    /* クリアボタン */
    .clear-btn {
      appearance: none;
      border: 1.5px solid var(--wa-butter);
      background: white;
      color: var(--muted);
      padding: 0.25rem 0.75rem;
      border-radius: 6px;
      font-weight: 600;
      font-size: 0.75rem;
      cursor: pointer;
      transition: all 0.2s ease;
      font-family: inherit;
      white-space: nowrap;
    }

    .clear-btn:hover {
      background: var(--wa-cream);
      border-color: var(--accent-2);
      color: var(--accent-2);
    }

    /* 記事カード */
    .blog-card {
      background: white;
      border: 2px solid var(--wa-butter);
      border-radius: 12px;
      padding: 1rem;
      transition: all 0.2s ease;
      cursor: pointer;
    }

    .blog-card:hover {
      transform: translateY(-2px);
      border-color: var(--accent);
      box-shadow: 0 4px 12px rgba(45, 122, 120, 0.1);
    }

    .card-layout {
      display: flex;
      gap: 0.75rem;
    }

    .author-avatar {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      border: 2px solid var(--wa-cream);
      flex-shrink: 0;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .author-avatar:hover {
      border-color: var(--accent);
      transform: scale(1.05);
    }

    .card-content {
      flex: 1;
      min-width: 0;
    }

    .card-header {
      display: flex;
      align-items: baseline;
      gap: 0.5rem;
      margin-bottom: 0.25rem;
    }

    .author-name {
      font-weight: 600;
      font-size: 0.9rem;
      color: var(--fg);
    }

    .author-clickable {
      text-decoration: underline;
      cursor: pointer;
      transition: color 0.2s ease;
    }

    .author-clickable:hover {
      color: var(--accent);
      text-decoration: underline;
    }

    .post-date {
      font-size: 0.8rem;
      color: var(--muted);
    }

    .card-title {
      font-weight: 600;
      font-size: 0.9rem;
      color: var(--fg);
      margin-bottom: 0.5rem;
      line-height: 1.3;
    }

    .card-preview {
      font-size: 0.875rem;
      color: var(--muted);
      margin-bottom: 0.5rem;
      line-height: 1.5;
    }

    .card-tags {
      display: flex;
      gap: 0.375rem;
      flex-wrap: wrap;
    }

    .card-tags .tag {
      background: var(--wa-cream);
      color: var(--accent);
      padding: 0.125rem 0.5rem;
      border-radius: 12px;
      font-size: 0.75rem;
      border: 1px solid var(--wa-butter);
    }
    
    /* レスポンシブ */
    @media (max-width: 768px) {
      .filters-wrapper {
        flex-direction: column;
        align-items: stretch;
        gap: 0.5rem;
      }

      .author-buttons {
        justify-content: center;
      }

      .detail-filter-container {
        width: 100%;
      }

      .detail-toggle {
        width: 100%;
        justify-content: center;
      }

      .detail-popover {
        left: 0.5rem;
        right: 0.5rem;
        min-width: auto;
        max-width: none;
      }

      .date-filters,
      .keyword-filter {
        flex-wrap: wrap;
      }

      .date-input,
      .keyword-input,
      .clear-btn {
        font-size: 0.75rem;
      }
      
      .blog-card {
        padding: 0.75rem;
      }

      .card-layout {
        gap: 0.5rem;
      }

      .author-avatar {
        width: 40px;
        height: 40px;
      }

      .author-name,
      .card-title {
        font-size: 0.85rem;
      }

      .post-date {
        font-size: 0.75rem;
      }

      .card-preview {
        font-size: 0.8rem;
      }
    }
  </style>
</Base>
