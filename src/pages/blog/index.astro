---
import Base from "../../layouts/Base.astro";
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a,b) => b.data.date.getTime() - a.data.date.getTime()); // 新しい順

// メンバー情報を取得
const members = await getCollection('member');
const memberMap = new Map(members.map(m => [m.data.id, m.data]));

// アバター画像のURLを生成する関数
function getAvatarUrl(member: any) {
  if (member?.avatar) {
    return member.avatar.startsWith('/') ? member.avatar : `/${member.avatar}`;
  }
  if (member?.github) {
    return `https://github.com/${member.github}.png?size=64`;
  }
  return '/images/uploads/default-avatar.png'; // デフォルトアバター
}
---

<Base title="ブログ">
  <h1 style="font-size:1.5rem; font-weight:700; margin-bottom:1rem;">ブログ</h1>

  <!-- 絞り込みUI -->
  <div id="filters" style="display:flex; gap:.5rem; flex-wrap:wrap; margin-bottom:1rem;">
    <div>
      <button class="author-btn" data-author="ALL">ALL</button>
      {members.map(member => (
        <button class="author-btn" data-author={member.data.id}>{member.data.name}</button>
      ))}
    </div>
    <div style="display:flex; gap:.5rem; align-items:center;">
      <label>From: <input type="date" id="fromDate"></label>
      <label>To: <input type="date" id="toDate"></label>
      <button id="clearDates">日付クリア</button>
    </div>
    <div style="display:flex; gap:.5rem; align-items:center;">
      <input type="text" id="q" placeholder="キーワード（タイトル/タグ）" />
      <button id="clearQ">クリア</button>
    </div>
  </div>

  <!-- 一覧（ツイッター風レイアウト） -->
  <div id="list" style="display:grid; gap:16px;">
    {posts.map(p => {
      const d = p.data.date.toISOString().slice(0,10); // YYYY-MM-DD
      const tags = (p.data.tags ?? []).join(',');
      const member = memberMap.get(p.data.author);
      const avatarUrl = getAvatarUrl(member);
      
      return (
        <article class="item tweet-card"
            data-author={p.data.author}
            data-date={d}
            data-title={p.data.title.toLowerCase()}
            data-tags={tags.toLowerCase()}
            style="background: white; border: 1px solid #e1e8ed; border-radius: 16px; padding: 20px; transition: all 0.2s ease; hover:border-color: #1da1f2; hover:box-shadow: 0 4px 12px rgba(29, 161, 242, 0.1);">
          
          <!-- ヘッダー（メンバー情報） -->
          <div style="display: flex; align-items: center; margin-bottom: 16px;">
            <img src={avatarUrl} alt="" width="48" height="48" 
                 style="border-radius: 50%; border: 2px solid #e1e8ed; margin-right: 12px;" />
            <div style="flex: 1;">
              <div style="font-weight: 600; color: #14171a; margin-bottom: 2px;">
                {member?.name || p.data.author}
              </div>
              <div style="font-size: 0.9rem; color: #657786;">
                {d}
              </div>
            </div>
          </div>
          
          <!-- 本文 -->
          <div style="margin-bottom: 16px;">
            <h3 style="margin: 0 0 8px 0; font-size: 1.1rem; line-height: 1.4;">
              <a href={`/blog/${p.slug}/`} 
                 style="color: #14171a; text-decoration: none; font-weight: 600; hover:color: #1da1f2;">
                {p.data.title}
              </a>
            </h3>
            {p.data.tags && p.data.tags.length > 0 && (
              <div style="font-size: 0.85rem; color: #1da1f2; margin-top: 8px;">
                {p.data.tags.map((tag: string) => (
                  <span style="background: #e8f5fd; padding: 4px 8px; border-radius: 12px; margin-right: 6px;">
                    #{tag}
                  </span>
                ))}
              </div>
            )}
          </div>
        </article>
      )
    })}
  </div>

  <script>
    // シンプルなバニラJS絞り込み
    const list = document.getElementById('list');
    if (!list) {
      console.error('List element not found');
    } else {
      const items = Array.from(list.querySelectorAll('.item'));

      const authorBtns = document.querySelectorAll('.author-btn');
      const fromInput = document.getElementById('fromDate') as HTMLInputElement;
      const toInput = document.getElementById('toDate') as HTMLInputElement;
      const clearDates = document.getElementById('clearDates');
      const q = document.getElementById('q') as HTMLInputElement;
      const clearQ = document.getElementById('clearQ');

      let author = 'ALL';

      authorBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          author = (btn as HTMLElement).dataset.author || 'ALL';
          authorBtns.forEach(b => (b as HTMLElement).style.fontWeight = (b===btn? '700':'400'));
          applyFilters();
        });
      });

      fromInput.addEventListener('change', applyFilters);
      toInput.addEventListener('change', applyFilters);
      clearDates?.addEventListener('click', () => {
        fromInput.value = '';
        toInput.value = '';
        applyFilters();
      });

      q.addEventListener('input', applyFilters);
      clearQ?.addEventListener('click', () => {
        q.value = '';
        applyFilters();
      });

      function applyFilters() {
        const from = fromInput.value ? new Date(fromInput.value) : null;
        const to = toInput.value ? new Date(toInput.value) : null;
        const query = q.value.trim().toLowerCase();

        items.forEach(el => {
          const a = (el as HTMLElement).dataset.author;
          const d = new Date((el as HTMLElement).dataset.date || '');
          const text = ((el as HTMLElement).dataset.title + ' ' + (el as HTMLElement).dataset.tags).toLowerCase();

          let ok = true;

          if (author !== 'ALL' && a !== author) ok = false;
          if (from && d < from) ok = false;
          if (to && d > to) ok = false;
          if (query && !text.includes(query)) ok = false;

          (el as HTMLElement).style.display = ok ? '' : 'none';
        });
      }

      // 初期選択
      if (authorBtns[0]) {
        (authorBtns[0] as HTMLElement).style.fontWeight = '700'; // ALL
      }
      applyFilters();
    }
  </script>

  <style>
    .tweet-card:hover {
      transform: translateY(-2px);
    }
    
    @media (max-width: 768px) {
      .tweet-card {
        padding: 16px;
        margin: 0 8px;
      }
      
      #filters {
        flex-direction: column;
        align-items: stretch;
      }
      
      #filters > div {
        justify-content: center;
      }
    }
  </style>
</Base>
