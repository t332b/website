---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

const liveEvents = (await getCollection("live")).sort((a, b) => {
  const da = a.data.date?.getTime() ?? Number.MAX_SAFE_INTEGER;
  const db = b.data.date?.getTime() ?? Number.MAX_SAFE_INTEGER;
  return da - db;
});

const withContent = await Promise.all(
  liveEvents.map(async (entry) => ({
    entry,
    Content: (await entry.render()).Content,
  }))
);
---

<Base title="PR0P0SE LIVE">
  <div class="live-page">
    {withContent.length > 0 ? (
      <section class="live-list">
        {withContent.map(({ entry, Content }) => (
          <article class="live-card">
            <header class="live-header">
              <h2 class="live-title">{entry.data.title}</h2>
              {entry.data.date && (
                <time class="live-date" datetime={entry.data.date.toISOString().slice(0, 10)}>
                  {entry.data.date.toLocaleDateString("ja-JP", {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  })}
                </time>
              )}
            </header>

            {entry.data.flyer && (
              <div class="live-flyer-wrap">
                <img
                  src={entry.data.flyer.startsWith("http") ? entry.data.flyer : entry.data.flyer}
                  alt={`${entry.data.title} フライヤー`}
                  class="live-flyer"
                  width="800"
                  height="auto"
                  loading="lazy"
                />
              </div>
            )}

            <div class="live-details">
              {(entry.data.venue || entry.data.city) && (
                <p class="live-venue">
                  {[entry.data.venue, entry.data.city].filter(Boolean).join(" / ")}
                </p>
              )}
              {(entry.data.start || entry.data.end) && (
                <p class="live-time">
                  {entry.data.start && <span>開始 {entry.data.start}</span>}
                  {entry.data.start && entry.data.end && " "}
                  {entry.data.end && <span>終了 {entry.data.end}</span>}
                </p>
              )}
              {entry.data.ticketUrl && (
                <a
                  href={entry.data.ticketUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="live-ticket-btn"
                >
                  チケット
                </a>
              )}
              <div class="live-body content">
                <Content />
              </div>
            </div>
          </article>
        ))}
      </section>
    ) : (
      <div class="live-empty">
        <p>現在、ライブの予定はありません。</p>
      </div>
    )}
  </div>

  <style>
    .live-page {
      max-width: 1000px;
      margin: 0 auto;
      padding: 2rem 1rem;
    }
    .live-list {
      display: flex;
      flex-direction: column;
      gap: 2.5rem;
    }
    .live-card {
      background: var(--card, #fff9f1);
      border: 2px solid var(--wa-butter);
      border-radius: 12px;
      padding: 1.5rem;
      box-shadow: var(--shadow);
    }
    .live-header {
      margin-bottom: 1rem;
    }
    .live-title {
      font-size: 1.4rem;
      font-weight: 600;
      margin: 0 0 0.35rem 0;
      color: var(--fg, var(--wa-ink));
    }
    .live-date {
      font-size: 1rem;
      color: var(--muted, #7c6f69);
    }
    .live-flyer-wrap {
      margin: 1rem 0;
      border-radius: 8px;
      overflow: hidden;
    }
    .live-flyer {
      width: 100%;
      max-width: 600px;
      height: auto;
      display: block;
    }
    .live-details {
      font-size: 0.95rem;
      color: var(--fg);
    }
    .live-venue {
      margin: 0 0 0.5rem 0;
    }
    .live-time {
      margin: 0 0 0.75rem 0;
      color: var(--muted, #7c6f69);
    }
    .live-ticket-btn {
      display: inline-block;
      background: var(--accent);
      color: white;
      padding: 0.6rem 1.2rem;
      border-radius: 8px;
      text-decoration: none;
      font-weight: 600;
      margin-bottom: 1rem;
      transition: opacity 0.2s;
    }
    .live-ticket-btn:hover {
      opacity: 0.9;
    }
    .live-body.content {
      margin-top: 0.75rem;
      font-size: 0.9rem;
      line-height: 1.7;
    }
    .live-body.content :global(p) {
      margin: 0 0 0.5rem 0;
    }
    .live-empty {
      text-align: center;
      padding: 3rem 1rem;
      color: var(--muted, #7c6f69);
    }
    .live-empty p {
      margin: 0 0 0.5rem 0;
    }
    @media (max-width: 768px) {
      .live-page {
        padding: 1rem 0.75rem;
      }
      .live-card {
        padding: 1rem;
      }
      .live-title {
        font-size: 1.2rem;
      }
    }
  </style>
</Base>
