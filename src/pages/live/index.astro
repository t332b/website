---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

function formatDateWithWeekday(d: Date): string {
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, "0");
  const day = String(d.getDate()).padStart(2, "0");
  const w = ["日", "月", "火", "水", "木", "金", "土"][d.getDay()];
  return `${y}/${m}/${day}（${w}）`;
}

let collectionError: string | null = null;
let liveEvents: Awaited<ReturnType<typeof getCollection<"live">>> = [];

try {
  liveEvents = (await getCollection("live")).sort((a, b) => {
    const da = a.data.startDate?.getTime() ?? 0;
    const db = b.data.startDate?.getTime() ?? 0;
    return db - da; // 降順（新しい日付が先）
  });
} catch (_e) {
  collectionError = "表示エラーがあります（syntax error 等、コンテンツを確認してください）";
}

// ファイル数と取得件数が一致しない場合（一部がスキーマ等で除外された場合）もバナー表示
if (!collectionError) {
  const liveFileGlob = import.meta.glob<{ default: unknown }>("../../content/live/*.{md,mdx}");
  const fileCount = Object.keys(liveFileGlob).length;
  if (fileCount > liveEvents.length) {
    collectionError = "一部のコンテンツを表示できません（syntax error 等、コンテンツを確認してください）";
  }
}

const withContent = await Promise.all(
  liveEvents.map(async (entry) => {
    try {
      const { Content } = await entry.render();
      return { entry, Content, renderError: false as const };
    } catch (_e) {
      return { entry, Content: null, renderError: true as const };
    }
  })
);
---

<Base title="PR0P0SE LIVE">
  <div class="live-page">
    {collectionError && (
      <div class="content-error-banner" role="alert">
        {collectionError}
      </div>
    )}
    {withContent.length > 0 ? (
      <section class="live-list">
        {withContent.map(({ entry, Content, renderError }) => (
          <article class="live-card">
            {renderError ? (
              <div class="live-card-error-wrap">
                {entry.data.title && <h2 class="live-title">{entry.data.title}</h2>}
                <p class="live-card-error">
                  表示エラーがあります（syntax error 等、この項目のコンテンツを確認してください）
                </p>
              </div>
            ) : (
            <>
            <header class="live-header">
              <h2 class="live-title">{entry.data.title}</h2>
              {entry.data.startDate && (
                <time class="live-date" datetime={entry.data.startDate.toISOString().slice(0, 10)}>
                  {formatDateWithWeekday(entry.data.startDate)}
                </time>
              )}
            </header>

            <div class="live-details">
              {/* フライヤー（URLが文字列で渡るよう明示的に取得） */}
              {"flyer" in entry.data && (entry.data as { flyer?: string }).flyer && (
                <div class="live-flyer-wrap">
                  <img
                    src={(entry.data as { flyer: string }).flyer}
                    alt={`${entry.data.title} フライヤー`}
                    class="live-flyer"
                    width="400"
                    height="auto"
                    loading="lazy"
                    decoding="async"
                    referrerpolicy="no-referrer"
                  />
                </div>
              )}
              {/* 会場・日時など */}
              {(entry.data.venue || entry.data.city) && (
                <p class="live-venue">
                  {[entry.data.venue, entry.data.city].filter(Boolean).join(" / ")}
                </p>
              )}
              {(entry.data.startDate || entry.data.startTime || entry.data.endDate || entry.data.endTime) && (
                <p class="live-time">
                  {(entry.data.startDate || entry.data.startTime) && (
                    <span>
                      開始 {entry.data.startDate && formatDateWithWeekday(entry.data.startDate)}
                      {entry.data.startDate && entry.data.startTime && " "}
                      {entry.data.startTime && entry.data.startTime}
                    </span>
                  )}
                  {(entry.data.startDate || entry.data.startTime) && (entry.data.endDate || entry.data.endTime) && " / "}
                  {(entry.data.endDate || entry.data.endTime) && (
                    <span>
                      終了 {entry.data.endDate && formatDateWithWeekday(entry.data.endDate)}
                      {entry.data.endDate && entry.data.endTime && " "}
                      {entry.data.endTime && entry.data.endTime}
                    </span>
                  )}
                </p>
              )}
              {entry.data.ticketUrl && (
                <a
                  href={entry.data.ticketUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="live-ticket-btn"
                >
                  チケット
                </a>
              )}
              <div class="live-body content">
                <Content />
              </div>
            </div>
            </>
            )}
          </article>
        ))}
      </section>
    ) : (
      <div class="live-empty">
        <p>現在、ライブの予定はありません。</p>
      </div>
    )}
  </div>

  <style>
    .live-page {
      max-width: 1000px;
      margin: 0 auto;
      padding: 2rem 1rem;
    }
    .live-list {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem;
    }
    .live-card {
      background: var(--card, #fff9f1);
      border: 2px solid var(--wa-butter);
      border-radius: 12px;
      padding: 1.5rem;
      box-shadow: var(--shadow);
    }
    .live-header {
      margin-bottom: 1rem;
    }
    .live-title {
      font-size: 0.95rem;
      font-weight: 600;
      line-height: 1.3;
      margin: 0 0 0.25rem 0;
      color: var(--fg, var(--wa-ink));
    }
    .live-date {
      font-size: 0.9rem;
      color: var(--muted, #7c6f69);
    }
    .live-flyer-wrap {
      margin: 0.75rem 0;
      border-radius: 8px;
      overflow: hidden;
    }
    .live-flyer {
      width: 100%;
      max-width: 280px;
      max-height: 200px;
      height: auto;
      object-fit: contain;
      display: block;
    }
    .live-details {
      font-size: 0.85rem;
      color: var(--fg);
    }
    .live-details > .live-flyer-wrap {
      margin-bottom: 0.75rem;
    }
    .live-venue {
      margin: 0 0 0.35rem 0;
    }
    .live-time {
      margin: 0 0 0.5rem 0;
      font-size: 0.8rem;
      color: var(--muted, #7c6f69);
    }
    .live-ticket-btn {
      display: inline-block;
      font-size: 0.875rem;
      color: var(--accent, #009cb8);
      text-decoration: underline;
      text-underline-offset: 0.2em;
      margin-bottom: 1rem;
      transition: opacity 0.2s;
    }
    .live-ticket-btn:hover {
      opacity: 0.8;
    }
    .live-body.content {
      margin-top: 0.5rem;
      font-size: 0.8rem;
      line-height: 1.6;
    }
    .live-body.content :global(p) {
      margin: 0 0 0.5rem 0;
    }
    .live-empty {
      text-align: center;
      padding: 3rem 1rem;
      color: var(--muted, #7c6f69);
    }
    .content-error-banner {
      background: #f8d7da;
      color: #721c24;
      border: 1px solid #f5c6cb;
      border-radius: 8px;
      padding: 1rem;
      margin-bottom: 1.5rem;
      font-size: 0.95rem;
    }
    .live-card-error-wrap {
      padding: 0.25rem 0;
    }
    .live-card-error-wrap .live-title {
      margin-bottom: 0.5rem;
    }
    .live-card-error {
      color: #721c24;
      font-size: 0.9rem;
      margin: 0;
    }
    .live-empty p {
      margin: 0 0 0.5rem 0;
    }
    @media (max-width: 768px) {
      .live-page {
        padding: 1rem 0.75rem;
      }
      .live-list {
        grid-template-columns: 1fr;
      }
      .live-card {
        padding: 1rem;
      }
      .live-title {
        font-size: 1.2rem;
      }
      .live-flyer {
        max-width: 240px;
        max-height: 180px;
      }
    }
  </style>
</Base>
