---
// Embeddable read-only rhythm player.
// Pattern data is loaded from the URL hash.
// URL: /tools/rhythm-player/#<base64url-encoded-json>
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Rhythm Player</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body data-base={base}>
    <div class="rp" id="rp">
      <div class="rp-bar">
        <button class="rp-play" id="playBtn" aria-label="再生">▶</button>
        <span class="rp-title" id="rpTitle"></span>
        <div class="rp-right">
          <label class="rp-bpm">
            BPM <input type="number" id="bpmInput" min="40" max="300" step="1" value="120" />
          </label>
          <a class="rp-edit" id="editLink" target="_blank" title="エディタで開く">✎</a>
        </div>
      </div>
      <div class="rp-grid-area" id="rpGrid"></div>
    </div>

    <style is:global>
      *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
      html,body{height:100%;overflow:hidden}
      body{
        font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;
        background:#f7f7f8;
        color:#333;
      }

      .rp{display:flex;flex-direction:column;height:100%;padding:8px 10px;max-width:760px;margin:0 auto}
      .rp-bar{display:flex;align-items:center;gap:8px;margin-bottom:6px;min-height:32px}
      .rp-play{width:30px;height:30px;border-radius:50%;border:2px solid #333;background:#fff;color:#333;font-size:.9rem;cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0;line-height:1;transition:background .15s,color .15s}
      .rp-play:hover{background:#333;color:#fff}
      .rp-play.playing{background:#e53935;border-color:#e53935;color:#fff}
      .rp-title{font-size:.8rem;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0}
      .rp-right{margin-left:auto;display:flex;align-items:center;gap:8px;flex-shrink:0}
      .rp-bpm{font-size:.7rem;color:#888;display:flex;align-items:center;gap:3px;font-weight:600}
      .rp-bpm input{width:48px;border:1px solid #ddd;border-radius:4px;padding:2px 4px;font-size:.75rem;text-align:center;color:#333}
      .rp-bpm input:focus{outline:none;border-color:#888}
      .rp-edit{font-size:.85rem;color:#aaa;text-decoration:none;line-height:1}
      .rp-edit:hover{color:#333}

      .rp-grid-area{flex:1;overflow-x:auto}

      :root{--cell-h:22px;--lw:52px;--bar-h:16px;--beat-h:14px}

      .chunk-wrap{display:flex;margin-bottom:6px}
      .chunk-side{display:flex;flex-direction:column;flex-shrink:0;padding-right:4px}
      .side-spacer{height:calc(var(--bar-h) + var(--beat-h) + 4px)}
      .side-row{height:var(--cell-h);display:flex;align-items:center}
      .side-label{width:var(--lw);min-width:0;overflow:hidden;font-size:.58rem;color:#555}
      .side-label span{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;padding:0 2px}

      .chunk{border:2px solid #888;border-radius:6px;flex:1;min-width:0;overflow:hidden;background:#fff}
      .chunk-hdr{background:#f9f9f9;border-bottom:1px solid #bbb}
      .hdr-cells{display:grid;min-width:0}
      .hdr-cells.bar-hdr{border-bottom:1px solid #ddd}
      .bar-lbl{height:var(--bar-h);display:flex;align-items:center;justify-content:center;font-size:.54rem;font-weight:700;color:#666}
      .bar-lbl.bar-sep{box-shadow:inset 2px 0 0 0 #888}
      .beat-lbl{height:var(--beat-h);display:flex;align-items:center;justify-content:center;font-size:.5rem;font-weight:600;color:#777}
      .beat-lbl.bar-sep{box-shadow:inset 2px 0 0 0 #888}
      .beat-lbl.beat-sep{box-shadow:inset 1px 0 0 0 #ddd}

      .chunk-body{}
      .chunk-cells{display:grid;min-width:0}
      .cell{height:var(--cell-h);background:#fff}
      .cell.active{background:#5c6bc0}
      .cell.bar-sep{box-shadow:inset 2px 0 0 0 #999}
      .cell.beat-sep{box-shadow:inset 1px 0 0 0 #ddd}
      .chunk-cells>.cell{border-right:1px solid #ddd;border-bottom:1px solid #ddd}
      .chunk-cells>.cell:last-child{border-right:none}
      .chunk-body>.chunk-cells:last-child .cell{border-bottom:none}
      .cell.playhead{background:#fff3e0}
      .cell.active.playhead{background:#ef6c00}

      @media(max-width:400px){
        :root{--cell-h:20px;--lw:42px;--bar-h:14px;--beat-h:12px}
        .bar-lbl{font-size:.48rem}
        .beat-lbl{font-size:.44rem}
        .side-label{font-size:.52rem}
      }
    </style>

    <script>
      const SUBS_PER_BEAT = 4;
      const SOUND_FILES = ["kick","snare","hihat","conga"] as const;
      const DEFAULT_SOUND = "conga";
      const BASE = document.body.dataset.base || "";

      interface Row { label: string; cells: boolean[] }
      interface Pattern { title: string; bpm: number; numBars: number; beatsPerBar: number; rows: Row[] }

      function hexToCells(hex: string): boolean[] {
        const cells: boolean[] = [];
        for (const ch of hex) { const n = parseInt(ch, 16); cells.push(!!(n & 8), !!(n & 4), !!(n & 2), !!(n & 1)); }
        return cells;
      }
      function fromBase64Url(b64: string): string {
        let s = b64.replace(/-/g, "+").replace(/_/g, "/");
        while (s.length % 4) s += "=";
        const binary = atob(s);
        return new TextDecoder().decode(new Uint8Array([...binary].map(ch => ch.charCodeAt(0))));
      }
      function esc(s: string) {
        return s.replace(/&/g, "&amp;").replace(/"/g, "&quot;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
      }

      function loadPattern(): Pattern | null {
        try {
          const hash = window.location.hash.slice(1);
          if (!hash) return null;
          const d = JSON.parse(fromBase64Url(hash));
          if (!d.r || !d.n) return null;
          return {
            title: d.t || "", bpm: (d.b >= 40 && d.b <= 300) ? d.b : 120,
            beatsPerBar: (d.bp && d.bp >= 1 && d.bp <= 12) ? d.bp : 4,
            numBars: d.n,
            rows: d.r.map((r: { l: string; c: string }) => ({ label: r.l, cells: hexToCells(r.c) })),
          };
        } catch { return null; }
      }

      function calcBarsPerLine(): number {
        return window.innerWidth < 370 ? 1 : 2;
      }

      const pattern = loadPattern();
      if (!pattern) { document.getElementById("rp")!.innerHTML = '<p style="padding:1rem;color:#999;font-size:.8rem;">パターンデータがありません</p>'; }

      if (pattern) {
        const rpGrid = document.getElementById("rpGrid")!;
        const playBtn = document.getElementById("playBtn")!;
        const bpmInput = document.getElementById("bpmInput") as HTMLInputElement;
        const editLink = document.getElementById("editLink") as HTMLAnchorElement;
        const rpTitle = document.getElementById("rpTitle")!;

        let bpm = pattern.bpm;
        rpTitle.textContent = pattern.title;
        bpmInput.value = String(bpm);
        editLink.href = `${BASE}/tools/rhythm-grid/#${window.location.hash.slice(1)}`;

        bpmInput.addEventListener("change", () => {
          bpm = Math.max(40, Math.min(300, Number(bpmInput.value) || 120));
          bpmInput.value = String(bpm);
        });

        let barsPerLine = calcBarsPerLine();
        window.addEventListener("resize", () => {
          const n = calcBarsPerLine();
          if (n !== barsPerLine) { barsPerLine = n; renderGrid(); }
        });

        const cpb = pattern.beatsPerBar * SUBS_PER_BEAT;

        function renderGrid() {
          const numChunks = Math.ceil(pattern!.numBars / barsPerLine);
          let html = "";

          for (let chunk = 0; chunk < numChunks; chunk++) {
            const startBar = chunk * barsPerLine;
            const endBar = Math.min(startBar + barsPerLine, pattern!.numBars);
            const barsInChunk = endBar - startBar;
            const cellsInChunk = barsInChunk * cpb;
            const startCell = startBar * cpb;
            const cols = `repeat(${cellsInChunk},1fr)`;

            html += `<div class="chunk-wrap">`;

            html += `<div class="chunk-side">`;
            html += `<div class="side-spacer"></div>`;
            for (const row of pattern!.rows) {
              html += `<div class="side-row"><div class="side-label"><span title="${esc(row.label)}">${esc(row.label)}</span></div></div>`;
            }
            html += `</div>`;

            html += `<div class="chunk">`;
            html += `<div class="chunk-hdr">`;
            html += `<div class="hdr-cells bar-hdr" style="grid-template-columns:${cols}">`;
            for (let b = startBar; b < endBar; b++) {
              const sep = b > startBar ? " bar-sep" : "";
              html += `<div class="bar-lbl${sep}" style="grid-column:span ${cpb}">${b + 1}小節</div>`;
            }
            html += `</div>`;
            html += `<div class="hdr-cells beat-hdr" style="grid-template-columns:${cols}">`;
            for (let b = startBar; b < endBar; b++) {
              for (let beat = 0; beat < pattern!.beatsPerBar; beat++) {
                const isBar = beat === 0 && b > startBar;
                const isBeat = beat > 0;
                let cls = "beat-lbl";
                if (isBar) cls += " bar-sep";
                else if (isBeat) cls += " beat-sep";
                html += `<div class="${cls}" style="grid-column:span ${SUBS_PER_BEAT}">${beat + 1}拍</div>`;
              }
            }
            html += `</div></div>`;

            html += `<div class="chunk-body">`;
            for (let r = 0; r < pattern!.rows.length; r++) {
              const row = pattern!.rows[r];
              html += `<div class="chunk-cells" style="grid-template-columns:${cols}">`;
              for (let c = 0; c < cellsInChunk; c++) {
                const globalC = startCell + c;
                const inBar = c % cpb;
                const isBarBound = inBar === 0 && c > 0;
                const isBeatBound = inBar % SUBS_PER_BEAT === 0 && !isBarBound && c > 0;
                let cls = "cell";
                if (isBarBound) cls += " bar-sep";
                else if (isBeatBound) cls += " beat-sep";
                if (row.cells[globalC]) cls += " active";
                html += `<div class="${cls}" data-r="${r}" data-c="${globalC}"></div>`;
              }
              html += `</div>`;
            }
            html += `</div></div></div>`;
          }

          rpGrid.innerHTML = html;
        }

        renderGrid();

        /* Audio */
        const totalCells = pattern.numBars * cpb;
        let audioCtx: AudioContext | null = null;
        const soundBuffers = new Map<string, AudioBuffer>();
        let isPlaying = false;
        let currentStep = 0;
        let nextNoteTime = 0;
        let playStartTime = 0;
        let schedulerTimer: number | null = null;
        let phRAF: number | null = null;

        function trimSilence(buffer: AudioBuffer): AudioBuffer {
          const ch0 = buffer.getChannelData(0);
          let start = 0;
          for (let i = 0; i < ch0.length; i++) {
            if (Math.abs(ch0[i]) > 0.005) { start = i; break; }
          }
          if (start === 0) return buffer;
          const len = buffer.length - start;
          const trimmed = audioCtx!.createBuffer(buffer.numberOfChannels, len, buffer.sampleRate);
          for (let ch = 0; ch < buffer.numberOfChannels; ch++) {
            trimmed.getChannelData(ch).set(buffer.getChannelData(ch).subarray(start));
          }
          return trimmed;
        }

        async function ensureAudio() {
          if (!audioCtx) audioCtx = new AudioContext();
          if (audioCtx.state === "suspended") await audioCtx.resume();
          if (soundBuffers.size === 0) {
            await Promise.all(SOUND_FILES.map(async (name) => {
              const res = await fetch(`${BASE}/sounds/drum/${name}.mp3`);
              const buf = await res.arrayBuffer();
              const decoded = await audioCtx!.decodeAudioData(buf);
              soundBuffers.set(name, trimSilence(decoded));
            }));
          }
        }

        function getSoundName(label: string): string {
          const norm = label.trim().toLowerCase().replace(/[-_\s]/g, "");
          if (!norm) return DEFAULT_SOUND;
          for (const name of SOUND_FILES) if (norm === name || norm.includes(name)) return name;
          if (norm === "hh" || norm === "hat") return "hihat";
          if (norm === "bd" || norm.includes("bass")) return "kick";
          if (norm === "sd") return "snare";
          return DEFAULT_SOUND;
        }

        function playBuffer(name: string, time: number) {
          const buf = soundBuffers.get(name);
          if (!buf || !audioCtx) return;
          const src = audioCtx.createBufferSource();
          src.buffer = buf; src.connect(audioCtx.destination); src.start(time);
        }

        function scheduleNote(step: number, time: number) {
          for (const row of pattern!.rows) if (row.cells[step]) playBuffer(getSoundName(row.label), time);
        }

        function advanceStep() {
          nextNoteTime += 60 / bpm / SUBS_PER_BEAT;
          currentStep = (currentStep + 1) % totalCells;
        }

        function scheduler() {
          if (!audioCtx || !isPlaying) return;
          while (nextNoteTime < audioCtx.currentTime + 0.1) { scheduleNote(currentStep, nextNoteTime); advanceStep(); }
          schedulerTimer = window.setTimeout(scheduler, 25);
        }

        function updatePH() {
          if (!isPlaying || !audioCtx) return;
          const step = Math.floor((audioCtx.currentTime - playStartTime) / (60 / bpm / SUBS_PER_BEAT)) % totalCells;
          rpGrid.querySelectorAll(".cell.playhead").forEach(el => el.classList.remove("playhead"));
          rpGrid.querySelectorAll(`.cell[data-c="${step}"]`).forEach(el => el.classList.add("playhead"));
          phRAF = requestAnimationFrame(updatePH);
        }

        async function startPlay() {
          await ensureAudio();
          isPlaying = true; currentStep = 0;
          nextNoteTime = audioCtx!.currentTime + 0.05;
          playStartTime = nextNoteTime;
          playBtn.textContent = "⏹"; playBtn.classList.add("playing");
          scheduler(); updatePH();
        }

        function stopPlay() {
          isPlaying = false;
          if (schedulerTimer !== null) clearTimeout(schedulerTimer);
          if (phRAF !== null) cancelAnimationFrame(phRAF);
          rpGrid.querySelectorAll(".cell.playhead").forEach(el => el.classList.remove("playhead"));
          playBtn.textContent = "▶"; playBtn.classList.remove("playing");
        }

        playBtn.addEventListener("click", () => { isPlaying ? stopPlay() : startPlay(); });
      }
    </script>
  </body>
</html>
