---
import { getCollection, type CollectionEntry } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import NotePost from '../../layouts/NotePost.astro';
import NoteEmbedLink from '../../components/NoteEmbedLink.astro';
import NoteImage from '../../components/NoteImage.astro';

// song.link はビルド時ではなくクライアントで取得（本番ビルド環境で API が叩けない場合があるため）
const musicLinks: Record<string, { linksByPlatform?: Record<string, { url?: string }> }> = {};

// 本番は公開記事のみ、stg（base /stg/）では非公開も含めて全件ビルド
export const getStaticPaths = (async () => {
  const isStg = (import.meta.env.BASE_URL ?? '/').startsWith('/stg');
  const noteFilter = isStg ? () => true : ({ data }: { data: { is_public?: boolean } }) => data.is_public !== false;
  const posts = await getCollection('notes', noteFilter);
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}) satisfies GetStaticPaths;

// ページのプロパティ
interface Props {
  post: CollectionEntry<'notes'>;
}

const { post } = Astro.props as Props;
const { Content } = await post.render();
---

<NotePost 
  title={post.data.title}
  date={post.data.date}
  author={post.data.author}
  tags={post.data.tags}
  musicLinks={musicLinks}
>
  <Content components={{ a: NoteEmbedLink, img: NoteImage }} />
</NotePost>
