---
import Layout from '../layouts/Layout.astro';
---

<Layout title="ページが見つかりません">
  <main class="error-page">
    <div class="error-container">
      <div class="error-content">
        <h1 class="error-code">404</h1>
        <h2 class="error-title">ページが見つかりません</h2>
        <p class="error-description">
          お探しのページは存在しないか、移動された可能性があります。
        </p>
        <div class="error-actions">
          <a href="/" class="btn">トップページへ</a>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  .error-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f8f9fa;
    color: #2c3e50;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  .error-container {
    text-align: center;
    max-width: 500px;
    padding: 2rem;
  }

  .error-content {
    background: white;
    border-radius: 12px;
    padding: 3rem 2rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    border: 1px solid #e9ecef;
  }

  .error-code {
    font-size: 6rem;
    font-weight: 300;
    margin: 0;
    line-height: 1;
    color: #6c757d;
    letter-spacing: -0.02em;
  }

  .error-title {
    font-size: 1.5rem;
    font-weight: 500;
    margin: 1.5rem 0 1rem;
    color: #2c3e50;
  }

  .error-description {
    font-size: 1rem;
    margin: 0 0 2rem;
    color: #6c757d;
    line-height: 1.6;
  }

  .error-actions {
    display: flex;
    justify-content: center;
  }

  .btn {
    display: inline-block;
    padding: 0.75rem 2rem;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    transition: all 0.2s ease;
    background: #2c3e50;
    color: white;
    border: 1px solid #2c3e50;
  }

  .btn:hover {
    background: #34495e;
    border-color: #34495e;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(44, 62, 80, 0.15);
  }

  @media (max-width: 768px) {
    .error-container {
      padding: 1rem;
    }
    
    .error-content {
      padding: 2rem 1.5rem;
    }
    
    .error-code {
      font-size: 4rem;
    }
    
    .error-title {
      font-size: 1.25rem;
    }
    
    .error-description {
      font-size: 0.9rem;
    }
  }
</style>