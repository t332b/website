---
import Base from "../layouts/Base.astro";
import { getCollection } from 'astro:content';

const posts = (await getCollection('diary'))
  .sort((a,b) => b.data.date.getTime() - a.data.date.getTime()); // 新しい順
---

<Base title="test">
  <h1 style="font-size:1.5rem; font-weight:700; margin-bottom:1rem;">日記</h1>

  <!-- 絞り込みUI -->
  <div id="filters" style="display:flex; gap:.5rem; flex-wrap:wrap; margin-bottom:1rem;">
    <div>
      <button class="author-btn" data-author="ALL">ALL</button>
      <button class="author-btn" data-author="A">A</button>
      <button class="author-btn" data-author="B">B</button>
    </div>
    <div style="display:flex; gap:.5rem; align-items:center;">
      <label>From: <input type="date" id="fromDate"></label>
      <label>To: <input type="date" id="toDate"></label>
      <button id="clearDates">日付クリア</button>
    </div>
    <div style="display:flex; gap:.5rem; align-items:center;">
      <input type="text" id="q" placeholder="キーワード（タイトル/タグ）" />
      <button id="clearQ">クリア</button>
    </div>
  </div>

  <!-- 一覧 -->
  <ul id="list" style="list-style:none; padding:0; margin:0; display:grid; gap:12px;">
    {posts.map(p => {
      const d = p.data.date.toISOString().slice(0,10); // YYYY-MM-DD
      const tags = (p.data.tags ?? []).join(',');
      return (
        <li class="item"
            data-author={p.data.author}
            data-date={d}
            data-title={p.data.title.toLowerCase()}
            data-tags={tags.toLowerCase()}>
          <a href={`/diary/${p.slug}/`} style="text-decoration:underline; font-weight:600;">
            {p.data.title}
          </a>
          <div style="font-size:.85rem; opacity:.75;">
            {d} ・ {p.data.author} {tags && `・ ${tags}`}
          </div>
        </li>
      )
    })}
  </ul>

  <script>
    // シンプルなバニラJS絞り込み
    const list = document.getElementById('list');
    const items = Array.from(list.querySelectorAll('.item'));

    const authorBtns = document.querySelectorAll('.author-btn');
    const fromInput = document.getElementById('fromDate');
    const toInput = document.getElementById('toDate');
    const clearDates = document.getElementById('clearDates');
    const q = document.getElementById('q');
    const clearQ = document.getElementById('clearQ');

    let author = 'ALL';

    authorBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        author = btn.dataset.author;
        authorBtns.forEach(b => b.style.fontWeight = (b===btn? '700':'400'));
        applyFilters();
      });
    });

    fromInput.addEventListener('change', applyFilters);
    toInput.addEventListener('change', applyFilters);
    clearDates.addEventListener('click', () => {
      fromInput.value = '';
      toInput.value = '';
      applyFilters();
    });

    q.addEventListener('input', applyFilters);
    clearQ.addEventListener('click', () => {
      q.value = '';
      applyFilters();
    });

    function applyFilters() {
      const from = fromInput.value ? new Date(fromInput.value) : null;
      const to = toInput.value ? new Date(toInput.value) : null;
      const query = q.value.trim().toLowerCase();

      items.forEach(el => {
        const a = el.dataset.author;
        const d = new Date(el.dataset.date);
        const text = (el.dataset.title + ' ' + el.dataset.tags).toLowerCase();

        let ok = true;

        if (author !== 'ALL' && a !== author) ok = false;
        if (from && d < from) ok = false;
        if (to && d > to) ok = false;
        if (query && !text.includes(query)) ok = false;

        el.style.display = ok ? '' : 'none';
      });
    }

    // 初期選択
    authorBtns[0].style.fontWeight = '700'; // ALL
    applyFilters();
  </script>
</Base>
