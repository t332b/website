---
import Base from "../layouts/Base.astro";
import { getEntry } from "astro:content";

const featured = await getEntry("works", "affordance-everywhere");
const featuredLink = "https://nodee.net/a/3aamqp0iz519";

const releaseDate = featured?.data.release_date.toLocaleDateString("ja-JP", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
});
---

<Base title="PR0P0SE">
  {
    featured && (
      <section class="home-release">
        {featured.data.cover_url_list[0] && (
          <a href={featuredLink} target="_blank" rel="noopener noreferrer" class="home-release-cover">
            <img src={featured.data.cover_url_list[0]} alt={featured.data.title} />
          </a>
        )}
        <h1 class="home-release-title">
          <span class="home-release-kind">1st Album</span><br />
          『{featured.data.title}』
        </h1>
        <p class="home-release-date">{releaseDate} Release</p>
        <a href={featuredLink} target="_blank" rel="noopener noreferrer" class="home-release-btn">
          Listen / Buy
        </a>
      </section>
    )
  }

  <style>
    .home-release {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      max-width: 480px;
      margin: 0 auto;
      padding: 1rem 0 3rem;
    }

    .home-release-cover {
      display: block;
      width: 100%;
      margin-bottom: 1.5rem;
    }

    .home-release-cover img {
      display: block;
      width: 100%;
      aspect-ratio: 1;
      object-fit: cover;
      border-radius: 12px;
      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.12);
    }

    .home-release-title {
      font-size: 1.2rem;
      font-weight: 700;
      line-height: 1.5;
      margin: 0 0 0.25rem;
      color: var(--wa-ink);
    }

    .home-release-kind {
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--muted);
    }

    .home-release-date {
      color: var(--muted);
      margin: 0 0 1.5rem;
    }

    .home-release-btn {
      display: inline-block;
      padding: 0.6rem 1.8rem;
      border: 2px solid var(--wa-ink);
      border-radius: 8px;
      text-decoration: none;
      font-weight: 700;
      letter-spacing: 0.08em;
      color: var(--wa-ink);
      transition: background 0.2s ease, color 0.2s ease;
    }

    .home-release-btn:hover {
      background: var(--wa-ink);
      color: white;
    }
  </style>
</Base>
