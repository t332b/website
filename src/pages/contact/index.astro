---
import Base from "../../layouts/Base.astro";

// 一時対応: Spotify 認証のためメールアドレスをテキストで表示中。認証後にこのコミットを revert して canvas 表示に戻す。
const emailAddress = "contact@pr0p0se.com";
---

<Base title="PR0P0SE CONTACT">
  <section class="contact-page">
    <div class="mail-card">
      <div class="mail-row">
        <a id="contact-mail-link" class="mail-text" href={`mailto:${emailAddress}`}>{emailAddress}</a>

        <button
          id="copy-mail-button"
          class="copy-button"
          type="button"
          aria-label="メールアドレスをコピー"
          data-default-label="copy"
        >
          copy
        </button>
      </div>
    </div>
  </section>

  <script>
    async function copyMailAddress(text: string, copyButton: HTMLButtonElement) {
      const defaultLabel = copyButton.getAttribute("data-default-label") || "copy";
      try {
        await navigator.clipboard.writeText(text);
        copyButton.textContent = "✓ copied";
        copyButton.classList.add("is-copied");
      } catch {
        copyButton.textContent = "failed";
        copyButton.classList.remove("is-copied");
      } finally {
        window.setTimeout(() => {
          copyButton.textContent = defaultLabel;
          copyButton.classList.remove("is-copied");
        }, 1800);
      }
    }

    function setupContactPage() {
      /** @type {HTMLAnchorElement | null} */
      const mailLink = document.getElementById("contact-mail-link");
      /** @type {HTMLButtonElement | null} */
      const copyButton = document.getElementById("copy-mail-button");
      const emailAddress = mailLink?.textContent?.trim();
      if (!emailAddress || !copyButton) return;

      copyButton.onclick = () => {
        copyMailAddress(emailAddress, copyButton);
      };
    }

    setupContactPage();
    document.addEventListener("astro:page-load", setupContactPage);
  </script>

  <style>
    .contact-page {
      max-width: 400px;
      margin: 0 auto;
      padding: 2rem 1rem 2.5rem;
    }

    .mail-card {
      display: flex;
      flex-direction: column;
      gap: 0.95rem;
      background: var(--card, #fff9f1);
      border-radius: 12px;
      padding: 1rem 1rem;
      box-shadow: var(--shadow);
    }

    .mail-row {
      display: flex;
      align-items: center;
      gap: 0.65rem;
    }

    .mail-text {
      flex: 1 1 auto;
      min-width: 0;
      padding: 0.4rem 0.5rem;
      border: 1px solid #f5d19a;
      border-radius: 2px;
      background: #fff9f1;
      color: #2f2a28;
      font-family: Menlo, "PT Mono", "Courier New", monospace;
      font-size: 1rem;
      font-weight: 600;
      line-height: 1.2;
      text-align: center;
      text-decoration: none;
      overflow-wrap: anywhere;
    }

    .copy-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border: 1px solid var(--accent, #2d7a78);
      background: transparent;
      color: var(--accent, #2d7a78);
      border-radius: 7px;
      padding: 0.3rem 0.5rem;
      line-height: 1;
      min-width: 50px;
      font-size: 0.7rem;
      font-weight: 600;
      white-space: nowrap;
      transition:
        background-color 0.2s ease,
        color 0.2s ease,
        border-color 0.2s ease,
        transform 0.2s ease;
    }

    .copy-button:hover {
      background: var(--accent, #2d7a78);
      color: #fff;
    }

    .copy-button:active {
      transform: scale(0.98);
    }

    .copy-button.is-copied {
      background: var(--accent, #2d7a78);
      color: #fff;
      border-color: var(--accent, #2d7a78);
    }

    @media (max-width: 380px) {
      .contact-page {
        padding: 1rem 0.75rem 1.5rem;
      }

      .mail-card {
        padding: 0.9rem 0.75rem;
      }

      .mail-row {
        flex-direction: column;
        align-items: stretch;
      }

      .copy-button {
        align-self: flex-end;
        min-width: 20px;
        font-size: 0.5rem;
      }

    }
  </style>
</Base>
