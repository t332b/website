      transition: all 0.2s ease;
    }

    .release-card--clickable:hover .spotify-badge {
      background: rgba(30, 215, 96, 0.9);
      transform: scale(1.05);
    }

    .spotify-badge-icon {
      width: 20px;
      height: 20px;
      filter: brightness(0) invert(1);
    }

    .release-card--clickable:hover .spotify-badge-icon {
      filter: none;
    }

    .spotify-badge-text {
      color: white;
      font-size: 0.85rem;
      font-weight: 600;
