    }

    .card-detail-link {
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      font-size: 0.8rem;
      font-weight: 600;
      color: #6f42c1;
      text-decoration: none;
      transition: color 0.2s ease;
    }

