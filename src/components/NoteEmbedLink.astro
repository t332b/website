---
import { getEmbedInfoFromUrl } from "../utils/embedUrl";

interface Props {
  href?: string;
  title?: string;
}

let { href = "", title } = Astro.props;
// tetetest（base /tetetest/）では同一サイトの /notes/ リンクを base 付きにする
const base = (import.meta.env.BASE_URL ?? "/").replace(/\/$/, "") || "";
if (base && href.startsWith("/notes")) {
  href = base + href;
}
const embed = href ? getEmbedInfoFromUrl(href) : null;
---

{embed && (embed.service === "spotify" || embed.service === "apple") ? (
  // Apple Music / Spotify は記事上部の専用プレーヤーで表示するため、本文内リンクは通常リンクにする
  <a href={href} title={title} target="_blank" rel="noopener noreferrer">
    {href}
  </a>
) : embed ? (
  <div class="note-embed">
    {embed.service === "youtube" && (
      <div class="note-embed-video">
        <iframe
          src={embed.embedUrl}
          title={title || "YouTube"}
          width="100%"
          height="315"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        />
      </div>
    )}
    {embed.service === "cloudinaryVideo" && (
      <div class="note-embed-video">
        <video controls playsinline preload="metadata">
          <source src={embed.embedUrl} />
          お使いのブラウザでは動画を再生できません。
        </video>
      </div>
    )}
    {embed.service === "cloudinaryAudio" && (
      <div class="note-embed-audio note-embed-audio--cloudinary">
        <audio controls preload="metadata">
          <source src={embed.embedUrl} />
          お使いのブラウザでは音声を再生できません。
        </audio>
      </div>
    )}
    {embed.service === "bandcamp" && (
      <div class="note-embed-audio">
        <iframe
          src={embed.embedUrl}
          title={title || embed.service}
          width="100%"
          height="120"
          frameborder="0"
          allowfullscreen
          allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
        />
      </div>
    )}
  </div>
) : (
  <a href={href} title={title} target="_blank" rel="noopener noreferrer">
    <slot />
  </a>
)}

<style>
  .note-embed {
    width: 100%;
    margin: 1.75rem 0;
  }

  .note-embed-video,
  .note-embed-audio {
    position: relative;
    width: 100%;
    border-radius: 12px;
    overflow: hidden;
    background: #000;
  }

  .note-embed-video iframe,
  .note-embed-video video,
  .note-embed-audio iframe {
    display: block;
    border: none;
  }

  .note-embed-video {
    line-height: 0;
  }

  .note-embed-video iframe {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
  }

  .note-embed-video video {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    background: #000;
  }

  .note-embed-audio--cloudinary {
    background: transparent;
    padding: 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .note-embed-audio--cloudinary audio {
    width: 100%;
  }

</style>
