---
import { getEmbedInfoFromUrl } from "../utils/embedUrl";

interface Props {
  href?: string;
  title?: string;
}

let { href = "", title } = Astro.props;
// stg（base /stg/）では同一サイトの /notes/ リンクを base 付きにする
const base = (import.meta.env.BASE_URL ?? "/").replace(/\/$/, "") || "";
if (base && href.startsWith("/notes")) {
  href = base + href;
}
const embed = href ? getEmbedInfoFromUrl(href) : null;
---

{embed ? (
  <div class="note-embed">
    {embed.service === "youtube" && (
      <div class="note-embed-video">
        <iframe
          src={embed.embedUrl}
          title={title || "YouTube"}
          width="100%"
          height="315"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        />
      </div>
    )}
    {embed.service === "cloudinaryVideo" && (
      <div class="note-embed-video">
        <video controls playsinline preload="metadata">
          <source src={embed.embedUrl} />
          お使いのブラウザでは動画を再生できません。
        </video>
      </div>
    )}
    {embed.service === "cloudinaryAudio" && (
      <div class="note-embed-audio note-embed-audio--cloudinary">
        <audio controls preload="metadata">
          <source src={embed.embedUrl} />
          お使いのブラウザでは音声を再生できません。
        </audio>
      </div>
    )}
    {embed.service === "bandcamp" && (
      <div class="note-embed-audio">
        <iframe
          src={embed.embedUrl}
          title={title || embed.service}
          width="100%"
          height="120"
          frameborder="0"
          allowfullscreen
          allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
        />
      </div>
    )}
    {(embed.service === "spotify" || embed.service === "apple") && (
      <div
        class="note-embed-music-tabs"
        data-music-url={href}
        data-default-service={embed.service}
      >
        <div class="note-embed-music-tabs-inner">
          <div class="note-embed-music-frames">
            <div
              class="note-embed-music-frame active"
              data-service={embed.service}
              aria-hidden="false"
            >
              <iframe
                src={embed.embedUrl}
                title={title || embed.service}
                width="100%"
                height={embed.service === "spotify" ? "152" : "150"}
                frameborder="0"
                allowfullscreen
                allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
              />
            </div>
          </div>
          <div class="note-embed-music-tablist" role="tablist" aria-label="再生サービス">
            <button
              type="button"
              class="note-embed-music-tab active"
              role="tab"
              aria-selected="true"
              data-service={embed.service}
              aria-controls={`note-embed-frame-${embed.service}`}
            >
              <span class="note-embed-music-tab-label">
                {embed.service === "spotify" ? "Spotify" : "Apple Music"}
              </span>
            </button>
          </div>
        </div>
      </div>
    )}
  </div>
) : (
  <a href={href} title={title} target="_blank" rel="noopener noreferrer">
    <slot />
  </a>
)}

<style>
  .note-embed {
    width: 100%;
    margin: 1.75rem 0;
  }

  .note-embed-video,
  .note-embed-audio {
    position: relative;
    width: 100%;
    border-radius: 12px;
    overflow: hidden;
    background: #000;
  }

  .note-embed-video iframe,
  .note-embed-video video,
  .note-embed-audio iframe {
    display: block;
    border: none;
  }

  .note-embed-video {
    line-height: 0;
  }

  .note-embed-video iframe {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
  }

  .note-embed-video video {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    background: #000;
  }

  .note-embed-audio--cloudinary {
    background: transparent;
    padding: 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .note-embed-audio--cloudinary audio {
    width: 100%;
  }

</style>
