---
import { getEmbedInfoFromUrl } from "../utils/embedUrl";

interface Props {
  href?: string;
  title?: string;
}

const { href = "", title } = Astro.props;
const embed = href ? getEmbedInfoFromUrl(href) : null;
const embedOpenLabel =
  embed?.service === "cloudinaryVideo"
    ? "動画を開く"
    : embed?.service === "cloudinaryAudio"
      ? "音声を開く"
      : embed
        ? `${embed.service}で開く`
        : "";
---

{embed ? (
  <div class="note-embed">
    {embed.service === "youtube" && (
      <div class="note-embed-video">
        <iframe
          src={embed.embedUrl}
          title={title || "YouTube"}
          width="100%"
          height="315"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        />
      </div>
    )}
    {embed.service === "cloudinaryVideo" && (
      <div class="note-embed-video">
        <video controls playsinline preload="metadata">
          <source src={embed.embedUrl} />
          お使いのブラウザでは動画を再生できません。
        </video>
      </div>
    )}
    {embed.service === "cloudinaryAudio" && (
      <div class="note-embed-audio note-embed-audio--cloudinary">
        <audio controls preload="metadata">
          <source src={embed.embedUrl} />
          お使いのブラウザでは音声を再生できません。
        </audio>
      </div>
    )}
    {(embed.service === "spotify" || embed.service === "bandcamp" || embed.service === "apple") && (
      <div class="note-embed-audio">
        <iframe
          src={embed.embedUrl}
          title={title || embed.service}
          width="100%"
          height={embed.service === "spotify" ? "152" : embed.service === "bandcamp" ? "120" : "150"}
          frameborder="0"
          allowfullscreen
          allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
        />
      </div>
    )}
    <a href={href} class="note-embed-link" target="_blank" rel="noopener noreferrer">{embedOpenLabel}</a>
  </div>
) : (
  <a href={href} title={title} target="_blank" rel="noopener noreferrer">
    <slot />
  </a>
)}

<style>
  .note-embed {
    width: 100%;
    margin: 1.75rem 0;
  }

  .note-embed-video,
  .note-embed-audio {
    position: relative;
    width: 100%;
    border-radius: 12px;
    overflow: hidden;
    background: #000;
  }

  .note-embed-video iframe,
  .note-embed-video video,
  .note-embed-audio iframe {
    display: block;
    border: none;
  }

  .note-embed-video {
    line-height: 0;
  }

  .note-embed-video iframe {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
  }

  .note-embed-video video {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    background: #000;
  }

  .note-embed-audio--cloudinary {
    background: transparent;
    padding: 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .note-embed-audio--cloudinary audio {
    width: 100%;
  }

  .note-embed-link {
    display: inline-block;
    margin-top: 0.5rem;
    font-size: 0.875rem;
    color: var(--accent);
    font-weight: 600;
    cursor: pointer;
  }

  .note-embed-link:hover {
    text-decoration: underline;
  }
</style>
