---
---

<div id="pianoRoot" class="piano-root" transition:persist="piano-ui">
    <div id="pianoPanel" class="piano-panel hidden">
        <div class="piano-controls">
            <label class="piano-start-label" for="pianoStartRange">
                Start: <span id="pianoStartLabel">C3</span>
            </label>
            <input id="pianoStartRange" class="piano-start-range" type="range" min="21" max="108" step="1" value="48" />
        </div>
        <div id="pianoBackground" class="piano-background"></div>
    </div>
</div>

<script>
    function initPiano() {
        const root = document.getElementById("pianoRoot");
        const pianoBackground = document.getElementById("pianoBackground");
        const panel = document.getElementById("pianoPanel");
        const startRange = document.getElementById("pianoStartRange");
        const startLabel = document.getElementById("pianoStartLabel");

        if (!root || !pianoBackground || !panel || !startRange || !startLabel) return;

        const state = (window.__pianoState ??= { isOpen: false, startMidi: 48 });
        const engine = (window.__pianoEngine ??= {
            audioContext: null,
            buffers: new Map(),
            loadingBuffers: new Map(),
            activeNotes: new Map(),
            loopPoints: {},
            loopPointsLoaded: false,
        });
        const ui = (window.__pianoUi ??= {
            delegatedToggleBound: false,
            resizeBound: false,
            rangeBound: false,
            longPressGuardBound: false,
        });

        const NOTE_NAMES = ["C", "Cs", "D", "Ds", "E", "F", "Fs", "G", "Gs", "A", "As", "B"];
        const FULL_PIANO_MIN_MIDI = 21;
        const FULL_PIANO_MAX_MIDI = 108;
        const FULL_PIANO_KEY_COUNT = 88;
        const DEFAULT_LOOP = { loopStart: 0.08, release: 0.05, gain: 1 };
        const DEFAULT_LOOP_END_OFFSET = 0.02;

        const pointerToNote = new Map();
        const noteHoldCount = new Map();
        const noteElement = new Map();

        function clamp(value, min, max) {
            return Math.max(min, Math.min(max, value));
        }

        function midiToNote(midiNumber) {
            const octave = Math.floor(midiNumber / 12) - 1;
            const pitch = NOTE_NAMES[midiNumber % 12];
            return `${pitch}${octave}`;
        }

        function isBlackKey(note) {
            return note.includes("s");
        }

        function getKeyRangeByViewport(viewportWidth, viewportHeight) {
            const isLandscape = viewportWidth > viewportHeight;
            const isMobileLike = viewportWidth <= 1024;

            if (viewportWidth <= 640) {
                if (isLandscape) return { min: 18, max: 36, targetWhiteKeyPx: 22 };
                return { min: 16, max: 19, targetWhiteKeyPx: 34 };
            }
            if (viewportWidth <= 960) {
                if (isLandscape && isMobileLike) return { min: 30, max: 56, targetWhiteKeyPx: 20 };
                return { min: 24, max: 48, targetWhiteKeyPx: 24 };
            }
            if (viewportWidth <= 1280) return { min: 36, max: 72, targetWhiteKeyPx: 22 };
            return { min: 48, max: FULL_PIANO_KEY_COUNT, targetWhiteKeyPx: 20 };
        }

        function getFirstMidi(keyCount, preferredStartMidi) {
            if (keyCount >= FULL_PIANO_KEY_COUNT) return FULL_PIANO_MIN_MIDI;
            const maxStart = FULL_PIANO_MAX_MIDI - keyCount + 1;
            const rawStart = Number.isFinite(preferredStartMidi) ? Math.round(preferredStartMidi) : 48;
            return clamp(rawStart, FULL_PIANO_MIN_MIDI, maxStart);
        }

        function getAudioContext() {
            if (engine.audioContext) return engine.audioContext;
            const Ctor = window.AudioContext || window.webkitAudioContext;
            if (!Ctor) return null;
            engine.audioContext = new Ctor({ latencyHint: "interactive" });
            return engine.audioContext;
        }

        async function ensureLoopPointsLoaded() {
            if (engine.loopPointsLoaded) return;
            try {
                const response = await fetch("/piano/loop-points.json", { cache: "no-store" });
                if (!response.ok) {
                    engine.loopPoints = {};
                } else {
                    const raw = await response.json();
                    engine.loopPoints = raw && typeof raw === "object" ? raw : {};
                }
            } catch (_) {
                engine.loopPoints = {};
            } finally {
                engine.loopPointsLoaded = true;
            }
        }

        function resolveLoopForNote(note, duration) {
            const defaults = engine.loopPoints._default ?? {};
            const config = engine.loopPoints[note] ?? {};

            const requestedLoopStart = config.loopStart ?? defaults.loopStart ?? DEFAULT_LOOP.loopStart;
            const safeLoopStart = clamp(requestedLoopStart, 0, Math.max(0, duration - 0.03));
            const requestedLoopEnd =
                config.loopEnd ??
                defaults.loopEnd ??
                duration - (config.loopEndOffset ?? defaults.loopEndOffset ?? DEFAULT_LOOP_END_OFFSET);
            const minLoopEnd = safeLoopStart + 0.01;
            const safeLoopEnd = clamp(requestedLoopEnd, minLoopEnd, duration);

            const release = clamp(config.release ?? defaults.release ?? DEFAULT_LOOP.release, 0.005, 0.3);
            const gain = clamp(config.gain ?? defaults.gain ?? DEFAULT_LOOP.gain, 0, 1);
            return { loopStart: safeLoopStart, loopEnd: safeLoopEnd, release, gain };
        }

        async function loadBuffer(note) {
            const cached = engine.buffers.get(note);
            if (cached) return cached;

            const loading = engine.loadingBuffers.get(note);
            if (loading) return loading;

            const promise = (async () => {
                const context = getAudioContext();
                if (!context) throw new Error("AudioContext is unavailable");

                const response = await fetch(`/piano/audio/${note}.mp3`);
                if (!response.ok) throw new Error(`Audio file not found: ${note}`);
                const arrayBuffer = await response.arrayBuffer();
                const audioBuffer = await context.decodeAudioData(arrayBuffer.slice(0));
                engine.buffers.set(note, audioBuffer);
                return audioBuffer;
            })();

            engine.loadingBuffers.set(note, promise);
            try {
                return await promise;
            } finally {
                engine.loadingBuffers.delete(note);
            }
        }

        function stopActiveVoice(note) {
            const active = engine.activeNotes.get(note);
            if (!active) return;

            const context = getAudioContext();
            if (!context) return;

            const now = context.currentTime;
            const currentGain = active.gainNode.gain.value;
            active.gainNode.gain.cancelScheduledValues(now);
            active.gainNode.gain.setValueAtTime(currentGain, now);
            active.gainNode.gain.linearRampToValueAtTime(0, now + active.release);

            try {
                active.source.stop(now + active.release + 0.02);
            } catch (_) {}

            engine.activeNotes.delete(note);
        }

        async function startNote(note) {
            const currentCount = noteHoldCount.get(note) ?? 0;
            noteHoldCount.set(note, currentCount + 1);
            if (currentCount > 0) return;

            const key = noteElement.get(note);
            key?.classList.add("is-pressed");

            try {
                await ensureLoopPointsLoaded();
                const context = getAudioContext();
                if (!context) return;
                if (context.state === "suspended") await context.resume();

                const buffer = await loadBuffer(note);
                if ((noteHoldCount.get(note) ?? 0) <= 0) return;

                stopActiveVoice(note);

                const loopConfig = resolveLoopForNote(note, buffer.duration);
                const source = context.createBufferSource();
                source.buffer = buffer;
                source.loop = true;
                source.loopStart = loopConfig.loopStart;
                source.loopEnd = loopConfig.loopEnd;

                const gainNode = context.createGain();
                const now = context.currentTime;
                gainNode.gain.setValueAtTime(0, now);
                gainNode.gain.linearRampToValueAtTime(loopConfig.gain, now + 0.004);

                source.connect(gainNode);
                gainNode.connect(context.destination);
                source.start(now, 0);

                source.onended = () => {
                    const active = engine.activeNotes.get(note);
                    if (active?.source === source) engine.activeNotes.delete(note);
                };

                engine.activeNotes.set(note, { source, gainNode, release: loopConfig.release });
            } catch (_) {
                noteHoldCount.delete(note);
                key?.classList.remove("is-pressed");
            }
        }

        function stopNote(note) {
            const currentCount = noteHoldCount.get(note) ?? 0;
            if (currentCount <= 1) {
                noteHoldCount.delete(note);
                const key = noteElement.get(note);
                key?.classList.remove("is-pressed");
                stopActiveVoice(note);
                return;
            }
            noteHoldCount.set(note, currentCount - 1);
        }

        function stopPointer(pointerId) {
            const note = pointerToNote.get(pointerId);
            if (!note) return;
            pointerToNote.delete(pointerId);
            stopNote(note);
        }

        function stopAllNotes() {
            pointerToNote.clear();
            for (const note of noteHoldCount.keys()) {
                noteElement.get(note)?.classList.remove("is-pressed");
            }
            noteHoldCount.clear();
            for (const note of Array.from(engine.activeNotes.keys())) {
                stopActiveVoice(note);
            }
        }

        function getToggleButton() {
            return document.getElementById("pianoToggle") || document.getElementById("pianoFab");
        }

        function updateToggleAria(isOpen) {
            const fab = getToggleButton();
            fab?.setAttribute("aria-expanded", isOpen ? "true" : "false");
        }

        function noteLabelFromMidi(midi) {
            return midiToNote(midi).replace("s", "#");
        }

        function updateStartLabel(midi) {
            startLabel.textContent = noteLabelFromMidi(midi);
        }

        function setPanelOpen(isOpen) {
            state.isOpen = isOpen;
            panel.classList.toggle("hidden", !isOpen);
            updateToggleAria(isOpen);
            if (!isOpen) stopAllNotes();
        }

        function createKeys() {
            stopAllNotes();
            pianoBackground.innerHTML = "";
            noteElement.clear();
            pointerToNote.clear();
            noteHoldCount.clear();

            const viewportWidth = window.innerWidth;
            const viewportHeight = window.innerHeight;
            const { min, max, targetWhiteKeyPx } = getKeyRangeByViewport(viewportWidth, viewportHeight);
            const panelStyle = window.getComputedStyle(panel);
            const panelHorizontalPadding = parseFloat(panelStyle.paddingLeft) + parseFloat(panelStyle.paddingRight);
            const measuredPanelWidth = panel.getBoundingClientRect().width || panel.clientWidth || 0;
            // hidden(display:none) 時は幅が 0 になるため、viewport から安全にフォールバックする
            const fallbackPanelWidth = Math.min(viewportWidth - 28, 1120);
            const panelInnerWidth = Math.max(
                220,
                (measuredPanelWidth > 0 ? measuredPanelWidth : fallbackPanelWidth) - panelHorizontalPadding,
            );
            const panelMaxWidth = Math.min(panelInnerWidth, 1120);
            const estimatedWhiteKeys = Math.floor(panelMaxWidth / targetWhiteKeyPx);
            const estimatedTotalKeys = Math.floor((estimatedWhiteKeys * 12) / 7);
            const keyCount = clamp(estimatedTotalKeys, min, max);
            const maxStartMidi = FULL_PIANO_MAX_MIDI - keyCount + 1;

            state.startMidi = clamp(state.startMidi ?? 48, FULL_PIANO_MIN_MIDI, maxStartMidi);
            startRange.min = String(FULL_PIANO_MIN_MIDI);
            startRange.max = String(maxStartMidi);
            startRange.value = String(state.startMidi);
            updateStartLabel(state.startMidi);

            const firstMidi = getFirstMidi(keyCount, state.startMidi);
            const notes = Array.from({ length: keyCount }, (_, i) => midiToNote(firstMidi + i));

            const whiteKeyCount = notes.filter((note) => !isBlackKey(note)).length;
            const whiteKeyWidth = clamp(panelMaxWidth / whiteKeyCount, 22, 40);
            const blackKeyWidth = whiteKeyWidth * 0.6;
            const blackHalf = blackKeyWidth / 2;
            const blackGapAdjust = whiteKeyWidth / 20;
            const whiteKeyHeight = clamp(whiteKeyWidth * 4.7, 72, 150);
            const blackKeyHeight = whiteKeyHeight * 0.58;

            pianoBackground.style.width = `${Math.round(whiteKeyCount * whiteKeyWidth)}px`;
            pianoBackground.style.height = `${Math.round(whiteKeyHeight)}px`;
            pianoBackground.style.setProperty("--white-key-height", `${Math.round(whiteKeyHeight)}px`);
            pianoBackground.style.setProperty("--black-key-height", `${Math.round(blackKeyHeight)}px`);

            let whiteCount = 0;

            for (const note of notes) {
                const noteChar = note.match(/^([A-G][s]?)/)?.[1];
                if (!noteChar) continue;

                const key = document.createElement("button");
                key.type = "button";
                key.className = "key";
                key.dataset.note = note;
                key.setAttribute("aria-label", note);

                if (noteChar.includes("s")) {
                    key.classList.add("black-key");
                    key.style.width = `${blackKeyWidth}px`;
                    let left = whiteKeyWidth * whiteCount - blackHalf;
                    if (noteChar === "Cs" || noteChar === "Fs") left -= blackGapAdjust;
                    if (noteChar === "Ds" || noteChar === "As") left += blackGapAdjust;
                    key.style.left = `${left}px`;
                } else {
                    key.classList.add("white-key");
                    key.style.width = `${whiteKeyWidth}px`;
                    key.style.left = `${whiteKeyWidth * whiteCount}px`;
                    whiteCount += 1;
                }

                key.addEventListener("pointerdown", (event) => {
                    if (event.pointerType === "mouse" && event.button !== 0) return;
                    event.preventDefault();
                    key.setPointerCapture(event.pointerId);
                    pointerToNote.set(event.pointerId, note);
                    void startNote(note);
                });

                const releasePointer = (event) => {
                    event.preventDefault();
                    stopPointer(event.pointerId);
                    try {
                        key.releasePointerCapture(event.pointerId);
                    } catch (_) {}
                };

                key.addEventListener("pointerup", releasePointer);
                key.addEventListener("pointercancel", releasePointer);
                key.addEventListener("lostpointercapture", (event) => {
                    stopPointer(event.pointerId);
                });

                noteElement.set(note, key);
                pianoBackground.appendChild(key);
            }
        }

        let resizeTimer;
        const onResize = () => {
            clearTimeout(resizeTimer);
            resizeTimer = window.setTimeout(() => {
                createKeys();
            }, 120);
        };

        if (!ui.delegatedToggleBound) {
            document.addEventListener("click", (event) => {
                const target = event.target;
                if (!(target instanceof Element)) return;
                const toggleBtn = target.closest("#pianoToggle, #pianoFab");
                if (!toggleBtn) return;
                const currentPanel = document.getElementById("pianoPanel");
                if (!currentPanel) return;
                state.isOpen = currentPanel.classList.contains("hidden");
                currentPanel.classList.toggle("hidden", !state.isOpen);
                updateToggleAria(state.isOpen);
                if (!state.isOpen) {
                    stopAllNotes();
                } else {
                    // 表示後の実幅で鍵盤数を再計算
                    window.requestAnimationFrame(() => {
                        createKeys();
                    });
                }
            });
            ui.delegatedToggleBound = true;
        }

        if (!ui.rangeBound) {
            startRange.addEventListener("input", () => {
                state.startMidi = Number(startRange.value);
                updateStartLabel(state.startMidi);
                createKeys();
            });
            ui.rangeBound = true;
        }

        if (!ui.longPressGuardBound) {
            // iOS 長押し時のコピー/コールアウトUIを抑止
            document.addEventListener("contextmenu", (event) => {
                const target = event.target;
                if (!(target instanceof Element)) return;
                if (!target.closest("#pianoPanel, #pianoBackground, .key")) return;
                event.preventDefault();
            });
            document.addEventListener("selectstart", (event) => {
                const target = event.target;
                if (!(target instanceof Element)) return;
                if (!target.closest("#pianoPanel, #pianoBackground, .key")) return;
                event.preventDefault();
            });
            ui.longPressGuardBound = true;
        }

        if (!ui.resizeBound) {
            window.addEventListener("resize", onResize);
            window.addEventListener("orientationchange", onResize);
            document.addEventListener("visibilitychange", () => {
                if (document.hidden) stopAllNotes();
            });
            window.addEventListener("pagehide", stopAllNotes);
            window.addEventListener("pointerup", (event) => stopPointer(event.pointerId));
            ui.resizeBound = true;
        }

        if (root.dataset.keysBuilt !== "1") {
            createKeys();
            root.dataset.keysBuilt = "1";
        } else {
            createKeys();
        }
        setPanelOpen(Boolean(state.isOpen));
    }

    document.addEventListener("astro:page-load", initPiano);
    document.addEventListener("DOMContentLoaded", initPiano);
</script>

<style>
    .piano-root {
        position: fixed;
        right: clamp(12px, 1.8vmin, 20px);
        bottom: clamp(12px, 1.8vmin, 20px);
        z-index: 9999;
    }

    .piano-fab {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        border: none;
        background: #fff;
        cursor: pointer;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.25);
    }

    .piano-panel {
        position: fixed;
        left: 14px;
        right: 14px;
        bottom: clamp(78px, 10vmin, 100px);
        width: auto;
        max-width: 1120px;
        background: #101010;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: clamp(8px, 1.5vmin, 12px);
        padding: clamp(8px, 1.6vmin, 14px);
        box-shadow: 0 12px 24px rgba(0, 0, 0, 0.28);
        overflow-x: hidden;
        overflow-y: hidden;
        -webkit-user-select: none;
        user-select: none;
        -webkit-touch-callout: none;
    }

    @media (min-width: 1180px) {
        .piano-panel {
            left: 50%;
            right: auto;
            width: 1120px;
            transform: translateX(-50%);
        }
    }

    .hidden {
        display: none;
    }

    .piano-controls {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 8px;
        color: #eee;
        font-size: 12px;
    }

    .piano-start-label {
        min-width: 72px;
        font-family: "Menlo", "PT Mono", "Courier New", monospace;
        font-size: 11px;
    }

    .piano-start-range {
        flex: 1;
        min-width: 120px;
    }

    :global(.piano-background) {
        position: relative;
        margin: 0 auto;
        user-select: none;
        -webkit-user-select: none;
        -webkit-touch-callout: none;
        touch-action: none;
        caret-color: transparent;
    }

    :global(.key) {
        position: absolute;
        top: 0;
        border: none;
        padding: 0;
        margin: 0;
        appearance: none;
        cursor: pointer;
        user-select: none;
        -webkit-user-select: none;
        touch-action: none;
        -webkit-tap-highlight-color: transparent;
    }

    :global(.white-key) {
        height: var(--white-key-height);
        background: #fff;
        border: 1px solid #2e2e2e;
        z-index: 1;
        border-radius: 0 0 4px 4px;
    }

    :global(.black-key) {
        height: var(--black-key-height);
        background: #121212;
        z-index: 2;
        border-radius: 0 0 3px 3px;
        box-shadow:
            inset -1px -1px 1px rgba(255, 255, 255, 0.08),
            0 1px 2px rgba(0, 0, 0, 0.5);
    }

    :global(.white-key.is-pressed) {
        background: #dbe8ff;
    }

    :global(.black-key.is-pressed) {
        background: #5a5a5a;
        transform: translateY(1px);
        box-shadow: inset 0 0 0 1px rgba(180, 220, 255, 0.6);
    }
</style>
