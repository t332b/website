<div class="piano-root">
    <button id="pianoFab" class="piano-fab">
        <img src="/images/uploads/piano_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg" />
    </button>

    <div id="pianoPanel" class="piano-panel hidden">
        <div id="pianoBackground" class="piano-background"></div>
    </div>
</div>

<script>
    function initPiano() {
        const pianoBackground = document.getElementById("pianoBackground");
        const fab = document.getElementById("pianoFab");
        const panel = document.getElementById("pianoPanel");

        if (!pianoBackground || !fab || !panel) return;
        if (pianoBackground.dataset.init === "1") return;
        pianoBackground.dataset.init = "1";

        const noteCharList = ["A", "As", "B", "C", "Cs", "D", "Ds", "E", "F", "Fs", "G", "Gs"];
        const baseNote = {
            C: 0,
            Cs: 1,
            D: 2,
            Ds: 3,
            E: 4,
            F: 5,
            Fs: 6,
            G: 7,
            Gs: 8,
            A: 9,
            As: 10,
            B: 11,
        };

        function noteToMidi(note) {
            const match = note.match(/^([A-G][s]?)(\d)$/);
            if (!match) return null;
            const [, pitch, octave] = match;
            return (parseInt(octave) + 1) * 12 + baseNote[pitch];
        }

        function midiToNote(midiNumber) {
            const octave = Math.floor(midiNumber / 12) - 1;
            const pitchIndex = midiNumber % 12;
            const pitch = Object.keys(baseNote).find((n) => baseNote[n] === pitchIndex);
            return `${pitch}${octave}`;
        }

        function play(note) {
            const audio = new Audio(`/piano/audio/${note}.mp3`);
            audio.currentTime = 0;
            audio.play();
        }

        function createKeys() {
            pianoBackground.innerHTML = "";

            const panelWidth = window.innerWidth * 0.9;
            const whiteKeys = Math.floor(panelWidth / 24);
            const numberOfKeys = Math.floor((whiteKeys / 7) * 12);

            const whiteKeyWidth = 4;
            const blackKeyWidth = whiteKeyWidth * 0.6;
            const blackHalf = blackKeyWidth / 2;
            const gap = whiteKeyWidth / 20;

            const firstNotePitch = "C3";
            const firstMidi = noteToMidi(firstNotePitch);

            let whiteCount = 0;
            let totalWidth = 0;

            for (let i = 0; i < numberOfKeys; i++) {
                const midi = firstMidi + i;
                const note = midiToNote(midi);
                const noteChar = note.match(/^([A-G][s]?)/)[1];

                const key = document.createElement("div");
                key.classList.add("key");
                key.dataset.note = note;

                if (noteChar.includes("s")) {
                    key.classList.add("black-key");
                    key.style.width = `${blackKeyWidth}vw`;

                    let pos = whiteKeyWidth * whiteCount - blackHalf;

                    if (noteChar === "Cs" || noteChar === "Fs") pos -= gap;
                    if (noteChar === "Ds" || noteChar === "As") pos += gap;

                    key.style.left = `${pos}vw`;
                } else {
                    key.classList.add("white-key");
                    key.style.width = `${whiteKeyWidth}vw`;
                    key.style.left = `${whiteKeyWidth * whiteCount}vw`;
                    whiteCount++;
                    totalWidth += whiteKeyWidth;
                }

                key.addEventListener("mousedown", () => play(note));
                pianoBackground.appendChild(key);
            }

            pianoBackground.style.width = `${totalWidth}vw`;
        }

        fab.addEventListener("click", () => {
            panel.classList.toggle("hidden");
        });

        createKeys();
    }

    document.addEventListener("astro:page-load", initPiano);
    document.addEventListener("DOMContentLoaded", initPiano);
</script>

<style>
    .piano-root {
        position: fixed;
        bottom: 20px;
        right: 20px;
        z-index: 9999;
    }

    .piano-fab {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: white;
        border: none;
        cursor: pointer;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.25);
    }

    .piano-panel {
        position: fixed;
        bottom: 100px;
        right: 20px;
        background: #111;
        padding: 1rem;
        border-radius: 12px;
        overflow-x: auto;
    }

    .hidden {
        display: none;
    }

    :global(.piano-background) {
        position: relative;
        height: 12vw;
    }

    :global(.key) {
        position: absolute;
        cursor: pointer;
    }

    :global(.white-key) {
        height: 12vw;
        background: white;
        border: 1px solid #444;
        z-index: 1;
    }

    :global(.black-key) {
        height: 7vw;
        background: black;
        z-index: 2;
    }
</style>
