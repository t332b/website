---
---

<div id="pianoRoot" class="piano-root" transition:persist="piano-ui">
    <div id="pianoPanel" class="piano-panel hidden">
        <div class="piano-controls">
            <button id="pianoCloseBtn" class="piano-close-btn" type="button" aria-label="ピアノを閉じる">✕</button>

            <div class="piano-side-controls">
                <div class="piano-start-controls" aria-label="開始位置調整">
                    <button id="pianoOctDown" class="piano-ctrl-btn" type="button" aria-label="開始位置を1オクターブ下げる">≪</button>
                    <button id="pianoStepDown" class="piano-ctrl-btn" type="button" aria-label="開始位置を半音下げる">‹</button>
                    <div id="pianoStartLabel" class="piano-start-readout">Start: C3</div>
                    <button id="pianoStepUp" class="piano-ctrl-btn" type="button" aria-label="開始位置を半音上げる">›</button>
                    <button id="pianoOctUp" class="piano-ctrl-btn" type="button" aria-label="開始位置を1オクターブ上げる">≫</button>
                </div>

                <div class="piano-volume-controls" aria-label="音量調整">
                    <label class="piano-volume-label" for="pianoVolumeRange">
                        Volume: <span id="pianoVolumeLabel">50%</span>
                    </label>
                    <input id="pianoVolumeRange" class="piano-volume-range" type="range" min="0" max="2" step="0.01" value="0.8" />
                </div>
            </div>
        </div>
        <div id="pianoBackground" class="piano-background"></div>
    </div>
</div>

<script>
    function initPiano() {
        const root = document.getElementById("pianoRoot");
        const pianoBackground = document.getElementById("pianoBackground");
        const panel = document.getElementById("pianoPanel");
        const closeBtn = document.getElementById("pianoCloseBtn");
        const octDownBtn = document.getElementById("pianoOctDown");
        const stepDownBtn = document.getElementById("pianoStepDown");
        const stepUpBtn = document.getElementById("pianoStepUp");
        const octUpBtn = document.getElementById("pianoOctUp");
        const volumeRange = document.getElementById("pianoVolumeRange");
        const startLabel = document.getElementById("pianoStartLabel");
        const volumeLabel = document.getElementById("pianoVolumeLabel");

        if (
            !root ||
            !pianoBackground ||
            !panel ||
            !closeBtn ||
            !octDownBtn ||
            !stepDownBtn ||
            !stepUpBtn ||
            !octUpBtn ||
            !volumeRange ||
            !startLabel ||
            !volumeLabel
        )
            return;

        const DEFAULT_MASTER_VOLUME = 0.8;
        const MAX_MASTER_VOLUME = 2;
        const state = (window.__pianoState ??= { isOpen: false, startMidi: 48, volume: DEFAULT_MASTER_VOLUME });
        const engine = (window.__pianoEngine ??= {
            audioContext: null,
            masterGain: null,
            buffers: new Map(),
            loadingBuffers: new Map(),
            activeNotes: new Map(),
            loopPoints: {},
            loopPointsLoaded: false,
        });
        const ui = (window.__pianoUi ??= {
            delegatedToggleBound: false,
            resizeBound: false,
            controlBound: false,
            longPressGuardBound: false,
        });

        const NOTE_NAMES = ["C", "Cs", "D", "Ds", "E", "F", "Fs", "G", "Gs", "A", "As", "B"];
        const FULL_PIANO_MIN_MIDI = 21;
        const FULL_PIANO_MAX_MIDI = 108;
        const FULL_PIANO_KEY_COUNT = 88;
        const PIANO_MAX_WIDTH = 1900;
        const MAX_WHITE_KEY_WIDTH = 38;
        const DEFAULT_LOOP = { loopStart: 0.08, release: 0.05, gain: 1 };
        const DEFAULT_LOOP_END_OFFSET = 0.02;

        const pointerToNote = new Map();
        const noteHoldCount = new Map();
        const noteElement = new Map();

        function clamp(value, min, max) {
            return Math.max(min, Math.min(max, value));
        }

        function midiToNote(midiNumber) {
            const octave = Math.floor(midiNumber / 12) - 1;
            const pitch = NOTE_NAMES[midiNumber % 12];
            return `${pitch}${octave}`;
        }

        function isBlackKey(note) {
            return note.includes("s");
        }

        function getTargetWhiteKeyWidth(viewportWidth) {
            if (viewportWidth <= 430) return 50;
            if (viewportWidth <= 480) return 49;
            if (viewportWidth <= 520) return 48;
            if (viewportWidth <= 560) return 47;
            if (viewportWidth <= 600) return 46;
            if (viewportWidth <= 640) return 45;
            if (viewportWidth <= 700) return 42;
            if (viewportWidth <= 760) return 40;
            if (viewportWidth <= 820) return 38;
            if (viewportWidth <= 900) return 35;
            if (viewportWidth <= 1024) return 32;
            if (viewportWidth <= 1200) return 30;
            if (viewportWidth <= 1366) return 28;
            if (viewportWidth <= 1600) return 26;
            if (viewportWidth <= 1920) return 24;
            return 22;
        }

        function getMaxKeysByViewport(viewportWidth) {
            if (viewportWidth <= 430) return 12;
            if (viewportWidth <= 480) return 13;
            if (viewportWidth <= 520) return 14;
            if (viewportWidth <= 560) return 15;
            if (viewportWidth <= 600) return 16;
            if (viewportWidth <= 640) return 17;
            if (viewportWidth <= 700) return 18;
            if (viewportWidth <= 760) return 19;
            if (viewportWidth <= 820) return 20;
            if (viewportWidth <= 900) return 22;
            if (viewportWidth <= 1024) return 24;
            if (viewportWidth <= 1200) return 28;
            if (viewportWidth <= 1366) return 32;
            if (viewportWidth <= 1600) return 40;
            if (viewportWidth <= 1920) return 52;
            if (viewportWidth <= 2560) return 64;
            if (viewportWidth <= 3200) return 76;
            return FULL_PIANO_KEY_COUNT; // 88鍵は超大型ディスプレイ前提
        }

        function getKeyCountFromPanelWidth(panelInnerWidth, viewportWidth) {
            const minWhiteKeys = 7; // 12鍵相当
            const maxWhiteKeys = 52; // 88鍵相当
            const targetWhiteKeyWidth = getTargetWhiteKeyWidth(viewportWidth);
            const minWhiteKeysByMaxWidth = Math.ceil(panelInnerWidth / MAX_WHITE_KEY_WIDTH);
            const whiteKeyCount = clamp(
                Math.max(Math.round(panelInnerWidth / targetWhiteKeyWidth), minWhiteKeysByMaxWidth),
                minWhiteKeys,
                maxWhiteKeys,
            );
            const estimatedTotalKeys = Math.round((whiteKeyCount * 12) / 7);
            const maxKeys = getMaxKeysByViewport(viewportWidth);
            return clamp(estimatedTotalKeys, 12, maxKeys);
        }

        function getFirstMidi(keyCount, preferredStartMidi) {
            if (keyCount >= FULL_PIANO_KEY_COUNT) return FULL_PIANO_MIN_MIDI;
            const maxStart = FULL_PIANO_MAX_MIDI - keyCount + 1;
            const rawStart = Number.isFinite(preferredStartMidi) ? Math.round(preferredStartMidi) : 48;
            return clamp(rawStart, FULL_PIANO_MIN_MIDI, maxStart);
        }

        function getAudioContext() {
            if (engine.audioContext) return engine.audioContext;
            const Ctor = window.AudioContext || window.webkitAudioContext;
            if (!Ctor) return null;
            engine.audioContext = new Ctor({ latencyHint: "interactive" });
            engine.masterGain = engine.audioContext.createGain();
            engine.masterGain.gain.value = clamp(state.volume ?? DEFAULT_MASTER_VOLUME, 0, MAX_MASTER_VOLUME);
            engine.masterGain.connect(engine.audioContext.destination);
            return engine.audioContext;
        }

        async function ensureLoopPointsLoaded() {
            if (engine.loopPointsLoaded) return;
            try {
                const response = await fetch("/piano/loop-points.json", { cache: "no-store" });
                if (!response.ok) {
                    engine.loopPoints = {};
                } else {
                    const raw = await response.json();
                    engine.loopPoints = raw && typeof raw === "object" ? raw : {};
                }
            } catch (_) {
                engine.loopPoints = {};
            } finally {
                engine.loopPointsLoaded = true;
            }
        }

        function resolveLoopForNote(note, duration) {
            const defaults = engine.loopPoints._default ?? {};
            const config = engine.loopPoints[note] ?? {};

            const requestedLoopStart = config.loopStart ?? defaults.loopStart ?? DEFAULT_LOOP.loopStart;
            const safeLoopStart = clamp(requestedLoopStart, 0, Math.max(0, duration - 0.03));
            const requestedLoopEnd =
                config.loopEnd ??
                defaults.loopEnd ??
                duration - (config.loopEndOffset ?? defaults.loopEndOffset ?? DEFAULT_LOOP_END_OFFSET);
            const minLoopEnd = safeLoopStart + 0.01;
            const safeLoopEnd = clamp(requestedLoopEnd, minLoopEnd, duration);

            const release = clamp(config.release ?? defaults.release ?? DEFAULT_LOOP.release, 0.005, 0.3);
            const gain = clamp(config.gain ?? defaults.gain ?? DEFAULT_LOOP.gain, 0, 1);
            return { loopStart: safeLoopStart, loopEnd: safeLoopEnd, release, gain };
        }

        async function loadBuffer(note) {
            const cached = engine.buffers.get(note);
            if (cached) return cached;

            const loading = engine.loadingBuffers.get(note);
            if (loading) return loading;

            const promise = (async () => {
                const context = getAudioContext();
                if (!context) throw new Error("AudioContext is unavailable");

                const response = await fetch(`/piano/audio/${note}.mp3`);
                if (!response.ok) throw new Error(`Audio file not found: ${note}`);
                const arrayBuffer = await response.arrayBuffer();
                const audioBuffer = await context.decodeAudioData(arrayBuffer.slice(0));
                engine.buffers.set(note, audioBuffer);
                return audioBuffer;
            })();

            engine.loadingBuffers.set(note, promise);
            try {
                return await promise;
            } finally {
                engine.loadingBuffers.delete(note);
            }
        }

        function stopActiveVoice(note) {
            const active = engine.activeNotes.get(note);
            if (!active) return;

            const context = getAudioContext();
            if (!context) return;

            const now = context.currentTime;
            const currentGain = active.gainNode.gain.value;
            active.gainNode.gain.cancelScheduledValues(now);
            active.gainNode.gain.setValueAtTime(currentGain, now);
            active.gainNode.gain.linearRampToValueAtTime(0, now + active.release);

            try {
                active.source.stop(now + active.release + 0.02);
            } catch (_) {}

            engine.activeNotes.delete(note);
        }

        async function startNote(note) {
            const currentCount = noteHoldCount.get(note) ?? 0;
            noteHoldCount.set(note, currentCount + 1);
            if (currentCount > 0) return;

            const key = noteElement.get(note);
            key?.classList.add("is-pressed");

            try {
                await ensureLoopPointsLoaded();
                const context = getAudioContext();
                if (!context) return;
                if (context.state === "suspended") await context.resume();

                const buffer = await loadBuffer(note);
                if ((noteHoldCount.get(note) ?? 0) <= 0) return;

                stopActiveVoice(note);

                const loopConfig = resolveLoopForNote(note, buffer.duration);
                const source = context.createBufferSource();
                source.buffer = buffer;
                source.loop = true;
                source.loopStart = loopConfig.loopStart;
                source.loopEnd = loopConfig.loopEnd;

                const gainNode = context.createGain();
                const now = context.currentTime;
                gainNode.gain.setValueAtTime(0, now);
                gainNode.gain.linearRampToValueAtTime(loopConfig.gain, now + 0.004);

                source.connect(gainNode);
                gainNode.connect(engine.masterGain || context.destination);
                source.start(now, 0);

                source.onended = () => {
                    const active = engine.activeNotes.get(note);
                    if (active?.source === source) engine.activeNotes.delete(note);
                };

                engine.activeNotes.set(note, { source, gainNode, release: loopConfig.release });
            } catch (_) {
                noteHoldCount.delete(note);
                key?.classList.remove("is-pressed");
            }
        }

        function stopNote(note) {
            const currentCount = noteHoldCount.get(note) ?? 0;
            if (currentCount <= 1) {
                noteHoldCount.delete(note);
                const key = noteElement.get(note);
                key?.classList.remove("is-pressed");
                stopActiveVoice(note);
                return;
            }
            noteHoldCount.set(note, currentCount - 1);
        }

        function stopPointer(pointerId) {
            const note = pointerToNote.get(pointerId);
            if (!note) return;
            pointerToNote.delete(pointerId);
            stopNote(note);
        }

        function stopAllNotes() {
            pointerToNote.clear();
            for (const note of noteHoldCount.keys()) {
                noteElement.get(note)?.classList.remove("is-pressed");
            }
            noteHoldCount.clear();
            for (const note of Array.from(engine.activeNotes.keys())) {
                stopActiveVoice(note);
            }
        }

        function getToggleButton() {
            return document.getElementById("pianoToggle") || document.getElementById("pianoFab");
        }

        function updateToggleAria(isOpen) {
            const fab = getToggleButton();
            fab?.setAttribute("aria-expanded", isOpen ? "true" : "false");
        }

        function noteLabelFromMidi(midi) {
            return midiToNote(midi).replace("s", "#");
        }

        function updateStartLabel(midi) {
            startLabel.textContent = `Start: ${noteLabelFromMidi(midi)}`;
        }

        function setPanelOpen(isOpen) {
            state.isOpen = isOpen;
            panel.classList.toggle("hidden", !isOpen);
            updateToggleAria(isOpen);
            const fab = getToggleButton();
            fab?.classList.toggle("is-hidden-while-open", isOpen);
            if (!isOpen) stopAllNotes();
            updateBodySafeSpace();
        }

        function updateBodySafeSpace() {
            const body = document.body;
            if (!body) return;
            if (!state.isOpen) {
                body.classList.remove("piano-open");
                body.style.removeProperty("--piano-safe-space");
                return;
            }
            const panelRect = panel.getBoundingClientRect();
            const extra = Math.ceil(panelRect.height + 20);
            body.classList.add("piano-open");
            body.style.setProperty("--piano-safe-space", `${extra}px`);
        }

        function clampStartMidi(value, keyCount) {
            const maxStartMidi = FULL_PIANO_MAX_MIDI - keyCount + 1;
            return clamp(value, FULL_PIANO_MIN_MIDI, maxStartMidi);
        }

        function updateVolumeLabel() {
            volumeLabel.textContent = `${Math.round((state.volume ?? DEFAULT_MASTER_VOLUME) * 100)}%`;
            volumeRange.value = String(state.volume ?? DEFAULT_MASTER_VOLUME);
        }

        function setMasterVolume(nextVolume) {
            state.volume = clamp(nextVolume, 0, MAX_MASTER_VOLUME);
            const context = getAudioContext();
            if (context && engine.masterGain) {
                engine.masterGain.gain.setValueAtTime(state.volume, context.currentTime);
            }
            updateVolumeLabel();
        }

        function createKeys() {
            stopAllNotes();
            pianoBackground.innerHTML = "";
            noteElement.clear();
            pointerToNote.clear();
            noteHoldCount.clear();

            const viewportWidth = window.innerWidth;
            const panelStyle = window.getComputedStyle(panel);
            const panelHorizontalPadding = parseFloat(panelStyle.paddingLeft) + parseFloat(panelStyle.paddingRight);
            const measuredPanelWidth = panel.getBoundingClientRect().width || panel.clientWidth || 0;
            // hidden(display:none) 時は幅が 0 になるため、viewport から安全にフォールバックする
            const fallbackPanelWidth = Math.min(viewportWidth - 28, PIANO_MAX_WIDTH);
            const panelInnerWidth = Math.max(
                220,
                (measuredPanelWidth > 0 ? measuredPanelWidth : fallbackPanelWidth) - panelHorizontalPadding,
            );
            const panelMaxWidth = Math.min(panelInnerWidth, PIANO_MAX_WIDTH);
            const keyCount = getKeyCountFromPanelWidth(panelMaxWidth, viewportWidth);

            state.startMidi = clampStartMidi(state.startMidi ?? 48, keyCount);
            updateStartLabel(state.startMidi);

            const firstMidi = getFirstMidi(keyCount, state.startMidi);
            const notes = Array.from({ length: keyCount }, (_, i) => midiToNote(firstMidi + i));

            const whiteKeyCount = notes.filter((note) => !isBlackKey(note)).length;
            const whiteKeyWidth = panelMaxWidth / whiteKeyCount;
            const blackKeyWidth = whiteKeyWidth * 0.6;
            const blackHalf = blackKeyWidth / 2;
            const blackGapAdjust = whiteKeyWidth / 20;
            const whiteKeyHeight = clamp(whiteKeyWidth * 4.7, 72, 150);
            const blackKeyHeight = whiteKeyHeight * 0.58;

            pianoBackground.style.width = `${Math.round(whiteKeyCount * whiteKeyWidth)}px`;
            pianoBackground.style.height = `${Math.round(whiteKeyHeight)}px`;
            pianoBackground.style.setProperty("--white-key-height", `${Math.round(whiteKeyHeight)}px`);
            pianoBackground.style.setProperty("--black-key-height", `${Math.round(blackKeyHeight)}px`);

            let whiteCount = 0;

            for (const note of notes) {
                const noteChar = note.match(/^([A-G][s]?)/)?.[1];
                if (!noteChar) continue;

                const key = document.createElement("button");
                key.type = "button";
                key.className = "key";
                key.dataset.note = note;
                key.setAttribute("aria-label", note);

                if (noteChar.includes("s")) {
                    key.classList.add("black-key");
                    key.style.width = `${blackKeyWidth}px`;
                    let left = whiteKeyWidth * whiteCount - blackHalf;
                    if (noteChar === "Cs" || noteChar === "Fs") left -= blackGapAdjust;
                    if (noteChar === "Ds" || noteChar === "As") left += blackGapAdjust;
                    key.style.left = `${left}px`;
                } else {
                    key.classList.add("white-key");
                    key.style.width = `${whiteKeyWidth}px`;
                    key.style.left = `${whiteKeyWidth * whiteCount}px`;
                    whiteCount += 1;
                }

                key.addEventListener("pointerdown", (event) => {
                    if (event.pointerType === "mouse" && event.button !== 0) return;
                    event.preventDefault();
                    key.setPointerCapture(event.pointerId);
                    pointerToNote.set(event.pointerId, note);
                    void startNote(note);
                });

                const releasePointer = (event) => {
                    event.preventDefault();
                    stopPointer(event.pointerId);
                    try {
                        key.releasePointerCapture(event.pointerId);
                    } catch (_) {}
                };

                key.addEventListener("pointerup", releasePointer);
                key.addEventListener("pointercancel", releasePointer);
                key.addEventListener("lostpointercapture", (event) => {
                    stopPointer(event.pointerId);
                });

                noteElement.set(note, key);
                pianoBackground.appendChild(key);
            }
        }

        let resizeTimer;
        const onResize = () => {
            clearTimeout(resizeTimer);
            resizeTimer = window.setTimeout(() => {
                createKeys();
                updateBodySafeSpace();
            }, 120);
        };

        if (!ui.delegatedToggleBound) {
            document.addEventListener("click", (event) => {
                const target = event.target;
                if (!(target instanceof Element)) return;
                const toggleBtn = target.closest("#pianoToggle, #pianoFab");
                if (!toggleBtn) return;
                const currentPanel = document.getElementById("pianoPanel");
                if (!currentPanel) return;
                const shouldOpen = currentPanel.classList.contains("hidden");
                setPanelOpen(shouldOpen);
                if (!shouldOpen) {
                    stopAllNotes();
                } else {
                    // 表示後の実幅で鍵盤数を再計算
                    window.requestAnimationFrame(() => {
                        createKeys();
                        updateBodySafeSpace();
                    });
                }
            });
            ui.delegatedToggleBound = true;
        }

        if (!ui.controlBound) {
            const adjustStartBy = (deltaMidi) => {
                const viewportWidth = window.innerWidth;
                const panelStyle = window.getComputedStyle(panel);
                const panelHorizontalPadding = parseFloat(panelStyle.paddingLeft) + parseFloat(panelStyle.paddingRight);
                const measuredPanelWidth = panel.getBoundingClientRect().width || panel.clientWidth || 0;
                const fallbackPanelWidth = Math.min(viewportWidth - 28, PIANO_MAX_WIDTH);
                const panelInnerWidth = Math.max(
                    220,
                    (measuredPanelWidth > 0 ? measuredPanelWidth : fallbackPanelWidth) - panelHorizontalPadding,
                );
                const panelMaxWidth = Math.min(panelInnerWidth, PIANO_MAX_WIDTH);
                const keyCount = getKeyCountFromPanelWidth(panelMaxWidth, viewportWidth);

                state.startMidi = clampStartMidi((state.startMidi ?? 48) + deltaMidi, keyCount);
                updateStartLabel(state.startMidi);
                createKeys();
            };

            closeBtn.addEventListener("click", () => setPanelOpen(false));
            stepDownBtn.addEventListener("click", () => adjustStartBy(-1));
            stepUpBtn.addEventListener("click", () => adjustStartBy(1));
            octDownBtn.addEventListener("click", () => adjustStartBy(-12));
            octUpBtn.addEventListener("click", () => adjustStartBy(12));

            volumeRange.addEventListener("input", () => {
                setMasterVolume(Number(volumeRange.value));
            });

            ui.controlBound = true;
        }

        if (!ui.longPressGuardBound) {
            // iOS 長押し時のコピー/コールアウトUIを抑止
            document.addEventListener("contextmenu", (event) => {
                const target = event.target;
                if (!(target instanceof Element)) return;
                if (!target.closest("#pianoPanel, #pianoBackground, .key")) return;
                event.preventDefault();
            });
            document.addEventListener("selectstart", (event) => {
                const target = event.target;
                if (!(target instanceof Element)) return;
                if (!target.closest("#pianoPanel, #pianoBackground, .key")) return;
                event.preventDefault();
            });
            document.addEventListener("dblclick", (event) => {
                const target = event.target;
                if (!(target instanceof Element)) return;
                if (!target.closest("#pianoPanel, #pianoBackground, .key")) return;
                event.preventDefault();
            });
            ui.longPressGuardBound = true;
        }

        if (!ui.resizeBound) {
            window.addEventListener("resize", onResize);
            window.addEventListener("orientationchange", onResize);
            document.addEventListener("visibilitychange", () => {
                if (document.hidden) stopAllNotes();
            });
            window.addEventListener("pagehide", stopAllNotes);
            window.addEventListener("pointerup", (event) => stopPointer(event.pointerId));
            ui.resizeBound = true;
        }

        if (root.dataset.keysBuilt !== "1") {
            createKeys();
            root.dataset.keysBuilt = "1";
        } else {
            createKeys();
        }
        updateVolumeLabel();
        setPanelOpen(Boolean(state.isOpen));
        updateBodySafeSpace();
    }

    document.addEventListener("astro:page-load", initPiano);
    document.addEventListener("DOMContentLoaded", initPiano);
</script>

<style>
    .piano-root {
        position: fixed;
        right: clamp(12px, 1.8vmin, 20px);
        bottom: clamp(12px, 1.8vmin, 20px);
        z-index: 9999;
    }

    .piano-fab {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        border: none;
        background: #fff;
        cursor: pointer;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.25);
    }

    .piano-panel {
        position: fixed;
        left: 14px;
        right: 14px;
        bottom: calc(env(safe-area-inset-bottom, 0px) + 10px);
        width: auto;
        max-width: 1900px;
        background: #282828;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: clamp(8px, 1.5vmin, 12px);
        padding: clamp(8px, 1.6vmin, 14px);
        box-shadow: 0 12px 24px rgba(0, 0, 0, 0.28);
        overflow-x: hidden;
        overflow-y: hidden;
        -webkit-user-select: none;
        user-select: none;
        -webkit-touch-callout: none;
    }

    @media (min-width: 1940px) {
        .piano-panel {
            left: 50%;
            right: auto;
            width: 1900px;
            transform: translateX(-50%);
        }
    }

    .hidden {
        display: none;
    }

    .piano-controls {
        display: flex;
        align-items: flex-start;
        justify-content: flex-start;
        gap: 8px;
        margin-bottom: 8px;
        color: #eee;
        font-size: 12px;
    }

    .piano-close-btn {
        width: 38px;
        height: 38px;
        border-radius: 999px;
        border: 1px solid #b75a5a;
        background: #d05d5d;
        color: #fff;
        cursor: pointer;
        flex: 0 0 auto;
        font-size: 18px;
        line-height: 1;
        margin-right: clamp(8px, 1.2vw, 18px);
    }

    .piano-side-controls {
        display: flex;
        flex-direction: column;
        gap: 8px;
        min-width: 0;
        flex: 1 1 auto;
    }

    .piano-start-controls {
        display: flex;
        align-items: center;
        gap: 4px;
        min-width: 0;
        flex-wrap: nowrap;
    }

    .piano-ctrl-btn {
        min-width: 36px;
        height: 28px;
        border-radius: 6px;
        border: 1px solid #555;
        background: #282828;
        color: #fff;
        cursor: pointer;
        padding: 0 8px;
    }

    .piano-start-readout {
        min-width: 110px;
        text-align: center;
        font-family: "Menlo", "PT Mono", "Courier New", monospace;
        font-size: 11px;
        line-height: 28px;
        border: 1px solid #3f3f3f;
        border-radius: 6px;
        background: #282828;
        padding: 0 8px;
    }

    .piano-volume-controls {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .piano-volume-label {
        font-family: "Menlo", "PT Mono", "Courier New", monospace;
        font-size: 11px;
