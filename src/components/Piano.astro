<div class="piano-wrapper" id="pianoWrapper">
    <div class="piano-modal">
        <div class="piano-container">
            <div class="piano-background" id="pianoBackground"></div>
        </div>
    </div>

    <!-- FAB -->
    <button class="piano-fab" id="pianoToggle">
        <img src="/images/uploads/piano_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24.svg" />
    </button>
</div>

<script type="module" client:load>
    const pianoBackground = document.getElementById("pianoBackground");
    const wrapper = document.getElementById("pianoWrapper");
    const toggle = document.getElementById("pianoToggle");

    const notes = ["C", "Cs", "D", "Ds", "E", "F", "Fs", "G", "Gs", "A", "As", "B"];
    const whiteNotes = ["C", "D", "E", "F", "G", "A", "B"];

    function createKeys(totalKeys = 24) {
        pianoBackground.innerHTML = "";

        const whiteWidth = 3;
        const blackWidth = whiteWidth * 0.6;
        const blackHalf = blackWidth / 2;

        let whiteCount = 0;

        for (let i = 0; i < totalKeys; i++) {
            const noteIndex = i % 12;
            const octave = 3 + Math.floor(i / 12);
            const noteName = notes[noteIndex];
            const fullNote = noteName + octave;

            const key = document.createElement("div");
            key.classList.add("key");
            key.dataset.note = fullNote;

            if (noteName.includes("s")) {
                key.classList.add("black-key");
                key.style.width = blackWidth + "em";
                key.style.left = whiteCount * whiteWidth - blackHalf + "em";
            } else {
                key.classList.add("white-key");
                key.style.width = whiteWidth + "em";
                whiteCount++;
            }

            key.addEventListener("click", () => playNote(fullNote));
            pianoBackground.appendChild(key);
        }

        pianoBackground.style.width = whiteCount * whiteWidth + "em";
    }

    function playNote(note) {
        const audio = new Audio(`/audio/${note}.mp3`);
        audio.currentTime = 0;
        audio.play();
    }

    toggle.addEventListener("click", () => {
        wrapper.classList.toggle("open");
    });

    createKeys();
</script>

<style>
    .piano-wrapper {
        position: fixed;
        bottom: 0;
        right: 0;
        z-index: 9999;
    }

    .piano-modal {
        position: absolute;
        bottom: 80px;
        right: 20px;
        opacity: 0;
        transform: translateY(20px);
        transition: 0.3s ease;
        pointer-events: auto;
    }

    .piano-wrapper.open .piano-modal {
        opacity: 1;
        transform: translateY(0);
    }

    .piano-container {
        background: #24272e;
        padding: 1.5em;
        border-radius: 12px;
    }

    .piano-background {
        position: relative;
        display: flex;
        background: white;
    }

    .white-key {
        height: 12em;
        background: white;
        border: 1px solid #24272e;
        box-shadow: 0 0 0 0.15em #24272e;
        cursor: pointer;
    }

    .black-key {
        position: absolute;
        height: 7em;
        background: #070a0f;
        border: 0.2em solid #24272e;
        border-top: none;
        cursor: pointer;
    }

    .piano-fab {
        position: fixed;
        bottom: 20px;
        right: 20px;
        width: 56px;
        height: 56px;
        border-radius: 50%;
        border: none;
        background: white;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
        cursor: pointer;
        pointer-events: auto;
    }

    .piano-fab img {
        width: 28px;
    }
</style>
