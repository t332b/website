---
// Navigation component

const { currentPath } = Astro.props;

const BASE = import.meta.env.BASE_URL; // "/" or "/tetetest/"

// baseを付けたURLを作る
function withBase(path: string) {
  const cleaned = path.replace(/^\/+/, "");
  return `${BASE}${cleaned}`;
}

// currentPath から base を除去
function stripBase(path: string | undefined) {
  if (!path) return "";
  if (BASE === "/") return path;
  return path.startsWith(BASE) ? "/" + path.slice(BASE.length) : path;
}

const normalizedPath = stripBase(currentPath);

// ナビ定義
const navItems = [
  { path: "/works/", label: "W0RKS" },
  { path: "/live/", label: "L1VE" },
  { path: "/shop/", label: "SH0P" },
  { path: "/notes/", label: "N0TES" },
  { path: "/contact/", label: "C0NTACT" },
];

// active判定
function isActive(targetPath: string) {
  if (!normalizedPath) return false;

  // 完全一致 or 下層ページ含む
  return normalizedPath === targetPath || normalizedPath.startsWith(targetPath);
}
---

<nav class="main-nav">
  {
    navItems.map(({ path, label }) => (
      <a href={withBase(path)} class={`nav-item ${isActive(path) ? "active" : ""}`}>
        {label}
      </a>
    ))
  }
</nav>

<style>
  .main-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    padding: 0.5rem 0;
    margin-bottom: 1rem;
  }

  .nav-item {
    padding: 0.35rem 1rem;
    text-decoration: none;
    color: #333;
    cursor: pointer;
    font-weight: 600;
    font-size: 0.95rem;
    border: 2px solid transparent;
    border-radius: 8px;
    transition: all 0.3s ease;
  }

  .nav-item:hover {
    border-color: var(--accent, #6f42c1);
    background-color: rgba(111, 66, 193, 0.05);
  }

  .nav-item:active {
    transform: scale(0.95);
  }

  .nav-item.active {
    border-color: var(--accent, #6f42c1);
    background-color: rgba(111, 66, 193, 0.1);
    color: var(--accent, #6f42c1);
  }
</style>
